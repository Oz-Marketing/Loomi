# Core
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/loomi_studio?schema=public"
NEXTAUTH_URL="http://127.0.0.1:3000"

# Public origin Twilio calls back on for SMS delivery receipts. Falls back to
# NEXTAUTH_URL. When NEITHER is set, blasts still send but statusCallback is
# omitted SILENTLY — so `sent` never becomes `delivered`, and undeliverable
# numbers are never auto-suppressed. Must be reachable from the internet.
APP_PUBLIC_URL=""
NEXTAUTH_SECRET="replace-with-random-secret"
INTERNAL_JOB_SECRET="replace-with-long-random-secret"
# Shared secret for the machine-to-machine contact ingestion endpoint
# (POST /api/ingest/contacts). Set the same value on the Oz Reports CRM
# bridge. Rotate independently of INTERNAL_JOB_SECRET.
OZ_INGEST_SECRET="replace-with-long-random-secret"

# Surface hosts — the proxy (src/proxy.ts) routes by Host header. Leave unset
# in dev/prod (sensible defaults below apply); set explicitly only where the
# sibling-subdomain convention doesn't hold (e.g. staging's app-staging.*).
#   Studio (base):  studio.loomilm.com  (dev: localhost:3000)        APP_HOST / NEXT_PUBLIC_APP_HOST
#   App (admin):    app.loomilm.com     (dev: app.localhost:3000)    APP_SURFACE_HOST / NEXT_PUBLIC_APP_SURFACE_HOST
#   Reporting:      reporting.loomilm.com                            REPORTING_HOST / NEXT_PUBLIC_REPORTING_HOST
#   Marketing:      loomilm.com apex    (dev: marketing.localhost:3000)
# NEXT_PUBLIC_MARKETING_HOST="loomilm.com"

# Token encryption (Twilio + SendGrid credentials at rest)
TOKEN_ENCRYPTION_SECRET="replace-with-64-char-random-hex"

# AI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# SendGrid Event Webhook signature verification.
#
# REQUIRED IN PRODUCTION. Without it, verifySendGridWebhookSignature() returns
# false for every signed batch, /api/webhooks/sendgrid/events answers 401, and
# SendGrid's events are DISCARDED — which means unsubscribes, hard bounces and
# spam reports never become EmailSuppression rows. The symptom is silent: mail
# keeps sending, and it keeps sending to people who asked you to stop.
#
# Value is the "Verification Key" from SendGrid → Settings → Mail Settings →
# Event Webhook (base64 DER, with or without the PEM armour).
SENDGRID_WEBHOOK_VERIFICATION_KEY=""

# SMTP (test sends + transactional mail)
# NOTE: bulk email blasts no longer use this transport at ALL. They require a
# per-sub-account SendGrid key + From address, enforced by the send preflight in
# src/lib/sending/blast-preflight.ts. A blast on shared SMTP has no
# List-Unsubscribe header and no per-dealer From identity, which is how one
# landed in spam and put the transactional domain's reputation at risk.
# SMTP_FROM remains the default sender for form notifications and CRM lead mail
# — so keep it on a sending SUBDOMAIN, not the root domain.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Transactional SMTP — invites, password resets, account-removal notices.
# Optional. When SMTP_TRANSACTIONAL_USER and SMTP_TRANSACTIONAL_PASS are BOTH
# set, lifecycle mail uses this block instead of the SMTP_* one above, so it can
# send from a separately authenticated domain than bulk campaign mail. HOST and
# PORT fall back to the SMTP_* values when omitted (same provider, different
# domain credentials is the common case). The block is switched as a unit: a
# half-filled one would pair one domain's credentials with another's host and
# fail DKIM silently.
SMTP_TRANSACTIONAL_HOST=""
SMTP_TRANSACTIONAL_PORT=""
SMTP_TRANSACTIONAL_USER=""
SMTP_TRANSACTIONAL_PASS=""
SMTP_TRANSACTIONAL_FROM=""
SMTP_TRANSACTIONAL_REPLY_TO=""

# Logo shown in account-lifecycle email. Defaults to a legacy GoHighLevel CDN
# URL — a remote image on a domain unrelated to the sender, which reads as a
# mild spam signal. Point it at a self-hosted asset to drop that dependency.
EMAIL_LOGO_URL=""

# User onboarding invites
USER_INVITE_TTL_HOURS="72"

# Self-service password reset (emails via the SMTP block above)
PASSWORD_RESET_TTL_MINUTES="60"

# Google SSO — sign in with a Google Workspace account.
# Both vars must be set or the provider is skipped entirely and the login page
# hides the button (credentials-only sign-in still works). SSO never CREATES a
# Loomi user: the Google address must already match an invited User, otherwise
# sign-in is refused.
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorized redirect URI, one per environment:
#   https://studio.loomilm.com/api/auth/callback/google
#   https://staging.loomilm.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# monday.com — the in-app help desk (/support) files submissions as items on
# the "🤜 Oz Tools Help Desk" board. One workspace-level personal API token:
# monday -> avatar menu -> Developers -> My Access Tokens. The token's owner
# needs write access to the board; items are created as that user.
# When unset, /support still works — reports are emailed to devteam@ozmktg.com
# instead — so leaving this blank degrades the feature rather than breaking it.
MONDAY_API_TOKEN=""
# Optional overrides. Defaults are the production board + its "New Requests"
# group; point these at a scratch board to test submissions without filling
# the real triage queue.
# MONDAY_HELP_DESK_BOARD_ID="9778139049"
# MONDAY_HELP_DESK_GROUP_ID="topics"

# Meta (Facebook) Marketing API — Ad Pacer spend sync (read-only)
# Agency-wide System User token with `ads_read` on the client ad accounts.
# Each sub-account links its own ad account via Account.metaAdAccountId
# ("act_123…"), set in the account's settings — not here.
META_SYSTEM_USER_TOKEN=""
# Optional, strongly recommended: the Meta App secret. Enables appsecret_proof
# on every Graph call (server-side request signing).
META_APP_SECRET=""
# Optional: pin the Graph API version (defaults to v21.0).
META_API_VERSION="v21.0"

# S3 Media Storage (template assets, uploaded images)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""              # Optional: for S3-compatible providers (R2, MinIO)
S3_PUBLIC_URL_PREFIX=""      # Optional: CloudFront/custom domain for public URLs

# One-off migration helper (SQLite -> Postgres)
# SQLITE_SOURCE_PATH="/tmp/loomi-dev.db"

# Dashboard local testing
# NEXT_PUBLIC_DASHBOARD_DUMMY_DATA="0"

# Feature flags (off unless set to "true"). Set per-environment; leave unset in
# production until the feature is ready to ship.
# Ad Generator (/tools/ad-generator) — nav link hidden + route 404s when off.
# NEXT_PUBLIC_ENABLE_AD_GENERATOR="true"
# Playbooks (/playbooks, Studio) — nav link hidden + route 404s when off.
# Developers bypass the flag, so the page can be exercised in production before
# it ships. The nightly coverage sweep runs and records its heartbeat regardless
# of this flag, but drift ALERTS follow it: developers only while it is off, since
# the alert links to a page that 404s for anyone else. Set it for the WORKER's
# environment too (shared/.env.local on the droplet) or alerts stay
# developer-only there even when the page is live.
# NEXT_PUBLIC_ENABLE_PLAYBOOKS="true"
