generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  name        String
  title       String?
  email       String    @unique
  password    String
  avatarUrl   String?
  role        String    @default("client") // developer | super_admin | admin | client
  department  String? // "Design" | "Account Management" | "Development" | "Leadership" | "Marketing" | "Sales" | "Operations"
  accountKeys String    @default("[]") // JSON array of assigned account keys
  // org-scoped user transparently gains access to all rooftops under it
  // without listing each accountKey individually.
  //
  // Whether `accountKeys` is a limit or a formality: `all` = every account,
  // `listed` = exactly the keys named, and an empty list under `listed` means
  // NOTHING. Retires the overload where `[]` meant "all accounts" for an
  // admin and "no accounts" for a client, distinguishable only by knowing that
  // `authOptions.jwt` rewrites it at token-mint time. Backfilled to `all` for
  // everyone unrestricted today, so nothing changes.
  // See docs/permissions-architecture.md.
  scopeMode   String    @default("listed") // all | listed
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invites        UserInvite[]
  passwordResets PasswordReset[]
  accounts       Account[] // accounts where this user is the rep

  templatesCreated   Template[]                  @relation("TemplateCreatedBy")
  templatesUpdated   Template[]                  @relation("TemplateUpdatedBy")
  templatesPublished Template[]                  @relation("TemplatePublishedBy")
  templateVersions   TemplateVersion[]           @relation("TemplateVersionCreatedBy")
  dashboardLayouts   DashboardLayoutPreference[]

  metaPacerOwnerAds            MetaAdsPacerAd[]          @relation("MetaPacerOwner")
  metaPacerDesignerAds         MetaAdsPacerAd[]          @relation("MetaPacerDesigner")
  metaPacerAccountRepAds       MetaAdsPacerAd[]          @relation("MetaPacerAccountRep")
  metaPacerDesignNotesAuthored MetaAdsPacerDesignNote[]  @relation("MetaPacerDesignNoteAuthor")
  metaPacerActivityAuthored    MetaAdsPacerActivityLog[] @relation("MetaPacerActivityAuthor")
  metaPacerAccountNotes        MetaAdsPacerAccountNote[] @relation("MetaPacerAccountNoteAuthor")
  metaPacerBudgetLogs          MetaAdsPacerBudgetLog[]   @relation("MetaPacerBudgetLogAuthor")
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  appearancePreference         UserAppearancePreference?

  // Projects (App surface)
  teamMemberships  TeamMembership[]
  initiativesOwned Initiative[]     @relation("InitiativeOwner")
  tasksAssigned    Task[]           @relation("TaskAssignee")
  tasksRequested   Task[]           @relation("TaskRequester")
  taskComments     TaskComment[]    @relation("TaskCommentAuthor")
  taskActivity     TaskActivity[]   @relation("TaskActivityAuthor")

  // Budget
  budgetLineEvents BudgetLineEvent[] @relation("BudgetLineEventAuthor")

  // Permissions
  sectorRoles          UserSectorRole[]
  capabilityGrants     UserCapabilityGrant[] @relation("CapabilityGrantSubject")
  capabilitiesGiven    UserCapabilityGrant[] @relation("CapabilityGrantedBy")
  auditEntriesMade     PermissionAuditLog[]  @relation("PermissionAuditActor")
  auditEntriesReceived PermissionAuditLog[]  @relation("PermissionAuditSubject")
}

// ─────────────────────────────────────────────────────
// Permissions
//
// The assignment half of the model in docs/permissions-architecture.md. The
// role DEFINITIONS live in code (src/lib/permissions/registry.ts) — only who
// holds what is persisted, which keeps the permission table reviewable in a
// diff instead of editable in a database.
//
// Not yet authoritative: `requirePermission()` still delegates to the legacy
// `User.role` buckets until the per-sector PERMISSIONS_ENFORCE_* flags flip.
// ─────────────────────────────────────────────────────

// One role per user per sector — `sector: "studio", role: "designer"`. Absence
// of a row is meaningful: no row for a sector means that sector is hidden from
// the nav and its API returns 403.
model UserSectorRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // agency | studio | reporting | projects
  sector String
  // Valid values depend on the sector — see SECTOR_ROLES in the registry.
  // A `client`-tier user may only hold a `reporting` row; enforced by
  // assertAssignableSectorRole(), and stale rows are ignored at resolution.
  role   String

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, sector])
  @@index([userId])
  @@index([sector, role])
}

// Sensitive capabilities, which no sector role can confer: sending a blast,
// exporting contact PII, seeing cost/markup, rotating integration credentials,
// impersonating a user. Explicit grant only, per user, optionally per account.
//
// `effect: "deny"` beats every grant including an `allow` on the same
// capability, so a single row can carve an exception out of a broad role
// without inventing a narrower one.
model UserCapabilityGrant {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation("CapabilityGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  // A Permission key — see SENSITIVE_CAPABILITIES in the registry.
  capability String
  effect     String @default("allow") // allow | deny
  // Account this applies to. EMPTY STRING means "everywhere in the user's
  // scope" — deliberately not null, because Postgres treats NULLs as distinct
  // in a UNIQUE constraint, so a nullable column here would let two
  // contradictory global grants for the same capability both insert. `''` is
  // never a valid Account.key, so it can't collide with a real scope.
  scopeKey   String @default("")

  grantedById String?
  grantedBy   User?    @relation("CapabilityGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([userId, capability, scopeKey])
  @@index([userId])
  @@index([capability])
}

// Which reports a sub-account exposes to its CLIENT users.
//
// Narrowing only: a row can never grant a report the role's permission doesn't
// already allow, and Budget/Executive are excluded at the registry level
// (`CLIENT_ELIGIBLE_REPORTS`), so no row here can surface internal figures.
//
// Absence is meaningful but not "off": a missing row falls back to the
// registry's `defaultForClients`, so adding a new report doesn't require
// writing a row for every account before anyone can see it.
model AccountReportAccess {
  id         String  @id @default(cuid())
  accountKey String
  /// A ReportKey — see src/lib/permissions/reports.ts.
  reportKey  String
  enabled    Boolean

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountKey, reportKey])
  @@index([accountKey])
}

// Who changed whose permissions, and who used a sensitive capability.
//
// Two kinds of entry, deliberately in one table so "what happened to this
// user's access, and what did they then do with it" is a single query:
//
//   • `grant` / `revoke` / `role_change` — an administrative change. `actorId`
//     made it, `subjectId` received it.
//   • `use` — someone exercised a sensitive capability (sent a blast, exported
//     contacts, impersonated). actor and subject are the same person.
//   • `bypass` — a `developer`-tier user passed a check they hold no grant for.
//     Break-glass is fine; silent break-glass is not.
//
// Append-only by convention: nothing in the app updates or deletes a row.
model PermissionAuditLog {
  id   String @id @default(cuid())
  // grant | revoke | role_change | use | bypass
  kind String

  /// Who performed it. Null once the actor's user row is deleted — the entry
  /// must outlive the account, which is the whole point of an audit trail.
  actorId    String?
  actor      User?   @relation("PermissionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // denormalised so the trail survives the user row

  /// Who it was done to. Same person as the actor for `use` / `bypass`.
  subjectId String?
  subject   User?   @relation("PermissionAuditSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  /// The permission or sector role involved, e.g. `blast.send`, `studio.lead`.
  permission String
  /// Account this concerned, when it was account-specific.
  scopeKey   String?
  /// Free-text: the reason on a grant, or what a `use` entry actually did
  /// ("sent blast <id> to 1,204 recipients").
  detail     String?

  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([permission, createdAt])
  @@index([kind, createdAt])
}

model UserInvite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  sentAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Self-service password reset. Same shape as UserInvite — only the sha256 hash
// of the emailed token is stored, single-use, short-lived — but kept as its own
// table so a reset can never be mistaken for (or consume) an onboarding invite.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model DashboardLayoutPreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  mode       String
  scopeKey   String
  orderJson  String   @default("[]")
  hiddenJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, role, mode, scopeKey])
  @@index([userId, updatedAt])
}

// ─────────────────────────────────────────────────────
// Accounts (formerly rooftops.json)
// ─────────────────────────────────────────────────────

model Account {
  id                         String    @id @default(cuid())
  key                        String    @unique // "youngHonda", "smithToyota"
  slug                       String?   @unique // URL-safe kebab-case: "young-honda"
  dealer                     String // "Young Honda"
  category                   String? // "Automotive", "Healthcare", etc.
  oem                        String? // single OEM key
  oems                       String? // JSON array of OEM keys for multi-brand dealers
  email                      String?
  phone                      String?
  salesPhone                 String?
  servicePhone               String?
  partsPhone                 String?
  address                    String?
  city                       String?
  state                      String?
  postalCode                 String?
  website                    String?
  timezone                   String?
  logos                      String? // JSON: { light, dark, white?, black? }
  branding                   String? // JSON: { colors: { primary, secondary, ... }, fonts: { heading, body } }
  customFonts                String? // JSON: [{ family, weight, style, url }] — uploaded OEM/brand font files
  customValues               String? // JSON: Record<string, { name, value }>
  // Markup rate used by Meta Ads Pacer budget math: actual spend =
  // client gross × markup. Falls back to the global default (0.77) when
  // null. Settable per-account so stores with non-standard markups don't
  // need code changes.
  markup                     Float?
  // Meta single-day daily-budget flexibility for this ad account (0.25 or
  // 0.75) — the MANUAL fallback for the pacing engine's overage allowance.
  // Read the "maximum daily spend" figure under the budget field in Ads
  // Manager, divide by the daily budget, subtract 1. Preferred source is the
  // empirical derivation from the synced daily-spend series; this only kicks
  // in while history is too thin. null → derived, else 0.75.
  pacerOverageAllowance      Float?
  // Sending identity for Loomi-native email sends. When null, falls back to
  // SMTP_FROM / global defaults. Configure per-subaccount once DKIM/SPF for
  // sendingDomain is set up in the client's DNS.
  senderEmail                String?
  senderName                 String?
  sendingDomain              String?
  replyToEmail               String?
  // Per-sub-account SendGrid API key (AES-256-GCM encrypted at rest via
  // src/lib/crypto/encryption.ts). When present, the worker sends through
  // SendGrid instead of falling back to SMTP. sendgridFromDomain stores the
  // verified sender domain so we can warn at send time if senderEmail isn't
  // authenticated.
  sendgridApiKey             String?
  sendgridFromDomain         String?
  // Per-sub-account Twilio credentials. accountSid + authToken are
  // encrypted at rest with the same helper as the SendGrid key. The
  // worker prefers messagingServiceSid (Twilio's recommendation for
  // scaled sending — handles A2P 10DLC registration + sticky sender +
  // automatic phone-number failover) and falls back to the single
  // phoneNumber when no service is configured.
  twilioAccountSid           String?
  twilioAuthToken            String?
  twilioPhoneNumber          String?
  twilioMessagingServiceSid  String?
  // Facebook (Meta) ad account this sub-account's campaigns live under, e.g.
  // "act_1234567890". Used by the Meta Ads Pacer's Sync-from-Facebook job to
  // pull spend. The access token itself is a single agency-wide System User
  // token in env (META_SYSTEM_USER_TOKEN), not per-account.
  metaAdAccountId            String?
  // ── Publishing identity (Ad Generator → campaign launch) ──
  //
  // Reporting only ever needed the ad ACCOUNT. Publishing needs to know who the
  // ad is FROM: a Meta ad creative cannot be created without
  // `object_story_spec.page_id`, so without this the launch path is blocked
  // outright.
  //
  // Confirmed per sub-account, never bulk-matched. Across a 38-rooftop
  // multi-brand group the wrong Page publishes a Ford store's ad from the Chevy
  // store's Page — a brand-compliance incident that looks like a Loomi bug and
  // is invisible until someone spots it in the feed.
  metaPageId                 String?
  /// Instagram actor for IG placements. Optional: without it the ad runs on
  /// Facebook placements only rather than failing.
  metaInstagramActorId       String?
  /// Pixel + the event to optimize toward, for anything past a traffic campaign.
  metaPixelId                String?
  metaDefaultConversionEvent String?
  /// Google conversion action resource name, the equivalent for Google launches.
  googleConversionAction     String?
  /// Who confirmed the Page/IG/pixel above, and when. Recorded because "which
  /// Page does this rooftop post from" is exactly the decision someone will need
  /// to re-verify later, and an unattributed id is not re-verifiable.
  metaAssetsConfirmedBy      String?
  metaAssetsConfirmedAt      DateTime?
  // Reporting margin (percent, 0–100) applied to Meta media-cost fields in the
  // Ads report: billed = actual / (1 - margin/100). Ported from Oz Dealer
  // Tools' per-org `facebook_ads_margin`. Distinct from `markup` above (the
  // Pacer's spend multiplier). null / 0 = bill cost at face value.
  facebookAdsMargin          Float?
  // StackAdapt (OTT/CTV) advertiser this sub-account reports on, plus its
  // reporting margin (percent, same markup math as facebookAdsMargin). The
  // StackAdapt GraphQL API key is a single agency-wide key in env
  // (STACKADAPT_API_KEY), not per-account. Ported from Oz Dealer Tools'
  // per-org stackadapt_advertiser_id / stackadapt_margin.
  stackadaptAdvertiserId     String?
  stackadaptMargin           Float?
  // Google Ads customer this sub-account reports on (digits, dashes stripped),
  // plus its reporting margin (percent, same markup math as the others). The
  // Google Ads API credentials (developer token + OAuth) are agency-wide in env.
  // Ported from Oz Dealer Tools' per-org google_ads_customer_id / google_ads_margin.
  googleAdsCustomerId        String?
  // GA4 property this sub-account's Website Analytics report reads, digits
  // only, plus the website PLATFORM key that selects the VDP url pattern
  // (dealer_com, dealer_spike, room58, …; see VDP_PLATFORM_PATTERNS).
  //
  // Both used to live in env — GA4_PROPERTY_MAP / GA4_PLATFORM_MAP — which
  // meant onboarding a rooftop required editing an env var and REDEPLOYING,
  // and left the Website report with no in-app page to send an agency user to
  // when it came back unmapped. The env maps are still read as a fallback so
  // the cutover needs no flag day; delete them once the backfill has run in
  // every environment. See docs/reporting-redesign.md §5.
  ga4PropertyId              String?
  ga4Platform                String?
  // Google Places listing behind the Reputation report, plus one competitor
  // listing to benchmark against. Same env-to-DB move as the GA4 pair above
  // (was GOOGLE_PLACES_MAP).
  //
  // googlePlaceId is also read in REVERSE by the review ingest, which knows a
  // listing id and needs the account that owns it — so two accounts must never
  // carry the same one. Not a unique constraint: nulls are the common case and
  // the ingest already reports a collision rather than guessing, which is the
  // safer failure (picking one would attribute a rooftop's reviews to its
  // neighbour, silently).
  googlePlaceId              String?
  googleCompetitorPlaceId    String?

  // ── Audience sync consent ──
  //
  // Ad platforms require the uploader to attest that the customer data
  // was collected first-party, with disclosure permitting its use for
  // third-party advertising. That's a statement about how a rooftop
  // gathered its CRM data, so it's recorded per sub-account.
  //
  // The eligibility gate refuses to produce an export for an account
  // without it. Deliberately a hard block rather than a warning: it is
  // the one control standing between "we have contact data" and "we
  // uploaded contact data to Google", and a warning is something people
  // learn to click past.
  //
  // Per-contact consent tracking would be finer-grained, but the CRM
  // feeds carry no consent column today, so there is nothing truthful to
  // populate it from. Recording that fact at the rooftop level, with who
  // attested and when, is the honest version.
  audienceSyncs            AudienceSync[]
  // RETAINED, NOT READ. These backed a per-account consent attestation
  // that was replaced by per-contact provenance (see
  // segments/eligibility.ts). Production is ~98% transacted customers, so
  // the account-level box was always going to be ticked "yes" on every
  // rooftop — an affirmation that is always true is not a control.
  //
  // Kept rather than dropped because `prisma db push` runs unattended on
  // deploy without --accept-data-loss, and a column drop would fail it.
  // Safe to remove in a deliberate migration.
  audienceSyncConsentBasis String?
  audienceSyncConsentAt    DateTime?
  audienceSyncConsentBy    String?
  googleAdsMargin          Float?
  // GoHighLevel email reporting: a per-sub-account Private Integration Token
  // (AES-256-GCM encrypted at rest via src/lib/crypto/encryption.ts) + the GHL
  // locationId it reports on. The /emails/schedule API returns delivery counts
  // only — engagement (opens/clicks) requires a marketplace OAuth app, not a
  // PIT. Ported from Oz Dealer Tools' per-org ghl_api_key / ghl_location_id.
  ghlApiKey                String?
  ghlLocationId            String?
  // IANA timezone of the Meta ad account (e.g. "America/New_York"), cached
  // from the Marketing API on each sync. Meta resets the daily budget at
  // midnight in THIS zone, so the Pacer's time-left math runs against it.
  // Authoritative for pacing; distinct from the hand-entered `timezone`
  // business field above. Falls back to `timezone` (if a valid IANA zone),
  // then America/Denver, when unset.
  metaTimezone             String?
  accountRepId             String?
  accountRep               User?          @relation(fields: [accountRepId], references: [id], onDelete: SetNull)

  // ── Account hierarchy ──
  // A group like Young Automotive Group is BOTH a marketing entity (it sends
  // its own email/SMS/ads) and a parent that rolls up rooftops. Modelling the
  // group as its own Account with children captures both, so there's no
  // "org mode" that has to borrow a child account to do its own work.
  //
  // SetNull on delete so removing a parent detaches children rather than
  // cascading a destructive delete of live account data.
  parentAccountKey String?
  parent           Account?  @relation("AccountHierarchy", fields: [parentAccountKey], references: [key], onDelete: SetNull)
  children         Account[] @relation("AccountHierarchy")

  // Marker for the one-time bootstrap that seeds Loomi's six lifecycle
  // audiences (service overdue, lease ending, etc.) into automotive
  // accounts. Set once on first visit to /contacts/segments. Powersports
  // and other categories stay null and never get seeded.
  lifecyclePresetsSeededAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  emails                   AccountEmail[]
  audiences                Audience[]
  contacts                 Contact[]
  contactLists             ContactList[]
  contactCustomFields      ContactCustomField[]
  contactEvents            ContactEvent[]
  ingestRuns               IngestRun[]
  loomiFlows               LoomiFlow[]
  forms                    Form[]
  crmDestinations          CrmDestination[]
  landingPages             LandingPage[]
  landingPageTemplates     AccountLandingPageTemplate[]
  accountDomains           AccountDomain[]
  snippets                 AccountSnippet[]
  mediaAssets              MediaAsset[]
  mediaCollections         MediaCollection[]
  metaAdsPacerPlan         MetaAdsPacerPlan?
  metaAdsPacerAccountNotes MetaAdsPacerAccountNote[]
  metaAdsPacerBudgetLogs   MetaAdsPacerBudgetLog[]
  campaigns                Campaign[]
  initiatives              Initiative[]
  tasks                    Task[]
  clientAgreements         ClientAgreement[]
  budgetLinesBilled        BudgetLine[]                 @relation("BudgetLineBilled")
  budgetLinesSpend         BudgetLine[]                 @relation("BudgetLineSpend")
  gbpConnection            GbpConnection?
  callEvents               CallEvent[]
  reviews                  ReviewEvent[]
  mailerCampaigns          MailerCampaign[]
  billboards               Billboard[]
  emailFooter              AccountEmailFooter?

  @@index([accountRepId])
  @@index([parentAccountKey])
}

// ─────────────────────────────────────────────────────
// Template Library
// ─────────────────────────────────────────────────────

model Template {
  id                String    @id @default(cuid())
  slug              String    @unique // "service-reminder", "modern-dark"
  // Ownership is a three-way split (Phase 2 org inheritance):
  //   accountKey set                        → owned by that sub-account (only
  //                                            visible inside it).
  //   accountKey null  → shared Loomi library template.
  //   accountKey set   → owned by that account; its descendants inherit it.
  //                                            organization and inherited by
  //                                            every child rooftop (read-only
  //                                            there until cloned).
  accountKey        String?
  title             String // "Service Reminder", "Modern Dark"
  type              String // "lifecycle" | "design"
  category          String? // "service", "sales", "loyalty", etc.
  content           String // full raw HTML template source
  preheader         String?
  published         Boolean   @default(false)
  publishedAt       DateTime?
  publishedByUserId String?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdByUser   User?                   @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser   User?                   @relation("TemplateUpdatedBy", fields: [updatedByUserId], references: [id])
  publishedByUser User?                   @relation("TemplatePublishedBy", fields: [publishedByUserId], references: [id])
  versions        TemplateVersion[]
  tags            TemplateTagAssignment[]
  emails          AccountEmail[]

  @@index([published])
  @@index([accountKey])
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  content         String // snapshot of full HTML at this version
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdByUser User? @relation("TemplateVersionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([templateId])
}

// ─────────────────────────────────────────────────────
// Template Tags
// ─────────────────────────────────────────────────────

model TemplateTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assignments TemplateTagAssignment[]
}

model TemplateTagAssignment {
  id         String      @id @default(cuid())
  templateId String
  template   Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tagId      String
  tag        TemplateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([templateId, tagId])
}

// ─────────────────────────────────────────────────────
// Account Emails (template instances per account)
// ─────────────────────────────────────────────────────

model AccountEmail {
  id         String       @id @default(cuid())
  accountKey String
  account    Account      @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  templateId String
  template   Template     @relation(fields: [templateId], references: [id])
  name       String // "Service Reminder - Young Honda"
  content    String? // null = use library template, non-null = customized copy
  status     String       @default("draft") // draft | active | archived
  // Set when status transitions to 'archived'. Drives the global
  // 30-day purge job — rows where archivedAt < now − 30d get hard-
  // deleted by the daily worker task. Null on non-archived rows.
  archivedAt DateTime?
  folderId   String?
  folder     EmailFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([accountKey])
  @@index([templateId])
  @@index([status, archivedAt])
}

// ─────────────────────────────────────────────────────
// Email Folders
// ─────────────────────────────────────────────────────

model EmailFolder {
  id         String   @id @default(cuid())
  name       String
  accountKey String? // null = global folder
  createdAt  DateTime @default(now())

  emails AccountEmail[]

  @@unique([name, accountKey])
}

// ─────────────────────────────────────────────────────
// Audiences (saved contact filters)
// ─────────────────────────────────────────────────────

model Audience {
  id               String   @id @default(cuid())
  name             String
  description      String?
  accountKey       String?
  account          Account? @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  createdByUserId  String?
  filters          String // JSON: FilterDefinition
  icon             String?
  color            String?
  sortOrder        Int      @default(0)
  providerMetadata String? // JSON map for provider-specific audience refs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  syncs AudienceSync[]

  @@unique([name, accountKey])
  @@index([accountKey])
}

// ─────────────────────────────────────────────────────
// Audience sync — pushing a segment to an ad platform.
//
// Scoped PER SUB-ACCOUNT, not per segment. A segment is a filter, and an
// org-wide filter resolves to different people in every rooftop; the ad
// accounts are per-rooftop too (Account.googleAdsCustomerId). So the
// thing being synced is really (this segment, resolved for this account,
// to this provider).
//
// Org-level audiences that union several rooftops are a deliberate
// follow-up rather than a missing feature — the de-duplication they need
// already exists (resolveEligibleAcrossAccounts), but which shape the
// agency wants is an open product decision. Adding it later means a new
// row shape, not a migration of this one.
// ─────────────────────────────────────────────────────

model AudienceSync {
  id         String   @id @default(cuid())
  audienceId String
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  accountKey String
  account    Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  provider String // google_ads | meta | stackadapt

  /**
   * Remote user-list id/resource name. Null until first created there.
   */
  externalId String?

  status   String @default("paused") // active | paused | error
  schedule String @default("manual") // manual | daily
  /**
   * Which identifier the destination matches on: email | phone | any.
   */
  channel  String @default("any")

  /**
   * Provider-specific settings (membership lifespan, list type, …).
   */
  config String?

  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastError     String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members AudienceSyncMember[]
  runs    AudienceSyncRun[]

  @@unique([audienceId, accountKey, provider])
  @@index([accountKey])
  @@index([status, schedule])
}

// Current membership as last pushed — the baseline each run diffs
// against to produce add/remove operations.
//
// Only the CURRENT set is kept, not a tombstoned history: the platforms
// want deltas, and the audit trail of what changed lives in
// AudienceSyncRun. Retaining a row per member per run would grow without
// bound for no extra answer.
model AudienceSyncMember {
  syncId    String
  sync      AudienceSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  contactId String

  /**
   * The hashed identity actually uploaded (see identityDedupeKey), so a
   * contact whose email changed is correctly seen as remove + add.
   */
  dedupeKey String?

  addedAt DateTime @default(now())

  @@id([syncId, contactId])
  @@index([syncId])
}

// One row per attempt. This is what makes a sync trustworthy rather than
// magical: how big the segment was, how many survived the eligibility
// gate and why the rest didn't, what was added and removed, and — once
// the provider reports it — how many actually matched.
//
// Match rate is the number that tells a dealer whether their CRM data is
// any good, and it's only knowable here.
model AudienceSyncRun {
  id     String       @id @default(cuid())
  syncId String
  sync   AudienceSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | success | failed | skipped

  /**
   * Why a run did nothing, when status = skipped.
   */
  skipReason String?

  segmentSize Int @default(0)
  eligible    Int @default(0)
  added       Int @default(0)
  removed     Int @default(0)
  /**
   * Membership size after this run.
   */
  total       Int @default(0)

  excludedOptedOut     Int     @default(0)
  excludedSuppressed   Int     @default(0)
  excludedNoIdentifier Int     @default(0)
  excludedDuplicate    Int     @default(0)
  /**
   * Dropped for lack of first-party provenance — no sale, no service
   * visit, no form submission.
   */
  excludedNoProvenance Int     @default(0)
  /**
   * JSON array of {source, count} for the provenance exclusions, so a
   * reviewer can see WHICH lead sources were dropped rather than just
   * how many. That's the evidence for deciding whether a given vendor
   * should be allowed through.
   */
  excludedSources      String?

  /**
   * Reported by the provider, often asynchronously — null until known.
   */
  matched   Int?
  matchRate Float?

  /**
   * True when the run computed a delta but deliberately didn't upload
   * (no provider adapter wired yet). Lets the pipeline be proven on real
   * data before anything leaves the building.
   */
  dryRun Boolean @default(false)

  error String?

  @@index([syncId, startedAt])
}

// ─────────────────────────────────────────────────────
// Contacts (Loomi-native; canonical source for the filter engine + UI).
//
// Schema mirrors the Contact shape the filter engine + UI already
// expect (see src/lib/smart-list-types.ts FILTERABLE_FIELDS). Two
// Json relief valves keep the schema stable as CSV imports surface
// dealer-specific data: customFields for arbitrary key/value pairs,
// dnd for {email,sms} opt-outs.
//
// Uniqueness is enforced via partial indexes (see migration SQL) so
// rows missing email or phone don't collide with other email-less /
// phone-less rows. At-least-one-of-(email,phone) is enforced at the
// API layer rather than via CHECK constraint, to keep bulk import
// dry-runs flexible.
// ─────────────────────────────────────────────────────

model Contact {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  email     String?
  phone     String?
  firstName String?
  lastName  String?
  fullName  String?

  address1   String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  source    String?
  tags      Json      @default("[]")
  dateAdded DateTime?

  vehicleYear    String?
  vehicleMake    String?
  vehicleModel   String?
  vehicleVin     String?
  vehicleMileage String?

  lastServiceDate DateTime?
  nextServiceDate DateTime?
  leaseEndDate    DateTime?
  warrantyEndDate DateTime?
  purchaseDate    DateTime?

  // Date of Birth is a first-class column (unlike the automotive
  // lifecycle fields, which live in customFields) because the birthday
  // flow trigger matches on month/day across the whole roster — a
  // queryable column avoids scanning the customFields JSON blob.
  dateOfBirth DateTime?

  // Catch-all for CSV columns the canonical schema doesn't cover.
  // Stored as a flat string-keyed JSON object; the filter UI ignores
  // it for now but the API surfaces it on the contact detail page.
  customFields Json?

  // Minimal DND state: { email?: bool, sms?: bool } — Email and SMS
  // are the only channels Loomi sends on.
  dnd Json?

  // ── Engagement rollups ──
  //
  // Denormalised from EmailEvent / SmsEvent. These used to be computed at
  // read time by four aggregate joins through EmailBlastRecipient
  // (getMessagingSummaryForContacts), which had two costs:
  //
  //   1. They existed only on the API's serialized Contact, never on the
  //      row — so any server-side consumer that read contacts directly
  //      saw them as undefined, and "has opened an email" silently
  //      evaluated false. That divergence is why a segment could preview
  //      as N and enroll zero through a flow.
  //   2. Being join-derived, they couldn't be translated to SQL, so every
  //      segment touching engagement forced a full-roster scan.
  //
  // As real columns they're exact, translatable, and indexable. Storing
  // TIMESTAMPS rather than booleans is the point: "opened an email in the
  // last 30 days" is the question people actually want to segment on,
  // where "has ever opened" degrades to ~everyone over time. The legacy
  // booleans are derived from these (`hasOpenedEmail = lastEmailOpenedAt
  // != null`) so existing saved segments keep working unchanged.
  //
  // Written by the SendGrid + Twilio webhook handlers as events arrive;
  // backfilled from existing event rows by
  // scripts/backfill-contact-engagement.ts.
  lastEmailDeliveredAt DateTime?
  lastEmailOpenedAt    DateTime?
  lastEmailClickedAt   DateTime?
  lastSmsAt            DateTime?
  /**
   * Most recent delivered email OR sent/delivered SMS — the union that
   * backs the "Last Message Date" filter field.
   */
  lastMessageAt        DateTime?

  // ── Purchase / service history rollups ──
  //
  // Aggregated from ContactEvent, which holds one row per service visit
  // or vehicle sale. That history was fully ingested but completely
  // unreachable from the segment builder — "two or more service visits",
  // "spent over $1,500", "bought but never serviced" were impossible to
  // express, despite being the most valuable retargeting cohorts a
  // dealer has.
  //
  // These are LIFETIME aggregates on purpose. A rolling-window counter
  // ("visits in the last 12 months") cannot be maintained on write — it
  // changes with the passage of time, not with the data — so it would
  // need a nightly recompute and would sit silently stale in between.
  // For an audience that feeds ad platforms, quietly-wrong is the worst
  // property to have. Windowed questions are expressed instead by
  // combining a lifetime count with a recency date
  // (serviceVisitCount >= 2 AND lastServiceEventAt within the last 365
  // days), which is exact at every moment.
  //
  // Distinct from lastServiceDate / purchaseDate above: those are the
  // CRM's latest-value snapshot on the contact record, these are derived
  // from the event history. They can legitimately disagree, which is why
  // the filter labels name the source.
  //
  // RECOMPUTED, never incremented — ContactEvent ingest is an upsert, so
  // a re-ingested batch would double-count anything additive.
  serviceVisitCount   Int       @default(0)
  saleCount           Int       @default(0)
  lifetimeSpend       Float     @default(0)
  firstServiceEventAt DateTime?
  lastServiceEventAt  DateTime?
  firstSaleEventAt    DateTime?
  lastSaleEventAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listMemberships ContactListMembership[]
  formSubmissions FormSubmission[]
  events          ContactEvent[]

  @@unique([accountKey, email])
  @@unique([accountKey, phone])
  @@index([accountKey])
  @@index([accountKey, dateAdded])
  // Makes the keyset (id-cursor) contact scans in the trigger resolvers a
  // pure index range scan instead of an accountKey-filter-then-sort.
  @@index([accountKey, id])
  // Lets the birthday resolver's `dateOfBirth IS NOT NULL` prune instead
  // of scanning every contact in the account.
  @@index([accountKey, dateOfBirth])
  // Engagement segments ("opened in the last 30 days", "never received a
  // message") are among the most common, and now translate to indexed
  // range scans rather than a full-roster walk.
  @@index([accountKey, lastEmailOpenedAt])
  @@index([accountKey, lastMessageAt])
  // Lapsed-service and loyalty segments are the common automotive cut.
  @@index([accountKey, lastServiceEventAt])
  @@index([accountKey, serviceVisitCount])
  // GIN index on the customFields jsonb blob so filter queries against
  // declared custom field keys (e.g. `customFields @> '{"tier":"gold"}'`,
  // `customFields ? 'lifetime_value'`) don't fall back to a full table
  // scan once dealer datasets push past low five-figures per account.
  // `jsonb_path_ops` is the smaller, faster variant for containment-only
  // queries — the filter engine never needs the full `jsonb_ops` operator
  // set, and dropping it shrinks the index significantly.
  @@index([customFields(ops: JsonbPathOps)], type: Gin)
}

// ─────────────────────────────────────────────────────
// Contact events — the per-visit / per-deal history that the Contact row
// itself collapses (the CRM bridge upserts one Contact with latest values).
// Each row is one service appointment or one vehicle purchase, so the contact
// page can render a timeline and a multi-vehicle "garage". Idempotent on
// `idempotencyKey` (source RO/deal id) so re-pushes update instead of duplicate.
// ─────────────────────────────────────────────────────

model ContactEvent {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  // Nullable so an event can land before its contact is linked; the ingest
  // links by (accountKey, email/phone) and backfills contactId when possible.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type      String // 'service' | 'sale'
  eventDate DateTime?
  amount    Float? // repair-order total or deal price

  // Vehicle snapshot at the time of the event (a contact may span several).
  vehicleYear    String?
  vehicleMake    String?
  vehicleModel   String?
  vehicleVin     String?
  vehicleMileage String?

  sourceCrm String? // cdk | tekion | vinsolutions | powersports
  reference String? // RO number / deal number (human-facing)
  details   Json? // full extra fields (deal terms, RO breakdown, etc.)

  // Stable per source record (e.g. "cdk:svc:{dealer}:{ro}") so re-ingest is an
  // update, and the one-time backfill is safe to re-run.
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountKey, contactId, eventDate])
  @@index([contactId, type])
  @@index([contactId, vehicleVin])
}

// ─────────────────────────────────────────────────────
// Ingest run log — one row per accepted /api/ingest/* batch.
//
// This is the heartbeat the contact-sync health check reads. Without it,
// "the CRM sync is dead" and "the CRM sync ran and there was genuinely
// nothing new in the window" look identical from the outside (both leave
// Contact.updatedAt untouched), which is the classic silent-pipeline
// failure. A run row is written even when the batch changed nothing, so
// absence of rows means absence of runs — full stop.
//
// Append-only. The bridge posts one batch per account per endpoint —
// INCLUDING empty batches when a rooftop had no rows in its window, which is
// what keeps a quiet store distinguishable from an unreachable one. With ~38
// rooftops on an hourly leads job plus the nightly, that lands in the low
// hundreds to ~1k rows per day; `prune` in the health route drops anything
// past the retention window so it stays bounded.
// ─────────────────────────────────────────────────────

model IngestRun {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  kind   String // 'contacts' | 'events'
  // Batch-level source as sent by the bridge, e.g. 'oz-reports:automotive',
  // 'oz-reports:leads'. Note the leads push overrides source PER CONTACT
  // (with the CRM lead source, e.g. "AutoTrader"), so this batch-level value
  // is the only reliable record of which feed a run came from.
  source String?

  totalRows  Int
  created    Int
  updated    Int
  skipped    Int
  issueCount Int @default(0)

  startedAt DateTime @default(now())

  // Freshness lookups are "latest run for this account" and "everything
  // since T" — both served by these two indexes.
  @@index([accountKey, startedAt])
  @@index([startedAt])
}

// ─────────────────────────────────────────────────────
// Contact Lists (static, manually-curated contact rosters).
//
// Unlike Audiences (filter-driven, dynamic), lists are an explicit
// roster you populate by CSV upload or by picking contacts. Membership
// is stored in an explicit join table so a contact can belong to many
// lists and we can keep a per-membership addedAt timestamp.
// ─────────────────────────────────────────────────────

model ContactList {
  id              String   @id @default(cuid())
  name            String
  description     String?
  accountKey      String
  account         Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships ContactListMembership[]
  forms       Form[]

  @@unique([accountKey, name])
  @@index([accountKey])
}

model ContactListMembership {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([listId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────
// Contact Custom Fields
//
// Account-extensible properties stored as JSON on Contact.customFields,
// declared as first-class rows so the filter engine, CSV importer, and
// contact UI can treat them as real fields with a type + operators.
//
// One model, two roles via nullable accountKey:
//   - accountKey = null → admin blueprint. Lives outside any sub-account
//     and serves as a deployable template. Lets us ship "Automotive
//     defaults" (last_purchase_date, last_service_date, ...) once and
//     push to every automotive sub-account.
//   - accountKey set    → sub-account-owned instance. The only kind the
//     filter engine + CSV importer ever read against contacts.
//
// Mirrors the LoomiFlow parentTemplate pattern: when a blueprint is
// deployed, we duplicate the row, set parentBlueprintId on the copy,
// and timestamp lastSyncedAt. The settings UI can then surface "Update
// available" when parent.updatedAt > instance.lastSyncedAt.
//
// The actual values live on Contact.customFields (Json) keyed by `key`.
// Adding/removing this row never rewrites contact rows — orphan keys
// stay in customFields and are simply ignored by the filter engine
// until the field is re-declared. That's deliberate: easy to recover
// from accidental deletes.
// ─────────────────────────────────────────────────────

model ContactCustomField {
  id         String   @id @default(cuid())
  // null = admin blueprint (no sub-account owns it). Non-null = sub-
  // account-owned field. The (accountKey, key) uniqueness pair below
  // works for both — Postgres treats NULL as distinct, so multiple
  // blueprints with the same key need to be guarded at the API layer
  // (we already validate this in the blueprint create handler).
  accountKey String?
  account    Account? @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  // Snake_case identifier used as the JSON property name in
  // Contact.customFields. Lower-cased + validated [a-z0-9_]+ at the
  // API layer. Renaming a key DOES NOT rewrite existing contact rows
  // — handle data migrations explicitly.
  key String

  // Display name shown wherever a human sees the field.
  label String

  // Optional helper text shown beneath the input on the contact-detail
  // edit form.
  description String?

  // 'text' | 'number' | 'date' | 'boolean' | 'select' | 'multiselect'.
  // Drives operator selection in the filter builder + input rendering
  // in the contact form + value coercion in the CSV importer.
  type String

  // For 'select' / 'multiselect': JSON array of { value, label } pairs.
  // Null for other types.
  options Json?

  // Optional grouping label shown in the filter dropdown
  // ("Service", "Lifecycle Extras", etc.). Defaults to "Custom" in
  // the UI when null.
  category String?

  // PII flag — surfaces a lock icon in admin UIs and (in future)
  // redacts the value in audit logs / non-elevated views.
  isPii Boolean @default(false)

  // For ordering within the settings tab + filter dropdown.
  sortOrder Int @default(0)

  // Blueprint lineage. When an admin deploys a blueprint to a sub-
  // account we copy the row and set parentBlueprintId on the new
  // instance so we can: (a) badge "from blueprint X", (b) compute
  // adoption (how many sub-accounts use this blueprint), (c) push
  // label/options/type updates to stale instances. Self-referential
  // SetNull-on-delete so deleting a blueprint leaves orphaned
  // instances rather than cascade-deleting them.
  parentBlueprintId String?
  parentBlueprint   ContactCustomField?  @relation("BlueprintInstances", fields: [parentBlueprintId], references: [id], onDelete: SetNull)
  instances         ContactCustomField[] @relation("BlueprintInstances")

  // Last time the instance was synced from its blueprint. Compared
  // against parentBlueprint.updatedAt to surface "Update available"
  // in the sub-account settings tab. Null on standalone fields +
  // on the blueprints themselves.
  lastSyncedAt DateTime?

  // Industry tag on blueprints (e.g. "Automotive", "Healthcare").
  // Lets the admin UI offer "Apply all Automotive blueprints to every
  // Automotive sub-account" as a one-click bulk action. Null = ungrouped.
  industryTag String?

  // CSV header aliases for the auto-mapper. JSON string[] — e.g.
  // ["lastPurchase", "purchasedate", "soldon"]. Merged with the
  // canonical HEADER_ALIASES at import time, but only for sub-accounts
  // that have this custom field declared. Empty array = no auto-mapping.
  csvAliases Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountKey, key])
  @@index([accountKey])
  @@index([parentBlueprintId])
  @@index([industryTag])
}

// ─────────────────────────────────────────────────────
// Loomi Flows (native flow definitions managed in Loomi)
// ─────────────────────────────────────────────────────

model LoomiFlow {
  id               String      @id @default(cuid())
  name             String
  description      String?
  status           String      @default("draft") // draft | active | paused | archived
  accountKey       String?
  account          Account?    @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  createdByUserId  String?
  sourceAudienceId String?
  sourceFilter     String?
  metadata         String?
  // Template lineage. When an admin deploys a template to a sub-account
  // we duplicate the template and set parentTemplateId on the new
  // instance so we can: (a) show "deployed from template X" on the
  // instance, (b) compute adoption (which accounts have this template),
  // (c) re-push template updates onto stale instances. Null on
  // standalone flows + on the templates themselves. Self-referential
  // relation with SetNull on delete so deleting a template leaves
  // orphaned instances rather than cascading.
  parentTemplateId String?
  parentTemplate   LoomiFlow?  @relation("FlowTemplateInstances", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  instances        LoomiFlow[] @relation("FlowTemplateInstances")
  // JSON-serialised flow-level defaults: re-entry policy, quiet
  // hours, goal/exit-on-conversion condition, max-enrollment
  // duration, DND handling. Shape lives in `FlowSettings` in
  // services/loomi-flows.ts. Optional — missing/null means "use
  // defaults" everywhere downstream.
  settings         String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  // Last time the instance's graph was sync'd from its parent
  // template. Compared against parent.updatedAt to surface an
  // "Update available" banner. Null on flows that don't have a parent.
  lastSyncedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  nodes       LoomiFlowNode[]
  edges       LoomiFlowEdge[]
  triggers    LoomiFlowTrigger[]
  enrollments LoomiFlowEnrollment[]

  // Optional link to a multi-channel Campaign container (AI Campaign
  // Builder). SetNull so deleting the container never deletes the flow.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([accountKey])
  @@index([status])
  @@index([createdAt])
  @@index([parentTemplateId])
  @@index([status, archivedAt])
  @@index([campaignId])
}

// One drawing-canvas node in a flow's graph. `config` is JSON sized to
// the node's `type` (email → { templateId, subject? }, wait → { ms },
// condition → { predicate }, split → { weights: number[] }, exit → {}).
model LoomiFlowNode {
  id        String    @id @default(cuid())
  flowId    String
  flow      LoomiFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type      String // trigger | email | wait | condition | split | exit
  config    String    @default("{}")
  x         Float     @default(0)
  y         Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([flowId])
}

// Directed edge between two nodes. `branch` labels the outgoing port
// for fan-out nodes: "yes"/"no" for condition, "a"/"b"/... for split,
// null for linear next-step. The execution engine reads `branch` to
// pick which downstream node to advance into after evaluating a node.
model LoomiFlowEdge {
  id         String    @id @default(cuid())
  flowId     String
  flow       LoomiFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  fromNodeId String
  toNodeId   String
  branch     String?
  createdAt  DateTime  @default(now())

  @@index([flowId])
  @@index([fromNodeId])
}

// Trigger config attached to a flow. Multiple triggers can be enabled
// per flow (e.g. list + audience + manual). The trigger poll worker
// enumerates `list` and `audience` triggers; `manual` is API-driven;
// `event` is webhook-driven (deferred until event ingestion lands).
model LoomiFlowTrigger {
  id        String    @id @default(cuid())
  flowId    String
  flow      LoomiFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type      String // list | audience | manual | event
  config    String    @default("{}")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([flowId])
  @@index([type, enabled])
}

// One row per (flow, contact) — a contact's run through the flow's
// graph. `currentNodeId` is the next node to execute; `nextRunAt` is
// when the execution worker should pick it up. The (flowId, contactId)
// uniqueness prevents double-enrolling the same contact concurrently.
model LoomiFlowEnrollment {
  id            String    @id @default(cuid())
  flowId        String
  flow          LoomiFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contactId     String
  triggerId     String?
  status        String    @default("active") // active | completed | exited | failed
  currentNodeId String?
  nextRunAt     DateTime?
  enrolledAt    DateTime  @default(now())
  completedAt   DateTime?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  steps LoomiFlowEnrollmentStep[]

  @@unique([flowId, contactId])
  @@index([status, nextRunAt])
  @@index([flowId, status])
  @@index([contactId])
  // Serves excludeEnrolledToday's {flowId, contactId in [...], enrolledAt
  // >= todayStart} once-per-day re-entry guard.
  @@index([flowId, enrolledAt])
}

// Step-execution audit trail per enrollment. One row each time a node
// is executed; useful for analytics, debugging, and follow-up engagement
// queries (link emailRecipientId → EmailEvent for opens/clicks).
model LoomiFlowEnrollmentStep {
  id               String              @id @default(cuid())
  enrollmentId     String
  enrollment       LoomiFlowEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  nodeId           String
  status           String // sent | skipped | failed | branched | waited | exited
  emailRecipientId String?
  branch           String?
  executedAt       DateTime            @default(now())
  metadata         String?

  @@index([enrollmentId])
  @@index([nodeId])
}

// ─────────────────────────────────────────────────────
// Websites — Forms
//
// Drag-and-drop form builder. `schema` stores a v1 FormTemplate
// (block-based JSON, defined in src/lib/forms/types.ts). Submissions
// upsert into the Contact model and can fire `form_submission`
// LoomiFlowTriggers via the formId stored in trigger config JSON.
// ─────────────────────────────────────────────────────

model Form {
  id                String       @id @default(cuid())
  // Nullable: a system/library form template has no owning account
  // (accountKey = null). Live forms and sub-account templates always
  // carry an accountKey.
  accountKey        String?
  account           Account?     @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // as a starting template (Phase 2 inheritance).
  name              String
  // Public URL slug — served at /f/[slug]. Globally unique so iframe
  // embeds resolve without an account prefix.
  slug              String       @unique
  status            String       @default("draft") // draft | published
  // v1 FormTemplate JSON: { version, settings, blocks[] }.
  schema            Json
  // Post-submit destination — when set, the public form redirects
  // here. Otherwise we show `successMessage` inline.
  redirectUrl       String?
  successMessage    String?
  // Lead source stamped onto Contact.source for every submission to this
  // form. Free-text, overridable per form. When blank we fall back to
  // `Loomi - {form name}` at submit time (see lib/forms/submit.ts) so each
  // form is distinguishable in lead reporting without manual entry.
  leadSource        String?
  // Comma-separated list of email addresses notified whenever this form
  // receives a new submission. Blank/unset means no lead notification is
  // sent (see lib/forms/notify.ts).
  notificationEmail String?
  // Optional ContactList to attach upserted contacts to on submit.
  // Uses the same no-overwrite semantics as importContacts(listId).
  listId            String?
  list              ContactList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  // When true, each submission is forwarded as an ADF lead to the
  // account's configured CRM destination(s) (Tekion / VinSolutions).
  // When false (default) leads are kept in Loomi only.
  forwardToCrm      Boolean      @default(false)
  // What the form's vehicle fields (year/make/model/VIN/...) describe, so
  // the ADF lead can carry a structured <vehicle> block the CRM maps to a
  // real field instead of burying it in <comments>:
  //   "interest" -> a vehicle they want (ADF interest="buy")
  //   "trade"    -> the vehicle they already own (ADF interest="trade-in")
  // Null (default) emits no <vehicle> at all — guessing wrong is worse
  // than omitting, so every form opts in explicitly.
  crmVehicleContext String?
  // When true, this row is a reusable template (authored from the Forms
  // tab of /templates) rather than a live form. Templates are excluded
  // from the normal forms list and from public /f/[slug] serving;
  // "Save as template" clones a form's schema into a new isTemplate row.
  isTemplate        Boolean      @default(false)
  submissionCount   Int          @default(0)
  // Shared template taxonomy (Category + Tags) — used when isTemplate=true so
  // form templates organize alongside every other kind on /templates.
  category          String?
  tags              String?      @db.Text // JSON string[] of tag names
  createdByUserId   String?
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  submissions FormSubmission[]

  // Optional link to a multi-channel Campaign container (AI Campaign
  // Builder). SetNull so deleting the container never deletes the form.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([accountKey])
  @@index([accountKey, status])
  @@index([accountKey, isTemplate])
  @@index([campaignId])
}

model FormSubmission {
  id          String       @id @default(cuid())
  formId      String
  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  // Set when the submission matched/created a Contact (email or phone
  // present and accepted by the upsert). Null for anonymous submissions
  // where neither identifier was supplied.
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Raw field-id → value map captured from the submit POST. The Form's
  // schema is the source of truth for what these field ids mean.
  data        Json
  // Embed metadata captured from `meta_{key}` query params on the
  // public form URL — page context handed over by a third-party host
  // page (VIN, stock number, VDP url from a Dealer.com VDP). Flat
  // string→string map, key/value/count-bounded at write time by
  // `lib/forms/embed-params`. Null for submissions with no meta params.
  // Untrusted input: escape wherever it's rendered.
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  referrer    String?
  // Landing-page attribution. Set when the submission came from a
  // form embedded on a Loomi LP — both the LP's id and the slug at
  // submission time are stored (slug is denormalized so reports
  // survive a slug rename). Null for direct /f/<slug> submissions
  // where no LP context was attached.
  lpId        String?
  lp          LandingPage? @relation(fields: [lpId], references: [id], onDelete: SetNull)
  lpSlug      String?
  // First-touch UTM tags captured from the LP's `loomi_lp_utm`
  // cookie when the submission fires. Lets marketing answer "what
  // campaign generated this lead" without joining back through the
  // LP event stream.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  createdAt   DateTime     @default(now())

  @@index([formId, createdAt])
  @@index([contactId])
  @@index([lpId, createdAt])
}

// ─────────────────────────────────────────────────────
// Websites — Forms → CRM lead routing
//
// Forwards leads to a customer's CRM and records the outcome on
// CrmDelivery. Two delivery shapes, keyed off `provider`:
//
//   • ADF email (tekion / vinsolutions) — the automotive-industry standard
//     lead format. The lead is emailed (via the account's sending identity)
//     to the CRM's intake address(es) in `leadEmails`.
//   • HubSpot API (hubspot) — the contact is upserted into HubSpot over its
//     REST API using an encrypted Private App token; `leadEmails` is unused.
//
// Each account configures one CrmDestination per provider. Deliveries are
// triggered two ways: a form submission with `Form.forwardToCrm` enabled
// (submit.ts), or a contact reaching a `push_to_crm` node in a flow
// (loomi-flows.ts). Either path enqueues one pg-boss job per delivery; the
// worker (deliver.ts) does the provider-specific send.
// ─────────────────────────────────────────────────────

model CrmDestination {
  id              String   @id @default(cuid())
  accountKey      String
  account         Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // CRM platform — drives the card label, the delivery method, and any
  // provider-specific quirks.
  provider        String // tekion | vinsolutions | hubspot
  // The CRM's ADF lead-intake email address(es) (dealer-specific, issued by
  // the CRM). Stored as a JSON array of strings; each lead is emailed to every
  // address, so one provider can fan out to multiple intake inboxes. Unused for
  // API providers (hubspot) — those leave it at the default empty list.
  //
  // @map keeps the PHYSICAL column named `leadEmail` (its pre-rename name) so
  // `prisma db push` — which can't detect renames and would otherwise DROP the
  // old column + ADD a fresh one, blanking every connected dealer on deploy —
  // sees no column change. Existing single-address values stay in place and
  // parseLeadEmails() reads them as a one-element list.
  leadEmails      String   @default("[]") @map("leadEmail")
  // ── API providers (hubspot) ──
  // accessToken is the HubSpot Private App token, encrypted at rest with the
  // same AES-256-GCM helper as sendgridApiKey (never returned to the client).
  // portalId is the HubSpot account id (informational — for building record
  // links). config holds optional per-provider settings: field mapping and an
  // optional { pipelineId, stageId } to also create a deal on push.
  accessToken     String?
  portalId        String?
  config          Json?
  enabled         Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveries CrmDelivery[]

  // One destination per CRM per account — each provider is a single
  // "connect" in the integrations grid (Tekion card, VinSolutions card,
  // HubSpot card).
  @@unique([accountKey, provider])
  @@index([accountKey, enabled])
}

model CrmDelivery {
  id             String         @id @default(cuid())
  destinationId  String
  destination    CrmDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  // What triggered this delivery: "form" (a form submission) or "flow" (a
  // push_to_crm node). Drives which id below identifies the lead.
  source         String         @default("form")
  // FormSubmission.id this delivery is for (source="form"). No relation —
  // submissions can be pruned independently and we don't want a cascade to
  // wipe the log. Null for flow-triggered pushes, which carry contactId
  // instead.
  submissionId   String?
  // Contact.id this delivery is for (source="flow"). No relation, same
  // reasoning as submissionId. Null for form-triggered ADF deliveries, which
  // resolve the contact from the submission.
  contactId      String?
  // The single intake address this delivery targets (ADF providers only). A
  // submission fans out to one CrmDelivery per address on the destination, so
  // a retry only re-sends to the address that actually failed (no duplicates
  // to the ones that succeeded). Null for API providers (hubspot) and for
  // legacy rows created before the fan-out (those fall back to emailing all of
  // the destination's addresses).
  recipientEmail String?
  status         String         @default("pending") // pending | sent | failed
  attempts       Int            @default(0)
  // Provider message id: the email send id (SendGrid X-Message-Id / SMTP
  // messageId) for ADF, or the created/updated HubSpot contact id for hubspot.
  // Kept for tracing a lead through to the CRM.
  messageId      String?
  lastError      String?
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  @@index([destinationId, createdAt])
  @@index([submissionId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────
// Landing Pages (block-based, public-rendered)
//
// Mirrors the Form model — same lifecycle (draft → published), same
// /<short-path>/[slug] public routing pattern (here: /lp/[slug]), same
// block-based JSON schema (defined in src/lib/landing-pages/types.ts).
// Differs from Form in that submissions aren't owned at this level —
// LPs can embed an existing Form via the EmbeddedForm block, and that
// embedded form owns its own submissions.
// ─────────────────────────────────────────────────────

model LandingPage {
  id                String    @id @default(cuid())
  // Nullable: a system/library LP template has no owning account
  // (accountKey = null). Live LPs and sub-account templates always
  // carry an accountKey.
  accountKey        String?
  account           Account?  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // Org-owned landing-page TEMPLATE (isTemplate=true) — authored at the org and
  // inherited by child sub-accounts (Phase 2 inheritance).
  name              String
  // When true, this row is a reusable template (authored from the
  // Landing Pages tab of /templates), edited in place by the LP editor,
  // and excluded from public /lp/[slug] serving + the LP list.
  isTemplate        Boolean   @default(false)
  // Public URL slug — served at /lp/[slug]. Globally unique so links
  // resolve without an account prefix (same approach as Form.slug).
  slug              String    @unique
  status            String    @default("draft") // draft | published
  // v1 LandingPageTemplate JSON: { version, settings, blocks[] }.
  // Block types are dedicated marketing primitives (hero, features,
  // testimonial, faq, etc.) plus a form_embed block that references a
  // Form by id.
  schema            Json
  // Optional SEO/share metadata. Falls back to the page's first heading
  // + a generated description when null.
  seoTitle          String?
  seoDescription    String?
  ogImageUrl        String?
  // When true, the public page emits `<meta robots="noindex, nofollow">`
  // AND the LP is excluded from /lp-sitemap.xml. Useful for password-
  // protected drafts, internal-only campaigns, or pages we don't want
  // search engines surfacing.
  noindex           Boolean   @default(false)
  // Per-LP browser tab icon URL. When null, the page inherits the
  // studio's default favicon. Plumbed into Next.js Metadata.icons so
  // the rendered <link rel="icon"> tag picks this up automatically.
  faviconUrl        String?
  // Tracking / analytics injection — surfaced as the "Tracking"
  // section in the LP settings modal. The canonical pixel IDs are
  // rendered server-side as the vendor's standard snippet (Meta,
  // Google) so dealers don't need to paste raw HTML for the
  // common cases. customHeadHtml + customBodyEndHtml are escape
  // hatches for anything the curated fields don't cover. Each is
  // length-capped at the validation layer (~10KB) to keep payloads
  // sane without giving the impression we're sanitizing — admins
  // can inject whatever they want on their own LP.
  metaPixelId       String?
  ga4MeasurementId  String?
  gtmContainerId    String?
  customHeadHtml    String?   @db.Text
  customBodyEndHtml String?   @db.Text
  // Shared template taxonomy (Category + Tags) — used when isTemplate=true so LP
  // templates organize alongside every other kind on /templates.
  category          String?
  tags              String?   @db.Text // JSON string[] of tag names
  createdByUserId   String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events           LandingPageEvent[]
  submissions      FormSubmission[]
  // Reverse of AccountDomain.homeLandingPage — the AccountDomains
  // (zero or more) configured to serve this LP at their root path.
  asHomeForDomains AccountDomain[]    @relation("AccountDomainHome")

  // Optional link to a multi-channel Campaign container (AI Campaign
  // Builder). SetNull so deleting the container never deletes the page.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([accountKey])
  @@index([accountKey, status])
  @@index([accountKey, isTemplate])
  @@index([campaignId])
}

// ─────────────────────────────────────────────────────
// Account-level Reusable Snippets (header / footer / disclaimer)
// ─────────────────────────────────────────────────────
//
// A reusable bundle of LP blocks an account can reference from
// multiple LandingPages. Edit once, every LP that references it
// re-renders with the new content on the next request.
//
// Storage: `schema` is { version: 1, blocks: Block[] } — same Block
// shape as LandingPage but without the LP-level `settings` (snippets
// don't carry their own canvas background / max-width; they render
// inline within their host LP). Snippet blocks themselves can NOT
// contain other snippet refs — cycle detection happens at the
// validation layer.
//
// `kind` is purely cosmetic: it lets the picker group snippets by
// intent (header / footer / disclaimer) without enforcing any
// schema-level distinction. Generic is the catch-all.

model AccountSnippet {
  id              String   @id @default(cuid())
  accountKey      String
  account         Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  name            String
  // header | footer | disclaimer | generic — UI grouping only.
  kind            String   @default("generic")
  // Same JSON shape as LandingPage.schema but without `settings`.
  // Block ids must be unique within a snippet (independent of the LPs
  // that reference it).
  schema          Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountKey])
  @@index([accountKey, kind])
}

// ─────────────────────────────────────────────────────
// Account-level Custom Domains
// ─────────────────────────────────────────────────────
//
// A customer wires their own subdomain (e.g. `offers.dealership.com`)
// to point at our infra via CNAME. We resolve the hostname at request
// time in middleware + the public LP route — visitors get LPs at
// `<hostname>/<slug>`, fully branded as the dealer's own subdomain.
//
// Verification: when a domain is added we issue a random token. The
// customer drops a TXT record at `_loomi.<hostname>` matching the
// token; the Verify endpoint resolves DNS and marks `verifiedAt`. The
// CNAME for traffic to actually reach us is checked implicitly at
// runtime (unverified hostnames just 404).
//
// The optional `homeLandingPageId` lets a domain designate one LP as
// the root-path "home" — `<hostname>/` serves that page, while
// `<hostname>/<slug>` continues to resolve any other LP under the
// same account.

model AccountDomain {
  id                         String       @id @default(cuid())
  accountKey                 String
  account                    Account      @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // Always stored lowercase, no scheme, no path. Middleware compares
  // against the lowercased `Host` header at request time.
  hostname                   String       @unique
  // Random opaque token shown to the customer + checked at the
  // `_loomi.<hostname>` TXT record. Rotated on demand if compromised.
  verificationToken          String
  verifiedAt                 DateTime?
  // Optional: which LP serves the root path on this domain. Null =
  // no `/` route; visitors hitting `/` get a 404 unless they include
  // a slug path. Restricted to LPs in the same account at the
  // application layer (Prisma doesn't enforce cross-FK constraints).
  homeLandingPageId          String?
  homeLandingPage            LandingPage? @relation("AccountDomainHome", fields: [homeLandingPageId], references: [id], onDelete: SetNull)
  // Cloudflare-for-SaaS integration. When CLOUDFLARE_API_TOKEN is
  // configured the verifyAccountDomain service registers the hostname
  // with CF on success — they validate the customer's CNAME, issue
  // an SSL cert, and route traffic to our fallback origin. The id
  // they return is stored here so we can poll status + clean up on
  // delete. Null until verification (or always null if CF isn't
  // configured — DNS-only mode still works for dev / self-hosted).
  cloudflareCustomHostnameId String?
  // Last-known SSL status from CF: 'pending' (still validating /
  // issuing cert), 'active' (cert installed, traffic routes),
  // 'failed' (CF couldn't validate the CNAME or issue the cert),
  // null (CF integration not configured or not yet called).
  cloudflareSslStatus        String?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([accountKey])
}

// ─────────────────────────────────────────────────────
// Account-saved Landing Page Templates
// ─────────────────────────────────────────────────────
//
// Dealer-saved templates that show up in the "New Landing Page"
// modal next to the built-in presets. A template is a snapshot of
// an LP's schema at save time — once saved it's independent of the
// source LP, so editing or deleting the source doesn't propagate.
// The optional `sourceLpId` field is informational only (no FK
// enforcement) so the template survives the source LP being deleted.

model AccountLandingPageTemplate {
  id                String    @id @default(cuid())
  accountKey        String
  account           Account   @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  name              String
  description       String?
  // LandingPageContent JSON — same shape as LandingPage.schema.
  // Deep-cloned when a new LP is built from this template so the
  // template stays a stable snapshot.
  schema            Json
  // Informational pointer to the LP this template was saved from.
  // Not an FK — we want the template to outlive the source LP.
  sourceLpId        String?
  // Publish lifecycle — added so LP templates share the Draft/Published model
  // every other template kind has (admins see both; clients see published only).
  status            String    @default("draft") // draft | published
  publishedAt       DateTime?
  publishedByUserId String?
  // Shared template taxonomy (Category + Tags).
  category          String?
  tags              String?   @db.Text // JSON string[] of tag names
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountKey, createdAt])
}

// ─────────────────────────────────────────────────────
// Landing Page Events
// ─────────────────────────────────────────────────────
//
// Visitor-side analytics events for published landing pages — page
// views, scroll milestones, CTA clicks, and form submissions. Mirrors
// the email-stats webhook pattern (CampaignEmailStats): write rows
// as they happen, aggregate into a daily roll-up table later when the
// dashboard view needs them.
//
// Authentication: public POST endpoint (visitors are anonymous), so
// the API hashes the IP before storage and rate-limits via the anonId
// cookie. Slug is denormalized so analytics queries that filter by
// URL don't need a join.

model LandingPageEvent {
  id          String      @id @default(cuid())
  pageId      String
  page        LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug        String // denormalized — published URL slug at the time of the event
  // Event taxonomy:
  //   view         — page mount (one per session per page)
  //   cta_click    — element with [data-loomi-track="cta"] clicked
  //   form_submit  — embedded form successfully submitted
  //   scroll_25    — 25% scroll depth reached (first time in session)
  //   scroll_50    — 50%
  //   scroll_75    — 75%
  //   scroll_100   — bottom reached
  type        String
  // Cookie-managed identifiers. Both nullable so server-issued events
  // (rare) and pre-cookie requests still persist.
  sessionId   String? // 30-min sliding session — counts unique visits
  anonId      String? // 1-year browser cookie — counts unique visitors
  referrer    String?
  userAgent   String?
  ipHash      String? // sha256(ip + daily salt) — privacy-preserving counter
  // UTM tags captured at first-touch and persisted via cookie. Each
  // event re-stamps current cookie state so we can attribute scroll +
  // CTA + submit back to the source even when the URL no longer has
  // them.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  // Event-specific extras: { ctaLabel, ctaHref, formId, scrollDepth, etc. }
  meta        Json?
  createdAt   DateTime    @default(now())

  @@index([pageId, createdAt])
  @@index([pageId, type, createdAt])
  @@index([slug, createdAt])
}

// ─────────────────────────────────────────────────────
// SMS Campaigns (bulk + scheduled outbound)
// ─────────────────────────────────────────────────────

model SmsBlast {
  id               String    @id @default(cuid())
  name             String?
  // Per-(flow,node) wrapper key — see EmailBlast.flowNodeKey.
  flowNodeKey      String?   @unique
  message          String
  status           String    @default("queued") // queued | scheduled | processing | completed | partial | failed | canceled
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdByUserId  String?
  createdByRole    String?
  sourceAudienceId String?
  sourceFilter     String?
  // Static list audience. Mirrors EmailBlast.sourceListId so the
  // multi-channel recipients step can persist a list selection on both
  // rails. At most one of (sourceListId, sourceAudienceId+sourceFilter,
  // sourceContactIds) is meaningful — the recipients UI enforces
  // exclusivity.
  sourceListId     String?
  // Manual selection — JSON-stringified array of Contact IDs. When set,
  // the schedule step enumerates these contacts directly and skips
  // list/segment resolution. Mirrors EmailBlast.sourceContactIds.
  sourceContactIds String?
  accountKeys      String    @default("[]") // JSON array of account keys
  totalRecipients  Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  metadata         String?
  error            String?
  // Set when the campaign is archived via /archive. The daily purge
  // job hard-deletes rows where archivedAt < now − 30d. Null on live
  // (non-archived) rows.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipients SmsBlastRecipient[]

  // Optional link to a multi-channel Campaign container (AI Campaign
  // Builder). SetNull so deleting the container never deletes a send.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([campaignId])
  @@map("SmsCampaign")
}

model SmsBlastRecipient {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       SmsBlast  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  accountKey     String
  phone          String?
  fullName       String?
  status         String    @default("pending") // pending | sent | failed | skipped
  messageId      String?
  conversationId String?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  events SmsEvent[]

  @@unique([campaignId, contactId, accountKey])
  @@index([campaignId, status])
  @@index([accountKey, status])
  @@map("SmsCampaignRecipient")
}

// One row per Twilio status-callback / inbound webhook entry. Status
// callbacks for the same Twilio Message SID arrive multiple times as
// the message moves through states (queued → sent → delivered), so
// the de-dup key is (sid, eventType) rather than sid alone.
// recipientId is nullable so inbound STOP messages and out-of-band
// sends still get logged for audit.
model SmsEvent {
  id               String             @id @default(cuid())
  campaignId       String?
  recipientId      String?
  recipient        SmsBlastRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  accountKey       String?
  eventType        String // queued | sent | delivered | undelivered | failed | received | stop | unsub
  twilioMessageSid String?
  from             String?
  to               String?
  body             String?
  errorCode        String?
  errorMessage     String?
  raw              String // full webhook payload (form-encoded → JSON serialised)
  timestamp        DateTime
  createdAt        DateTime           @default(now())

  @@index([campaignId, eventType])
  @@index([recipientId])
  @@index([accountKey, eventType])
  @@index([twilioMessageSid])
  @@index([timestamp])
}

// Sub-account scoped phone suppression list. Inbound STOP keywords
// auto-populate this from the Twilio inbound webhook; the campaign
// scheduler filters suppressed phones to status='skipped' before
// queueing the send.
model SmsSuppression {
  id         String   @id @default(cuid())
  accountKey String
  phone      String
  reason     String // stop | unsub | undelivered | manual
  source     String   @default("twilio") // twilio | manual
  raw        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountKey, phone])
  @@index([phone])
}

// ─────────────────────────────────────────────────────
// Email Campaigns (bulk + scheduled outbound)
// ─────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────
// Campaign container (AI Campaign Builder)
// ─────────────────────────────────────────────────────

// A multi-channel "campaign" — the named thing a user builds with the
// AI Campaign Builder (or the manual wizard). It groups the generated
// channel assets (emails, SMS, landing pages, forms, flows) so they can
// be reviewed and managed as one unit. The container is purely
// organizational: each asset keeps its own lifecycle/status and is
// edited/sent through its existing per-channel surface. Deleting a
// container never deletes its assets (all back-relations are SetNull).
model Campaign {
  id              String    @id @default(cuid())
  name            String
  // The account the campaign is built for. Required in practice (the
  // builder always operates in a single account context for branding /
  // sender identity / contacts); nullable only to tolerate an abandoned
  // admin-no-account draft. Generation is blocked when null.
  accountKey      String?
  account         Account?  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // Container lifecycle, distinct from each asset's own status:
  //   draft     — created, plan not yet generated into assets
  //   building  — generation in progress (assets being created)
  //   ready     — all assets generated as drafts, awaiting user action
  //   partial   — at least one asset left the draft state (sent/published)
  //   archived  — soft-archived
  // Only `building` and `archived` are written explicitly; draft/ready/
  // partial are derived at read time from the assets' own statuses.
  status          String    @default("draft")
  // How the campaign was created: ai (plan → confirm → generate) | manual |
  // automation (the ad generator's OEM offer run, which creates the container
  // so the ads and their companion email hang off one row).
  source          String    @default("ai")
  // The user's original natural-language brief (the hero textarea).
  goal            String?   @db.Text
  // The AI build plan (CampaignPlan JSON, see src/lib/ai/campaign-plan.ts),
  // persisted so the confirm step survives navigation and so a later
  // regenerate has the spec. Null for manual campaigns.
  plan            String?   @db.Text
  // Snapshot of branding/sender context resolved at plan time, so
  // generation stays reproducible if account settings change mid-build.
  contextSnapshot String?   @db.Text
  createdByUserId String?
  createdByRole   String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailBlasts  EmailBlast[]
  smsBlasts    SmsBlast[]
  landingPages LandingPage[]
  forms        Form[]
  flows        LoomiFlow[]

  @@index([accountKey, status])
  @@index([createdAt])
  @@index([archivedAt])
}

model EmailBlast {
  id               String    @id @default(cuid())
  name             String?
  // Set ONLY on the per-(flow,node) wrapper campaigns the flow engine
  // creates ("Flow:<id>/Node:<id>"). Unique so concurrent first-sends
  // upsert to one row instead of racing two duplicate wrappers. Null on
  // all normal campaigns (Postgres treats nulls as distinct).
  flowNodeKey      String?   @unique
  // Set ONLY on the companion offer email the ad-generator automation creates.
  // Keyed on the sub-account plus the SET of offers featured, so re-running
  // generate over the same offers updates one draft instead of stacking a new
  // one every night — the same idempotency discipline as
  // `AdCreative.offerFingerprint`. A new or changed offer yields a new key, and
  // therefore a new draft. Null on everything else (Postgres treats nulls as
  // distinct, so hand-built blasts never collide).
  automationKey    String?   @unique
  subject          String
  previewText      String?
  htmlContent      String
  textContent      String?
  sourceType       String    @default("template-library") // template-library | drag-drop | html
  status           String    @default("queued") // queued | scheduled | processing | completed | partial | failed | canceled
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdByUserId  String?
  createdByRole    String?
  sourceAudienceId String?
  sourceFilter     String?
  // Static list audience. When set, the worker pulls recipients from
  // ContactListMembership instead of evaluating sourceFilter. At most
  // one of (sourceListId, sourceAudienceId+sourceFilter, sourceContactIds)
  // is meaningful for a given campaign — the recipients UI enforces this
  // exclusivity.
  sourceListId     String?
  // Manual selection — JSON-stringified array of Contact IDs. When set,
  // the worker enumerates these contacts directly and skips list/segment
  // resolution. Used by the Contacts tab in the recipients picker for
  // ad-hoc canary/test sends to specific people.
  sourceContactIds String?
  accountKeys      String    @default("[]") // JSON array of account keys
  totalRecipients  Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  metadata         String?
  error            String?
  // Set when the campaign is archived via /archive. The daily purge
  // job hard-deletes rows where archivedAt < now − 30d. Null on live
  // (non-archived) rows.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipients EmailBlastRecipient[]

  // Optional link to a multi-channel Campaign container (AI Campaign
  // Builder). SetNull so deleting the container never deletes a send.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([campaignId])
  @@map("EmailCampaign")
}

model EmailBlastRecipient {
  id         String     @id @default(cuid())
  campaignId String
  campaign   EmailBlast @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  accountKey String
  email      String?
  fullName   String?
  status     String     @default("pending") // pending | sent | failed | skipped
  messageId  String?
  sentAt     DateTime?
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events EmailEvent[]

  @@unique([campaignId, contactId, accountKey])
  @@index([campaignId, status])
  @@index([accountKey, status])
  @@map("EmailCampaignRecipient")
}

// One row per SendGrid Event Webhook entry. We retain the raw payload
// so we can rebuild parsed columns if the schema evolves. recipientId
// is nullable to accommodate events for SendGrid traffic that wasn't
// produced by a Loomi campaign (e.g. transactional sends by the client
// through the same API key) — they're still logged for audit.
model EmailEvent {
  id          String               @id @default(cuid())
  campaignId  String?
  recipientId String?
  recipient   EmailBlastRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  accountKey  String?
  eventType   String // delivered | open | click | bounce | dropped | spamreport | unsubscribe | deferred | processed
  sgEventId   String               @unique // SendGrid's sg_event_id; the idempotency key
  sgMessageId String?
  email       String?
  timestamp   DateTime
  url         String? // populated for click events
  reason      String? // populated for bounce / dropped
  userAgent   String?
  ip          String?
  raw         String // full event payload as JSON for forensics
  createdAt   DateTime             @default(now())

  @@index([campaignId, eventType])
  @@index([recipientId])
  @@index([accountKey, eventType])
  @@index([sgMessageId])
  @@index([timestamp])
}

// Persistent per-account suppression list. The recipient resolver pulls
// these emails out of every campaign batch before send. Bounce + spam
// reports auto-populate from the webhook; unsubscribe + manual entries
// flow through other surfaces.
model EmailSuppression {
  id         String   @id @default(cuid())
  accountKey String
  email      String
  reason     String // bounce | spamreport | unsubscribe | manual
  source     String   @default("sendgrid") // sendgrid | manual
  raw        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountKey, email])
  @@index([email])
}

// ─────────────────────────────────────────────────────
// Per-account email compliance footer
// ─────────────────────────────────────────────────────
//
// Styling for the CAN-SPAM block appended to every blast and flow email.
//
// STRUCTURED, NOT HTML — on purpose. `config` holds presentation plus two
// copy strings; the dealer name, postal address, and unsubscribe link are
// emitted by the renderer in lib/sending/unsubscribe-footer.ts and cannot be
// configured away. A free-text HTML column here would be one paste away from
// shipping a blast with no address, which is exactly the bug this whole area
// was built to close. resolveFooterConfig() validates every field on read, so
// a hand-edited row still can't inject markup or break a style attribute.
//
// INHERITANCE — a row is an OVERRIDE, and absence is meaningful. Resolution
// walks up Account.parentAccountKey and takes the first row it finds, so a
// footer saved on a group account applies to every rooftop beneath it until
// that rooftop saves its own. Deleting a rooftop's row re-inherits rather
// than reverting to the built-in default.
model AccountEmailFooter {
  id String @id @default(cuid())

  // One override per account — the resolver wants at most one row to find.
  accountKey String  @unique
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// Partial UnsubscribeFooterConfig. Partial by design: fields the account
  /// never touched should follow the default if the default ever changes.
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Changelog
// ─────────────────────────────────────────────────────

model ChangelogEntry {
  id      String @id @default(cuid())
  title   String
  content String // Plain text body describing the change
  type    String @default("improvement") // feature | improvement | fix

  // Nothing reaches a reader — or an inbox — until a person publishes it.
  // Entries arriving from the merge-to-main automation land as `draft`; the
  // manual "New entry" form still publishes straight away.
  status String @default("published") // draft | published

  // Who the entry is written for. `staff` hides it from client-role users
  // and keeps them off the notification fan-out, so an internal-plumbing
  // note doesn't land in a dealer's inbox.
  audience String @default("everyone") // everyone | staff

  // Idempotency handle for automated entries, e.g. "pr:412". Unique so a
  // re-run of the workflow (re-open → re-merge, replay) can't duplicate the
  // entry. The importer only ever CREATES against this key — it never
  // updates — so edits made in Loomi are never clobbered by a later run.
  sourceKey String? @unique

  publishedAt DateTime  @default(now())
  createdBy   String? // user name or "Claude"
  publishedBy String? // who pressed Publish (null for auto/manual-create)
  notifiedAt  DateTime? // set once the publish fan-out has run; guards re-notify
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([status, publishedAt])
}

// ─────────────────────────────────────────────────────
// Docs — the in-app documentation library
// ─────────────────────────────────────────────────────
//
// Docs are authored as markdown under `content/docs/` so they version with the
// code that they describe and get reviewed in the same PR. `scripts/seed-docs.ts`
// loads them into this table per environment, which is what makes them editable
// in Loomi without a deploy.
//
// The seed is deliberately NOT a mirror. Once someone edits an article in the
// app, `editedInApp` latches and the seeder stops touching that row — a typo fix
// made at 4pm must not be undone by the next deploy. See docs/docs-library.md.
model DocArticle {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String // one line; the card subtitle and the search result blurb
  body    String @db.Text // markdown, rendered by src/lib/docs/markdown.ts

  // Which part of Loomi this documents. Mirrors `Sector` in the permission
  // registry plus `platform` for the cross-cutting articles (accounts, roles,
  // notifications, integrations) that belong to no single sector.
  sector   String // agency | studio | reporting | projects | platform
  category String // grouping within a sector, e.g. "Audiences"

  // Who may read it. `staff` keeps internal runbooks off client screens, the
  // same contract `ChangelogEntry.audience` uses — one word, two meanings, so
  // nobody has to learn a second vocabulary.
  audience String @default("everyone") // everyone | staff
  status   String @default("published") // draft | published

  order Int @default(0) // sort within a category

  // ── Freshness ───────────────────────────────────────
  //
  // `covers` is the set of repo globs the article describes. The drift job
  // (scripts/docs-drift.ts) looks for commits touching those paths since
  // `reviewedSha`; if it finds any, the article is flagged and staff see a
  // "needs review" badge. This is why an article names its own code.
  covers String[] @default([])

  needsReview Boolean   @default(false)
  reviewNote  String? // what changed, written by the drift job
  reviewedSha String? // the commit the article was last confirmed against
  reviewedAt  DateTime?

  // ── Provenance ──────────────────────────────────────
  //
  // `sourceKey` is the seeding file (e.g. `studio/audiences.md`), unique so a
  // re-seed can't duplicate the row. `sourceHash` is that file's content hash at
  // the last successful seed, so an unchanged file is a no-op.
  sourceKey  String? @unique
  sourceHash String?

  /// Latches the first time the article is saved in the app. The seeder skips
  /// any row with this set — a person's edit outranks the file.
  editedInApp Boolean @default(false)

  updatedBy String? // display name of whoever last saved it in the app
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector, category, order])
  @@index([status, sector])
  @@index([needsReview])
}

// ─────────────────────────────────────────────────────
// S3 Media Assets (supplementary storage alongside ESP)
// ─────────────────────────────────────────────────────

model MediaAsset {
  id              String                @id @default(cuid())
  accountKey      String? // null = admin-level (Loomi media library)
  account         Account?              @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  s3Key           String // "media/_admin/{id}/{filename}" or "media/{accountKey}/{id}/{filename}"
  filename        String
  mimeType        String
  size            Int // bytes
  width           Int? // image-only
  height          Int? // image-only
  thumbnailKey    String? // "media/_admin/{id}/thumb.webp"
  altText         String? // accessible alt text for images — used as the default alt= when inserting <img> from the picker, editable across the media library
  // Which media-picker tab this appears under. NOT the DAM taxonomy — see
  // `assetCategory` below, and lib/media-metadata.ts for why they stay separate.
  category        String? // "brand" | "ad-creative" | "oem" | "general" | "texture"
  tags            String? // JSON string[] — free-form keywords (Phase 2 surfaces them)
  /// Generated platform-size derivatives. Cascade-deleted with the master —
  /// they have no meaning without it.
  renditions      MediaRendition[]
  /// Static-collection memberships.
  collectionItems MediaCollectionItem[]
  /// Shareable links pointing at this asset.
  publicLinks     MediaPublicLink[]
  uploadedBy      String? // User ID
  archivedAt      DateTime? // soft-archive: hidden from the default library view, restorable
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // ── DAM metadata (docs/asset-management.md Phase 1) ──
  //
  // All nullable and additive, so this reaches every environment through the
  // `prisma db push` the deploy already runs, and every pre-existing asset stays
  // exactly as visible as it was.

  /// OEM scope. Set WITH a null accountKey = a manufacturer-shared asset, visible
  /// to every account carrying that brand (see getEffectiveMediaForAccount).
  /// Set alongside an accountKey it is descriptive only — "this rooftop asset is
  /// Audi's" — and does not widen visibility.
  ///
  /// This is the column the whole phase exists for: without it, an OEM asset used
  /// by six rooftops has to be uploaded six times.
  oem           String? // normalized against lib/oems.ts
  /// Where the asset came from — lib/media-metadata.ts ASSET_SOURCES. Drives the
  /// card badge now and the rights defaults in Phase 3.
  ///
  /// Named `assetSource`, not `source`, because the API payload's `source` is
  /// already the storage discriminator ('esp' | 's3') that the media UI reads.
  /// Two different meanings under one name is a bug waiting to happen.
  assetSource   String?
  /// The DAM taxonomy value — ASSET_CATEGORIES. Distinct from `category`.
  assetCategory String?
  /// JSON string[] of 4-digit years. An array because an OEM template package
  /// legitimately spans model years ("MY25_MY26") and collapsing it loses that.
  modelYear     String?
  /// JSON string[] of vehicle model names.
  vehicleModel  String?
  /// Who owns the rights, e.g. "Audi of America". Free text in Phase 1; Phase 3
  /// adds the structured licence window this is the human-readable half of.
  rightsHolder  String?
  /// Derivative lineage: a crop/resize/duplicate points at the master it came
  /// from, so "which assets derive from this?" is answerable. No FK relation —
  /// deleting a master must not cascade away its derivatives, which may be the
  /// only approved copies in use.
  parentAssetId String?
  /// sha256 of the uploaded bytes. Powers duplicate detection on upload — the
  /// same job contentHash does on AdGuidelineDoc.
  ///
  /// Deliberately NOT unique: the same file legitimately exists under two scopes
  /// (an OEM master and a rooftop's own copy), and a unique constraint would also
  /// fail `db push` on any environment already holding duplicates.
  contentHash   String?

  // ── Rights management (docs/asset-management.md Phase 3, §6) ──
  //
  // The most commonly under-implemented DAM capability, and the one that
  // actually bites an automotive agency: OEM photography is licensed for a
  // window, and creative that outlives its licence is a real exposure. All
  // nullable — an asset with no licence recorded is "unknown", which reads
  // differently from "unlimited" and must not be treated as either.
  //
  // `rightsHolder` above is the licence HOLDER; these describe the licence.

  /// lib/media-rights.ts LICENSE_TYPES — OEM-licensed, stock, talent release…
  licenseType           String?
  /// The agreement this asset is covered by, e.g. "Ford-2026-lifestyle-Q3".
  /// Free text: it is whatever reference the counterparty used.
  licenseRef            String?
  licenseStartsAt       DateTime?
  /// When the LICENCE lapses — distinct from `expiresAt`, which is when the
  /// offer or campaign the asset advertises ends. An asset can outlive its offer
  /// and still be licensed, or the reverse.
  licenseExpiresAt      DateTime?
  /// JSON string[] — where it may be used (digital, print, social, OOH…).
  usageScope            String?
  /// JSON string[] — territories it is cleared for. Feeds OEM DAT compliance
  /// once there is a launch gate to enforce it.
  territoryScope        String?
  /// Tri-state on purpose: null = not recorded, which is not the same as false.
  /// A missing talent release and a confirmed absent one carry different risk.
  exclusive             Boolean?
  talentReleaseOnFile   Boolean?
  /// Whether the licence permits derivative works (resize, crop, composite).
  /// The one rights field automated generation must respect: compositing an
  /// asset that forbids derivatives is a breach nobody would catch by eye.
  derivativesPermitted  Boolean?
  sublicensingPermitted Boolean?

  /// When the offer/campaign this asset supports ends. Set by a person, or
  /// carried from the offer for generated creative.
  expiresAt DateTime?

  /// Set by the expiration sweep when the asset passes whichever date came
  /// first. A TIMESTAMP rather than a status value, matching `archivedAt` and
  /// AdCreative's convention: expiry is orthogonal to whatever workflow state
  /// Phase 5 adds, and folding them together would lose one of them.
  expiredAt          DateTime?
  /// Why it expired — "license" | "effective" | "manual". §3 of the design note
  /// requires the trigger source to be auditable; without it nobody can tell a
  /// lapsed licence from an ended campaign after the fact.
  expirationReason   String?
  /// Last advance warning sent, so the daily sweep doesn't re-notify. Null once
  /// the dates move, which is what makes a renewal re-arm the warnings.
  expirationWarnedAt DateTime?

  // ── Approval lifecycle (docs/asset-management.md Phase 5, §5) ──
  //
  // Four states, and only two of them live here: `draft` and `approved`. The
  // other two are the timestamps above — `expiredAt` and `archivedAt` — kept
  // separate on purpose. An asset can be approved AND expired (cleared for use,
  // licence since lapsed), or approved AND archived. Collapsing them into one
  // enum would lose which of the three was true, exactly as folding archive into
  // AdCreative.status would have.
  //
  // Defaults to `draft`, including for everything already in the library:
  // nothing has been reviewed, so nothing should claim it has.

  /// "draft" | "approved". Cleared for use, not "published" — distribution is a
  /// separate question the Go-to-Market work answers.
  status          String    @default("draft")
  approvedAt      DateTime?
  approvedById    String?
  /// Denormalized so the review history survives the reviewer leaving.
  approvedByName  String?
  /// Free-text note from the reviewer. Carries a rejection reason too: sending
  /// an asset back leaves it in `draft` WITH the note, rather than inventing a
  /// fifth state whose only difference from draft is that someone looked at it.
  reviewNote      String?   @db.Text
  /// Pre-flight findings as of the last approve attempt, JSON MediaPreflight.
  /// Stored so a reviewer sees what was checked without re-running it, and so an
  /// approval remains explicable against the rules in force at the time.
  preflightResult String?   @db.Text

  // ── Externally-managed assets ──
  //
  // Brand logos and custom fonts live on the Account record (`logos`,
  // `customFonts`) and are read from there by the ad builder, emails and landing
  // pages. They were uploaded to S3 but never catalogued, so the DAM couldn't
  // see the most-reused assets an agency owns.
  //
  // These rows CATALOGUE them; they do not own them. Account settings remains
  // the authority for the lifecycle, and the library renders them read-only —
  // deleting one here would break a live logo, which is not a thing the library
  // should be able to do.

  /// What owns this row's lifecycle: "account-logo" | "account-font".
  /// Null = an ordinary asset the library owns outright.
  managedBy  String?
  /// Which one — the logo variant ("light", "storefront") or the font's
  /// `family|weight|style`. Together with managedBy this is what lets a sync
  /// reconcile rows against the Account record rather than duplicating them.
  managedRef String?

  @@unique([s3Key])
  @@index([accountKey, createdAt])
  @@index([accountKey, category])
  @@index([accountKey, archivedAt])
  // OEM-scope reads: "every Audi asset that isn't archived".
  @@index([oem, archivedAt])
  // Duplicate lookup on upload.
  @@index([contentHash])
  @@index([parentAssetId])
  // Brand-asset sync: "which rows does this account's logo/font set own?"
  @@index([accountKey, managedBy])
  // Approval reads: the client-facing view asks for one account's approved
  // assets, and the review queue asks for one account's drafts.
  @@index([accountKey, status])
  // The expiration sweep's two scans: "what has lapsed" and "what lapses soon".
  // Both run daily across every account, so they are the one query here that
  // isn't scope-limited.
  @@index([licenseExpiresAt])
  @@index([expiresAt])
}

// A shareable link to one asset, usable without a Loomi login.
//
// The gap: handing an asset to a dealer, a vendor or a printer meant either
// giving them an account or emailing the file. Neither scales, and re-emailing
// on every revision is how stale creative gets used.
//
// A STORED token, not a signed one. lib/forms/file-tokens.ts signs an HMAC with
// an expiry, which is right there — those links are meant to lapse. These are
// meant to LAST and to be revocable, and a signed token can't be revoked
// without a database lookup anyway. So the row IS the token: delete it and the
// link dies.
//
// ── What this is not ──
//
// Objects are uploaded public-read, so the underlying S3 URL is already
// world-readable. Revoking a link stops anyone holding the LINK, not anyone who
// saved the direct bucket URL. That makes this a convenience and audit boundary,
// not a security one — see the route comment. Locking the bucket down is a
// separate piece of work.
model MediaPublicLink {
  /// The token itself — random, unguessable, and the primary key so a lookup is
  /// the same operation as a validation.
  id      String     @id
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// What this link is for ("Sent to Young Chevy print vendor"), so a list of
  /// six links is legible months later.
  label String?

  /// Optional. Null = non-expiring, which is the default and the point.
  expiresAt DateTime?
  /// Set on revoke rather than deleting the row: who shared what, and when it
  /// was pulled, is the audit trail. A deleted row answers nothing.
  revokedAt DateTime?

  /// Cheap usage signal — enough to answer "is anyone actually using this?"
  /// without building analytics.
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?

  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([assetId, revokedAt])
}

// A named set of assets — the replacement for folders.
//
// Folders were removed because they could only express "an arbitrary pile
// someone made", and they did it badly: an asset lived in exactly one, so a
// photo that belonged to both the summer campaign and the brand library had to
// pick. Collections don't have that problem — an asset can be in any number —
// and they come in two kinds:
//
//   static  a curated list. "Ford Ogden August — final creative package."
//   smart   a saved SEARCH. "All approved Audi display assets." New assets
//           matching the criteria appear automatically; nothing to maintain.
//
// Scoped exactly like assets (accountKey null = agency-level), so a collection
// of OEM-shared work isn't trapped inside one rooftop.
model MediaCollection {
  id         String   @id @default(cuid())
  accountKey String? // null = agency-level
  account    Account? @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  name        String
  description String? @db.Text

  /// "static" | "smart".
  kind String @default("static")

  /// For smart collections: JSON MediaCollectionQuery — the scope, facet
  /// selection and search text that define it. Null on static ones.
  ///
  /// Stored as the QUERY rather than as resolved ids, which is the whole point:
  /// resolving at read time is what makes "new matching assets appear
  /// automatically" true instead of a promise someone has to keep manually.
  query String? @db.Text

  items MediaCollectionItem[]

  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // "This account's collections", the only listing there is.
  @@index([accountKey, updatedAt])
}

// Membership for a STATIC collection.
//
// A join table rather than a JSON id list on the collection: it makes "which
// collections is this asset in?" a real query, and it lets the asset FK clean up
// after a delete instead of leaving a dangling id in a blob.
model MediaCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String
  asset        MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Manual ordering within the collection. A "final creative package" has an
  /// order someone chose; alphabetical would discard it.
  position  Int      @default(0)
  addedBy   String?
  createdAt DateTime @default(now())

  // An asset appears at most once in a collection — adding twice is a no-op,
  // not a duplicate row.
  @@unique([collectionId, assetId])
  @@index([collectionId, position])
  @@index([assetId])
}

// One run of the media rights expiration sweep — its heartbeat.
//
// Written on EVERY run, including a run that found nothing, because "no licences
// expired today" and "the sweep stopped running three weeks ago" are
// indistinguishable without a row. That is the same reason expire-ads.ts records
// an AdAutomationRun, and the reason this exists at all: the sweep shipped
// without it, so a job that silently died would have looked exactly like a quiet
// one.
//
// A separate table rather than reusing AdAutomationRun: that table is the Ad
// Generator's heartbeat and shadow-report.ts reads it with no `kind` filter, so
// media rows would surface as phantom entries in the generator's run history.
// Per-domain run tables are the established shape here — see IngestRun.
model MediaSweepRun {
  id String @id @default(cuid())

  /// null = the scheduled sweep across every account; set for an on-demand run.
  accountKey String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Rows examined. Zero with no error means the sweep ran and nothing was due —
  /// which is the normal, healthy case and must be distinguishable from absence.
  scanned      Int @default(0)
  expiredCount Int @default(0)
  warnedCount  Int @default(0)

  /// JSON: what expired and what was warned, so "why did this asset get pulled?"
  /// is answerable after the fact.
  detail String? @db.Text
  /// Set when the sweep itself failed. A failed run still gets a row — an error
  /// nobody can see is the failure mode this table exists to prevent.
  error  String? @db.Text

  @@index([startedAt])
  @@index([accountKey, startedAt])
}

// A generated derivative of a MediaAsset at a platform size — Phase 4 of
// docs/asset-management.md (§8, Automatic Processing).
//
// A SEPARATE table rather than child MediaAssets, even though `parentAssetId`
// exists and would have fit. Renditions are outputs, not library items: eight
// sizes per master would multiply the grid by nine, distort every facet count,
// and invite someone to tag or licence a derivative independently of the master
// it came from. They belong TO an asset, so they hang off it.
//
// The master is always the source of truth. Renditions are disposable — delete
// and regenerate freely; nothing should ever reference one as an original.
model MediaRendition {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Catalog size name, e.g. "Instagram Square". Free text rather than an enum
  /// so a size retired from AD_SIZE_CATALOG doesn't orphan existing rows.
  name     String
  platform String
  width    Int
  height   Int

  s3Key    String
  mimeType String
  size     Int // bytes

  /// How the master was fitted to the frame — "cover" crops to fill, "contain"
  /// letterboxes. Recorded because a rendition that cropped someone's logo out
  /// needs to be explicable without re-running the job.
  fit String @default("cover")

  createdBy String?
  createdAt DateTime @default(now())

  // One rendition per size per asset: regenerating replaces rather than
  // accumulating near-identical copies.
  @@unique([assetId, name])
  @@unique([s3Key])
  @@index([assetId])
}

// ─────────────────────────────────────────────────────
// Meta Ads Pacer
// ─────────────────────────────────────────────────────

model MetaAdsPacerPlan {
  id              String   @id @default(cuid())
  accountKey      String   @unique
  account         Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  baseBudgetGoal  String? // legacy account-wide default (replaced by MetaAdsPacerPeriodBudget per-month entries)
  addedBudgetGoal String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // When the daily alert pre-sync last pulled this account from Meta.
  //
  // The pre-sync is network-bound and sequential, and the whole scan answers
  // one HTTP request behind a 60s gateway — so it works to a wall-clock budget
  // and refreshes the STALEST accounts first, stamping this as it goes. Nulls
  // sort first, so an account that has never been pre-synced is picked up
  // before one that was done yesterday. That's what stops a fixed slice
  // starving the tail of the list forever.
  alertPreSyncAt DateTime?

  ads                   MetaAdsPacerAd[]
  periodBudgets         MetaAdsPacerPeriodBudget[]
  monthSnapshots        MetaAdsPacerMonthSnapshot[]
  auditEntries          MetaAdsPacerAuditEntry[]
  carryoverApplications MetaAdsPacerCarryoverApplication[]
  dailySpend            MetaAdsPacerDailySpend[]
}

/**
 * Per-day spend for a LINKED platform object (Meta ad set / Google campaign),
 * written by the sync jobs. Feeds the pacing-health engine: the rolling 7-day
 * Meta health window (which must subtract spend older than 7 days) and the
 * empirical per-account overage-allowance derivation (highest single-day
 * spend ÷ that day's budget). Keyed by the PLATFORM object id, not the pacer
 * ad row — the same ad set appears as a different row each month, but its
 * spend history is one continuous series. ~90 days retained (pruned on sync).
 */
model MetaAdsPacerDailySpend {
  id          String           @id @default(cuid())
  planId      String
  plan        MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  platform    String // "meta" | "google"
  objectId    String // Meta ad-set id / Google campaign id
  date        String // YYYY-MM-DD in the platform-reported (account) timezone
  spend       String // $ (string to match the other money fields)
  // Daily budget in effect that day ($), when known. Captured as the current
  // budget the first time each day is synced, then PRESERVED across later
  // re-pulls (reconcileSeriesBudgets) so a mid-flight raise doesn't overwrite
  // pre-change history — exact from the day snapshotting began, an
  // approximation only for the initial pre-tool backfill. Feeds the overage
  // derivation and the pacing-health "ramping" annotation / budget-change divider.
  dailyBudget String?

  @@unique([planId, platform, objectId, date])
  @@index([planId, platform, date])
}

/**
 * Automatic audit log (Change 10). Every tracked change — daily budget, actual
 * spend, allocation, budget goals, status, flight dates, carryover, freeze/
 * reopen, bulk applies, Meta syncs — is recorded here with who/what/from→to/
 * when, no button press. The manual "Log Budget" snapshot (MetaAdsPacerBudgetLog)
 * is a separate, deliberate checkpoint layered on top. Purged after 1 year.
 */
model MetaAdsPacerAuditEntry {
  id           String           @id @default(cuid())
  accountKey   String
  planId       String
  plan         MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  period       String // YYYY-MM
  // Platform the change belongs to, so Meta and Google keep separate change
  // logs. null / anything ≠ "google" = Meta (legacy rows have null); "google"
  // = Google. Resolved with adPlatformWhere() on read.
  platform     String?
  adId         String? // null for period-level (budget goals) / account-level events
  adName       String? // denormalized so the trail survives ad deletion
  action       String // edit | created | deleted | carryover | freeze | reopen | sync
  field        String? // e.g. pacerDailyBudget, adStatus
  fromValue    String?
  toValue      String?
  summary      String // human-readable one-liner
  groupId      String? // ties a multi-entry action together (one save / bulk apply)
  authorUserId String?
  createdAt    DateTime         @default(now())

  @@index([accountKey, period, createdAt])
  @@index([adId, createdAt])
  @@index([createdAt])
}

/**
 * Immutable end-of-month freeze (Change 5). Once a month has fully settled
 * (past the grace period after month-end), the pacer captures the exact plan
 * payload — per-ad spend, effective flight dates, target, budget goals,
 * markup, timezone — so a closed month stays a faithful record even if the
 * live ad rows are later edited. `reopenedAt` set = an admin reopened it for
 * correction, so the live rows are served (editable) until it re-freezes.
 */
model MetaAdsPacerMonthSnapshot {
  id               String           @id @default(cuid())
  planId           String
  plan             MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  period           String // YYYY-MM
  payloadJson      String // frozen plan payload (ads + budget goals + markup + timeZone)
  frozenAt         DateTime         @default(now())
  frozenByUserId   String?
  reopenedAt       DateTime?
  reopenedByUserId String?

  @@unique([planId, period])
  @@index([planId])
}

model MetaAdsPacerPeriodBudget {
  id                    String           @id @default(cuid())
  planId                String
  plan                  MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  period                String // YYYY-MM, e.g. "2026-04"
  // Account budget goals are PER-PLATFORM (Meta vs Google specialists own their
  // own budgets). The base/added pair below is Meta's; the google* pair is
  // Google's. Same single row per plan+period; the surface resolves its pair by
  // platform. (§8 Google pacer.)
  baseBudgetGoal        String?
  addedBudgetGoal       String?
  googleBaseBudgetGoal  String?
  googleAddedBudgetGoal String?
  // Budget-module ownership (docs/budget-module.md §4). When true, the pair
  // above is written by syncPeriodBudgetFromLines from the BudgetLine ledger
  // and the pacer UI renders it read-only — one writer at a time, which is the
  // whole point of the binding. Per-platform and per-period, so a Meta
  // specialist unmanaging August doesn't touch Google or September.
  //
  // Deliberately a STORED FLAG, not inferred from "does this month have lines":
  // a legitimately $0 month would read as unmanaged and quietly serve a stale
  // hand-typed number. Opt-in per account, so nothing changes for anyone until
  // it's switched on — necessary while Oz Reports is still the system of record
  // for accounts that have no lines yet.
  managedByBudget       Boolean          @default(false)
  googleManagedByBudget Boolean          @default(false)
  // Carryover applied from the prior month's over/under (Change 7), in
  // actual-spend dollars, per bucket. Opt-in (null = none). Added to the
  // DERIVED spend target only (target = clientBudget × markup + carryover);
  // it NEVER modifies the typed budget goals above, which stay the billing
  // record. Single-month: set once on approval, not auto-chained.
  baseCarryover         String?
  addedCarryover        String?
  // Google's carryover pair — kept separate so a Google specialist's
  // reconciliation never writes into Meta's carryover (and vice versa). The
  // surface resolves its pair by platform, same as the budget goals above.
  googleBaseCarryover   String?
  googleAddedCarryover  String?
  // Backfilled actual spend for a pre-pacer month (account-total from Meta,
  // combined — not bucket-split). Lets year reconciliation include months from
  // before the tool existed. Null for normally-tracked months (their actual is
  // Σ ad pacerActual). The client budget for these months is entered later into
  // baseBudgetGoal, so over/under = historicalActual − baseBudgetGoal × markup.
  historicalActual      String?
  // The account-level monthly spend Meta reports for this month (Graph
  // insights, time_increment=monthly) — the reconciliation's RAW anchor. Stored
  // rather than fetched per page load so the tie-out survives a Meta outage, an
  // expired token, and the daily-series retention window. Independent of the ad
  // rows BY DESIGN: that independence is the whole point of the Raw-vs-Counted
  // check (an ad spending in the account but never linked in Loomi shows up as
  // a residual only because these two numbers come from different places).
  // Meta-only — Google has no equivalent account pull, so its raw stays the row
  // sum. Null = never pulled (the month then falls back to the row sum and is
  // excluded from the tie-out rather than reported as a phantom gap).
  metaAccountSpend      String?
  metaAccountSpendAt    DateTime?
  // ── Google allocator (google-pacing-card spec §3/§9) ──
  // The unit the WHOLE Google card allocates in: "pct" (percent of payable) or
  // "amt" (dollar amounts). One unit for every line, deliberately — mixed units
  // per line were the source of the toggle-drift and pool-shrink bugs. Google
  // only; Meta's card has no allocator. Null = "pct" (the default).
  googleAllocationMode  String?
  // Optional intended budget per LABEL, as JSON Record<label, number> — e.g.
  // {"Summer Sales Event": 1200}. Used only in a filtered (label) view, where
  // the tagged campaigns' allocation is checked against it so added sales
  // dollars can be confirmed fully allocated rather than absorbed into regular
  // budget. Never the account denominator: unfiltered, allocation is always
  // checked against payable.
  googleEventBudgets    String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([planId, period])
  @@index([planId, period])
}

/// One application of a month's settled over/under into a later month's spend
/// target (reconciliation). The ledger is the source of truth for how much of a
/// given source month's over/under has been consumed, so the YTD net and each
/// month's unapplied remainder stay honest across arbitrary apply actions.
model MetaAdsPacerCarryoverApplication {
  id              String           @id @default(cuid())
  planId          String
  plan            MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // null = Meta (legacy); "google" = Google. Scopes the reconciliation ledger
  // per platform so each specialist's applies stay independent.
  platform        String?
  bucket          String // "base" | "added" — the target month bucket it lands in
  sourceMonth     String // YYYY-MM the over/under came from
  targetMonth     String // YYYY-MM it was applied into
  amount          String // actual-spend dollars applied (signed)
  appliedByUserId String? // recorded for display; no FK so plan delete cascades cleanly
  appliedAt       DateTime         @default(now())

  @@index([planId, sourceMonth])
  @@index([planId, targetMonth])
}

model MetaAdsPacerAd {
  id       String           @id @default(cuid())
  planId   String
  plan     MetaAdsPacerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  position Int              @default(0)

  name String @default("")

  // Assignments
  ownerUserId      String?
  owner            User?   @relation("MetaPacerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  designerUserId   String?
  designer         User?   @relation("MetaPacerDesigner", fields: [designerUserId], references: [id], onDelete: SetNull)
  accountRepUserId String?
  accountRep       User?   @relation("MetaPacerAccountRep", fields: [accountRepUserId], references: [id], onDelete: SetNull)

  // Planning
  period          String  @default("") // YYYY-MM bucket — primary planning axis
  month           String? // legacy month-name tag, retained for backwards compat
  actionNeeded    String?
  recurring       String  @default("No") // Yes | No | Unknown
  coop            String  @default("No") // Yes | No | Unknown
  budgetType      String  @default("Daily") // Daily | Lifetime
  // base | added | split. When "split", the ad's allocation is divided
  // between the two budget pools — splitBaseAmount goes to Base, the
  // rest goes to Added. pacerActual splits proportionally to keep both
  // pools' over/under math accurate.
  budgetSource    String  @default("base")
  splitBaseAmount String?

  // Dates (ISO yyyy-MM-dd strings to mirror <input type="date">)
  flightStart     String?
  flightEnd       String?
  liveDate        String?
  creativeDueDate String?
  dueDate         String? // overall ad due date — auto-calc 2 business days before flightStart
  dateCompleted   String?

  // Status
  adStatus         String @default("In Draft")
  designStatus     String @default("Not Started")
  internalApproval String @default("Pending Approval")
  clientApproval   String @default("Pending Approval")

  // Money (string to mirror form input, parsed at calc time)
  allocation            String?
  // Google allocator (spec §3): the line's PERCENT-OF-PAYABLE input, kept only
  // while the card is in percent mode. `allocation` above stays the authoritative
  // dollar target in BOTH modes — everything downstream (reconciliation, the
  // over/under, the budget panels) reads dollars and must not learn about modes.
  // This exists so a percent survives a change to the account payable: in percent
  // mode the dollar target is RE-DERIVED as percent ÷ 100 × payable, which is
  // impossible from a stored dollar alone. Null on Meta rows and in dollar mode.
  allocationPercent     String?
  pacerActual           String?
  pacerDailyBudget      String?
  // Full-run actual spend across the linked ad set's entire flight (Meta
  // date_preset=maximum), not just the current pacing month. Informational —
  // surfaced for multi-month ads so the full date-range spend is visible; never
  // drives the month's pacing math.
  pacerRunSpend         String?
  // The ad set's LIFETIME budget pulled from Meta (the true spend cap Meta
  // distributes toward), in dollars. Synced from the Marketing API's
  // lifetime_budget. This is the settlement baseline for a lifetime run:
  // variance settles as Σ actual across the run − metaLifetimeBudget. Distinct
  // from `allocation` (the team's per-month planned slice) and `pacerRunSpend`
  // (actual full-run spend). Null for daily-budget ad sets / before first sync.
  metaLifetimeBudget    String?
  // §2a: the YYYY-MM the ad's FULL run was counted in (single-month straddler
  // resolution). When set, the assigned month uses pacerRunSpend + allocation
  // (full scope) and the ad contributes 0 to any other month. Server-managed
  // via /resolve-cross-month; never written by autosave or the Meta sync.
  fullRunAppliedToMonth String?
  // Cross-month settlement SNAPSHOT (rebuild §5). `fullRunAppliedToMonth` above
  // is the stored intent ("bill this run in month X"); these three are the
  // stored FACTS captured the first time the flight settles (run complete AND
  // billed month reached). After that, Out/In read
  // `settledRunSpend − settledBilledDelivery` instead of the live fields, so the
  // posting can never move under a later re-sync or once the rolling daily
  // series (MetaAdsPacerDailySpend, 120-day retention) prunes the run's days.
  // Both inputs are persisted, not just the derived Out, so the split and the
  // tie-out stay auditable. Written server-side by the reconciliation read;
  // never by autosave or the Meta sync.
  settledRunSpend       String?
  settledBilledDelivery String?
  settledAt             DateTime?
  // §2b: JSON Record<YYYY-MM, number> — a lifetime ad's editable planned split
  // across the months its flight touches. DISPLAY-ONLY (planned vs actual);
  // never books a variance (§3 owns the over/under). Server-managed too.
  lifetimeMonthSplit    String?
  // Cross-month SPLIT run linkage (Prompt 1): this month-instance continues the
  // linked prior-month ad's run. The chain (followed via this pointer) is one
  // logical lifetime run that settles ONCE at flight end — the final month books
  // Σ actual across the chain − the Meta lifetime budget; every earlier linked
  // month books $0. Null = not part of a linked split run. Set via the
  // "link to previous month" dropdown; server-managed (survives Meta re-sync).
  linkedPrevAdId        String?

  // Pacer-only date scoping: lets the user adjust "today" and "end" per ad
  // without affecting the Ad Planner flight dates.
  pacerTodayDate String?
  pacerEndDate   String?

  // Facebook (Meta) Ads sync. When `metaObjectId` is set the row is "linked"
  // to a Facebook object and the Sync-from-Facebook job owns its spend:
  // pacerActual (and, for Daily ads, pacerDailyBudget) are overwritten from the
  // Marketing API. `allocation` is the PLANNED target spend and is never
  // touched by sync. metaEffectiveStatus mirrors the FB
  // delivery status for mismatch display only — it never touches adStatus.
  // pacerSyncedAt timestamps the last successful pull (drives the "synced
  // Xh ago" badge). All three are server-managed: the client PUT spreads
  // them back but the route ignores them, so autosave can't clobber a sync.
  metaObjectType      String? // "campaign" | "adset" | "ad"
  metaObjectId        String?
  metaEffectiveStatus String?
  pacerSyncedAt       DateTime?
  // Actual run schedule from Meta (start_time / stop_time), stored as the
  // ad-account-timezone calendar date (YYYY-MM-DD) at sync time. Server-
  // managed, kept separate from the planner's flightStart/flightEnd so Meta's
  // truth never clobbers planning intent. The pacer clamps these to the
  // pacing month: effective_end = min(metaEndDate ?? flightEnd, month_end).
  // metaEndDate is null for campaigns Meta reports with no stop_time.
  metaStartDate       String?
  metaEndDate         String?

  // Google Ads sync (§8) — parallel to the Meta block above, reusing the same
  // planner/pacer/reconciliation flow. `platform` tags the row's ad platform:
  // null/"meta" = a Meta line (back-compat for every existing row), "google" =
  // a Google campaign line. For Google lines `googleCampaignId` links to the
  // Google Ads CAMPAIGN (the budget/pacing grain per §8 — never an ad group/ad);
  // `googleChannelType` is the display-only rollup tag (Search/Display/Video/
  // Shopping/PMax, PMax kept as its own group); googleEffectiveStatus/Start/End
  // mirror the Meta equivalents. Spend syncs via metrics.cost_micros under the
  // same server-managed rules as Meta (sync owns pacerActual, never allocation;
  // pacerSyncedAt is shared across both platforms).
  platform                     String? // null | "meta" | "google"
  googleCampaignId             String?
  googleChannelType            String? // "Search" | "Display" | "Video" | "Shopping" | "PMax"
  googleEffectiveStatus        String?
  googleStartDate              String?
  googleEndDate                String?
  // The campaign_budget resource name — multiple campaigns can share one budget,
  // so the §8 "daily set" account roll-up dedupes on this (distinct budgets, not
  // per-campaign rows) to avoid overstating the run-rate.
  googleBudgetResourceName     String?
  // §2 — Google budget shape, synced from campaign_budget. `referenceCount` is
  // the count of enabled/paused campaigns pointing at this budget; > 1 = a
  // genuinely SHARED budget (the pacing unit becomes the budget, not the
  // campaign) and drives the shared badge. `explicitlyShared` is the shareable
  // FLAG (a budget can be shareable yet feed one campaign) — kept only for
  // completeness; the badge keys off referenceCount, never this. `budgetPeriod`
  // is the platform pacing axis: "DAILY" (average daily, amount_micros) or
  // "CUSTOM_PERIOD" (campaign total budget, total_amount_micros) — write-once on
  // Google's side and the source of the Daily/Total label (it maps to the
  // Daily/Lifetime branch the engine already keys off).
  googleBudgetReferenceCount   Int?
  googleBudgetExplicitlyShared Boolean?
  googleBudgetPeriod           String? // "DAILY" | "CUSTOM_PERIOD"
  // §5 delivery signals, synced from Google. These look alike (both under
  // target) but need OPPOSITE fixes, so they're tracked separately:
  //  • googleBudgetConstrained — campaign.primary_status_reasons contains
  //    BUDGET_CONSTRAINED: spends its full cap every day, has headroom, point it
  //    at unallocated pool budget (raise budget).
  //  • googleAdsDisapproved — at least one ad_group_ad.policy_summary
  //    .approval_status is DISAPPROVED: budget is sized right but ads can't
  //    serve (fix the ads, never raise the budget).
  // googlePrimaryStatus keeps the raw campaign.primary_status for display.
  googlePrimaryStatus          String?
  // The FULL campaign.primary_status_reasons list, JSON-encoded. The two
  // booleans above are derived from it and answer one question each; this is
  // kept because the delivery panel has to say WHY a campaign isn't serving
  // (budget removed, pending, ended, policy) and that reason set is exactly
  // what the mismatch warning needs to be actionable rather than alarming.
  googlePrimaryStatusReasons   String?
  googleBudgetConstrained      Boolean   @default(false)
  googleAdsDisapproved         Boolean   @default(false)
  // Delivery-surface metric tiles (delivery/reallocation spec §4). These ride the
  // SAME account-wide month-to-date query that produces pacerActual, so a tile can
  // never disagree with the spend figure above it and opening N row expanders
  // costs ZERO Google calls. Server-managed by the sync, exactly like pacerActual:
  // the client PUT allow-list omits them, so autosave can't clobber a sync.
  //
  // Only the raw INPUTS are stored. Avg CPC, CTR and cost/conv are derived at
  // render (spend ÷ clicks, clicks ÷ impressions, spend ÷ conversions) rather
  // than trusted from the API, because Google's own cost_per_conversion is blank
  // at zero conversions and a blank beside a real spend figure reads as "free".
  // conversions_from_interactions_rate is stored, not derived — interactions ≠
  // clicks on several campaign types and we don't pull interactions.
  googleImpressions            Int?
  googleClicks                 Int?
  googleConversions            String?
  googleConvRate               String? // fraction 0–1, ×100 at display
  // Search impression share lost, as FRACTIONS 0–1 (×100 at display). Search and
  // Shopping only: null for PMAX / Demand Gen / Display, and null when the
  // account is under Google's reporting threshold — both render "not available",
  // never a zero. Google reports anything above 90% as exactly 0.9, so 0.9 must
  // display as "≥90%". These are RATIOS over eligible impressions: they are read
  // unsegmented over the whole month window and must never be summed or averaged
  // across days.
  //  • budget-lost — demand exists, the budget ran out. Can absorb more money.
  //  • rank-lost   — bid/Quality Score is the constraint. More money just sits.
  googleSearchBudgetLostIs     String?
  googleSearchRankLostIs       String?
  // Last day covered by the metrics above (YYYY-MM-DD) — the tiles' own "as of"
  // stamp. Matches pacerActual's window end exactly: the DATA EDGE (yesterday in
  // a live month, the month end in a closed one), never today. A stale stamp is
  // how a failed metrics pull surfaces: the sync leaves the previous values in
  // place rather than writing zeros.
  googleMetricsAsOf            String?
  // When this campaign's daily budget was last pushed to Google (§14). Drives
  // the just-applied marker: Google takes 24–48h to re-pace around a budget
  // change, so numbers read the morning after a push describe the OLD rate.
  // Without a visible "applied yesterday", the natural reaction is to push
  // again on figures that have not caught up yet. Visible only — it never
  // blocks a second push, because sometimes the second push is the right call.
  googleDailyPushedAt          DateTime?
  // The campaign restricts days/dayparts via an ad schedule. Since Google's
  // June 2026 change, scheduled campaigns pace the FULL monthly cap into
  // their active days, so calendar-day pacing math misreads them — detected
  // and badged for now (active-day math is a follow-up).
  googleHasAdSchedule          Boolean   @default(false)
  // §9 — monthly ceiling ($), server-computed at sync time. A Google daily
  // budget's real cap is daily_rate × 30.4, BUT modifying the daily budget
  // mid-month reprorates the ceiling around the change date, so it can't be
  // recomputed from the current rate alone. When change_event shows a mid-month
  // budget change this holds the segment-summed ceiling; otherwise it's just
  // current daily × 30.4. Null until first sync / for total-budget campaigns.
  googleProratedCeiling        String?
  // Google allocator flight override (spec §6). Flight dates AUTO-DERIVE from
  // the campaign's own googleStartDate/googleEndDate intersected with the month;
  // these two exist for the case the API can't express — the campaign existed on
  // the 1st but wasn't FUNDED until mid-month, or the desk is pacing a custom
  // window. Deliberately separate from flightStart/flightEnd (the planner's
  // intent, which the Ad Planner owns) so a pacing override never rewrites the
  // plan. YYYY-MM-DD; always re-clamped to the month in view, so a stale
  // override from another month clamps away instead of corrupting the window.
  googleFlightStartOverride    String?
  googleFlightEndOverride      String?
  // Google allocator lock (spec §4): a fixed carve-out, protected from Balance
  // and from Move as either source or destination. Locking changes NO numbers —
  // it only sets this flag — and never creates an unallocated gap on its own.
  // It does not exempt the line from a budget push: the rate it needs is still
  // the rate it needs.
  pacerLocked                  Boolean   @default(false)
  // Reserved (delivery/reallocation spec §12): budget set aside for a campaign
  // that CANNOT spend yet — committed, but not built or not linked to Google.
  //
  // In allocation, out of pacing. The target still counts toward the account
  // allocation total and the payable check, so the reserve stays visible and
  // protected and can never be mistaken for free budget; but the line is removed
  // from Expected MTD, account pace, the recommended daily, the account daily
  // total, Balance, Move, the push, the pacing alert scanners and month-end
  // variance. Leaving it in is what made a whole account read 74% of expected
  // and demand $397/day when the honest figures were ~86% and ~$320.
  //
  // MANUAL, never inferred. Auto-detecting from "no linked daily" would
  // eventually fire on a merely-paused live campaign, and a tool that silently
  // drops a campaign out of pacing is worse than one that shows a wrong number.
  // Distinct from pacerLocked: locked = live but don't reallocate; reserved =
  // cannot spend yet. Different badges, different meanings, never merged.
  pacerReserved                Boolean   @default(false)
  // Free-text labels as a JSON array of strings, e.g. ["Summer Sales Event"].
  // A view/tracking dimension only, INDEPENDENT of budgetSource (base/added):
  // tagging a base-funded campaign into an event must not move money between
  // pools. Shared with Meta — the label/filter bar is cross-platform even though
  // the allocator is Google-only.
  pacerTags                    String?
  // Per-ad alert mute (Change 9): when true, the pacing-family scanners
  // (underspend/overpace, went-dark, flight-ending) skip this ad so a
  // known-acceptable case stops pinging. Workflow alerts are unaffected.
  alertsMuted                  Boolean   @default(false)

  // Other
  creativeLink   String?
  clientName     String?
  digitalDetails String? // long-form notes from the rep about the ad goal/plan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designNotes MetaAdsPacerDesignNote[]
  activityLog MetaAdsPacerActivityLog[]

  @@index([planId, period, position])
  @@index([planId, position])
  @@index([adStatus])
  @@index([designerUserId])
  @@index([ownerUserId])
}

model MetaAdsPacerDesignNote {
  id           String         @id @default(cuid())
  adId         String
  ad           MetaAdsPacerAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  text         String
  authorUserId String?
  author       User?          @relation("MetaPacerDesignNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([adId, createdAt])
}

model MetaAdsPacerActivityLog {
  id                 String         @id @default(cuid())
  adId               String
  ad                 MetaAdsPacerAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  text               String
  attachmentKey      String? // S3 key when an attachment was uploaded
  attachmentFilename String?
  attachmentMimeType String?
  attachmentSize     Int?
  authorUserId       String?
  author             User?          @relation("MetaPacerActivityAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())

  @@index([adId, createdAt])
}

// Account-level chat log for the Meta Ads Pacer. Distinct from the
// per-ad DesignNote / ActivityLog — these notes live on the account
// itself so reps can capture context that applies to the whole pacing
// view (variance explanations, client conversations, etc).
model MetaAdsPacerAccountNote {
  id           String   @id @default(cuid())
  accountKey   String
  account      Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  // Month (YYYY-MM) the comment was written in — comments are scoped to their
  // month, so May notes only show in May and June starts a fresh log. Nullable
  // for pre-existing account-wide notes (which won't surface in a month view).
  period       String?
  // null = Meta (legacy); "google" = Google. Keeps each platform's account
  // notes separate even though they share the account + period.
  platform     String?
  text         String
  authorUserId String?
  author       User?    @relation("MetaPacerAccountNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([accountKey, period, createdAt])
}

// Budget log — point-in-time snapshot of the pacer's spend + client
// budget numbers, captured by reps as a record of when they checked or
// adjusted budgets during the month. Scoped per-account + per-period
// (YYYY-MM) so each month's checks live as their own thread.
model MetaAdsPacerBudgetLog {
  id           String   @id @default(cuid())
  accountKey   String
  account      Account  @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  period       String // YYYY-MM
  // null = Meta (legacy); "google" = Google.
  platform     String?
  // JSON-encoded AdSnapshot[] — per-ad numbers matching the Summary tab
  // columns (budgetType, budget, projected, actual, target, recDaily).
  // See BudgetLogDrawer for the exact shape.
  adsSnapshot  String   @default("[]")
  // Optional free-text context — "rebalanced after client call", etc.
  note         String?
  authorUserId String?
  author       User?    @relation("MetaPacerBudgetLogAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([accountKey, period, createdAt])
}

// ─────────────────────────────────────────────────────
// Notifications (in-app + email)
// ─────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ad_due_soon | ad_overdue | approval_pending | status_stuck | pacing_alert | period_over_allocated | ad_assigned | approval_changed
  severity  String    @default("info") // info | warning | critical
  title     String
  body      String?
  link      String? // optional in-app link (e.g. /tools/meta-ads-pacer?adId=…)
  metaJson  String? // optional JSON payload for the originating event (adId, accountKey, etc)
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  /// In-app: show this kind in the bell panel.
  enabled      Boolean  @default(true)
  /// Email: also send it to the user's inbox. Independent of `enabled` — a
  /// user can keep the panel entry and mute the email, or vice versa.
  /// Backfilled from `enabled` for rows that predate the split, so nobody
  /// started receiving mail they had previously switched off.
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// One row per user holding every Appearance-tab choice, so a preference set on
// one machine follows the person to the next. The cookie + localStorage written
// by the theme context stay the fast path (they apply before React mounts, so
// there's no flash); this row is the durable copy that reconciles on load.
// Values are validated against the catalogs in `src/lib/appearance/presets.ts` —
// stored as plain strings so adding a preset is a code change, not a migration.
model UserAppearancePreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'dark' | 'light' | 'system' — 'system' follows prefers-color-scheme.
  theme              String   @default("system")
  // A Tailwind hue key, or 'custom' — in which case `accentCustom` is used.
  accent             String   @default("indigo")
  // Hex for the custom accent. Retained while a preset is selected so switching
  // back to Custom restores the last color the user mixed.
  accentCustom       String   @default("#6366f1")
  fontFamily         String   @default("system")
  density            String   @default("comfortable")
  reduceTransparency Boolean  @default(false)
  reduceMotion       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Alert rules (§9) — config-driven monitoring engine
// ─────────────────────────────────────────────────────

// One row per alert definition, so thresholds tune without a redeploy. Every
// rule is the same shape: a metric, a baseline, a fire condition, a tier. The
// engine (src/lib/alerts) reads enabled rows and fires Notifications, reusing
// their dedupe window for cooldown. Google-channel rules (channel='google',
// phase 1/2) drop in as rows once the Google Ads API is connected (§8).
model AlertRule {
  id             String   @id @default(cuid())
  key            String   @unique // stable slug for seeding/idempotency, e.g. "meta-account-pace"
  name           String
  description    String?
  channel        String   @default("meta") // meta | google
  metric         String // e.g. account_monthly_pace | campaign_budget_burn | metrics.ctr
  resource       String // account | campaign | keyword_view | asset_group | asset_group_asset
  // FIXED | ROLLING_AVG_DEVIATION | PERIOD_OVER_PERIOD | CONSECUTIVE_DURATION
  baselineType   String
  baselineParams String   @default("{}") // JSON, e.g. {"window":30,"deviationPct":25}
  fireCondition  String   @default("{}") // JSON, e.g. {"comparator":"outside","low":85,"high":110}
  tier           String   @default("FYI") // URGENT | FYI
  minVolumeGate  Float? // skip below this data volume (e.g. min monthly spend target $)
  cooldownHours  Int      @default(20) // suppress re-fire while still true / within N hours
  phase          Int      @default(1) // 1 = ships now | 2 = Merchant Center (deferred)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
  @@index([channel, enabled])
}

// ─────────────────────────────────────────────────────
// App Settings (singleton key/value store)
// ─────────────────────────────────────────────────────

// Small key/value store for app-level singletons that used to live as files
// on the release filesystem (and were silently lost on every deploy — see
// the local-disk data-loss fix). First tenant: the "loomi-knowledge" key,
// holding the AI knowledge-base markdown formerly at loomi-knowledge.md.
// `value` is plain text (markdown/JSON/etc.); callers own the encoding.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Ad Generator — disclaimer templates
// ─────────────────────────────────────────────────────
//
// Reusable legal/disclaimer text for the Ad Generator. The body holds
// {slug} tokens (e.g. "{apr_rate}% APR for {apr_term} months…") that are
// substituted from the offer's STRUCTURED fields at compose time — so the
// legal text stays rule-based and deterministic (never AI-written).
//
// Port of Oz Dealer Tools' DisclaimerTemplateModel: keyed by (make,
// offerType). `make` null = a global fallback used when no make-specific
// template exists; `isDefault` marks the auto-selected template for its
// (make, offerType) pair. Global (no accountKey) for v1 — OEM disclaimers
// are brand-wide; a per-account override can come later.
model AdDisclaimerTemplate {
  id        String   @id @default(cuid())
  make      String? // vehicle make (e.g. "Toyota"); null = global fallback
  offerType String // lease | apr | discount | sales_price | custom
  name      String
  body      String   @db.Text // template text with {slug} tokens
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offerType, make, isActive])
}

// ─────────────────────────────────────────────────────
// Ad Generator — OEM offer compliance rules
// ─────────────────────────────────────────────────────
//
// Per-make required-field rules for the Ad Generator: which offer fields
// MUST be filled before an ad can be exported, per offer type. Port of Oz
// Dealer Tools' OemOfferRuleModel (a make-keyed required_fields map). The
// generator unions these with the code-defined baseline (the numbers an
// offer intrinsically needs) and blocks export while any are empty.
//
// `requiredFields` is a JSON object keyed by offer type → array of field
// keys, e.g. {"apr":["vin","aprTerm","financialInstitution"],"lease":["vin","leaseTerm"]}.
// Field keys match the template's FieldSpec keys (camelCase). Global
// (no accountKey) — OEM rules are brand-wide.
model AdOemOfferRule {
  id             String @id @default(cuid())
  make           String @unique // vehicle make / OEM (case-insensitive lookup)
  requiredFields String @db.Text // JSON: { [offerType]: string[] }

  /// Standing values for fields the offer feed doesn't carry, as JSON
  /// { [offerType]: { [field]: value } }.
  ///
  /// Some required disclosures are properties of the PROGRAMME rather than the
  /// individual offer, so MarketCheck never sends them and nothing can derive them.
  /// Subaru §6x is the clearest case: an ad must state whether a security deposit
  /// is required, and "none required" satisfies it — a standing fact a human can
  /// assert once. Without somewhere to put that, every Subaru lease ad fails
  /// preflight on a missing field and is silently skipped.
  ///
  /// These are ASSERTIONS, not derivations. A draft built using one records that
  /// in its review notes, so an approver can see the value came from this table and
  /// not from the manufacturer's offer.
  defaultValues String? @db.Text

  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Ad Generator — data-driven templates (visual builder)
// ─────────────────────────────────────────────────────
//
// A TemplateDoc authored in the visual Template Builder, stored as JSON. The
// generator renders PUBLISHED docs with the same `renderDoc` used on the
// builder canvas, so what a designer builds is exactly what users fill +
// export. Additive; reaches an environment via `db push` on deploy, and is
// queried resiliently (falls back to code-defined templates when unmigrated).
model AdTemplateDoc {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  doc               String   @db.Text // JSON-serialized TemplateDoc (fields + elements + per-size layouts)
  status            String   @default("draft") // draft | published
  isActive          Boolean  @default(true)
  // null = global (offered to every account the industry filter allows);
  // set = only that account sees it in the picker (dealer-branded plates etc.).
  accountKey        String?
  // Subaccounts this template is SHARED with, as a JSON string[] (same model as
  // AdBlock.accountKeys). Access = owner ∪ shared, so a non-empty list also
  // narrows an otherwise-global template to just the accounts named in it. Null /
  // [] leaves scoping entirely to `accountKey`, which is every row written before
  // sharing existed — so nothing changes for them.
  sharedAccountKeys String?  @db.Text
  // Org-owned template (author-once): account-less, tagged to an organization
  // so every sub-account in that org inherits it in the generator picker.
  // Shared template taxonomy (same Category + Tags model email uses): a single
  // category string + a JSON string[] of tag names. Designers assign them so the
  // library filters consistently across every template kind.
  category          String?
  tags              String?  @db.Text // JSON string[] of tag names
  createdBy         String? // user id / email who last saved it
  // Last-saver display info (for the template card author, like email cards).
  createdByName     String?
  createdByEmail    String?
  createdByImage    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, isActive])
  @@index([accountKey])
}

// A reusable "block": a saved cluster of builder elements (e.g. a Lease/APR
// offer block) a designer inserts from the Insert panel instead of rebuilding
// it. `doc` is a lightweight JSON payload (elements + normalized boxes + the
// fields those bindings need), NOT a full TemplateDoc. Scoped like templates:
// null accountKey = global, set = only that subaccount sees it.
model AdBlock {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  doc            String   @db.Text // JSON: { version, sourceSize, elements, boxes, requiredFields, requiredDefaults, offerKit }
  isActive       Boolean  @default(true)
  // Scoping: global = both null/empty. `accountKeys` (JSON string[]) is the
  // current model — a block can be assigned to several subaccounts. `accountKey`
  // (single) is kept for back-compat with blocks saved before multi-select.
  accountKey     String? // legacy single-account scope; null = global
  accountKeys    String?  @db.Text // JSON string[] of subaccount keys; null/[] = global
  category       String?
  tags           String?  @db.Text // JSON string[] of tag names
  createdBy      String?
  createdByName  String?
  createdByEmail String?
  createdByImage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, accountKey])
  @@index([accountKey])
}

// ─────────────────────────────────────────────────────
// Ad Generator — ad size library
// ─────────────────────────────────────────────────────
//
// A shared (global) library of named ad sizes — Square 1080, Story 1080×1920,
// etc. THE size list: every picker in the Ad Generator reads it, and there is no
// second, code-owned set of "app default" sizes sitting beside it. The built-in
// starters are seeded into this table on first use (see `builtinKey`), so a
// starter and a team-added size are the same kind of row — equally editable,
// taggable, and removable.
//
// Each row records who created it (name / email / avatar snapshot) + when, so
// the library shows provenance. Additive; reaches an environment via db push on
// deploy, queried resiliently.
model AdSizePreset {
  id             String   @id @default(cuid())
  name           String
  width          Int
  height         Int
  // What the size is USED FOR — JSON string[] of free-form tags ("Facebook",
  // "Display", "Email"). Replaces the old fixed social/display/email grouping:
  // one size is often used for several things, and every team's list differs.
  tags           String?  @db.Text
  // Set only on rows seeded from the built-in starter set, so seeding can run
  // once per environment without duplicating. NOT a "system size" marker — a
  // seeded row is editable and deletable like any other; this only keeps the
  // seeder from re-adding one that already exists.
  builtinKey     String?  @unique
  createdById    String?
  createdByName  String?
  createdByEmail String?
  createdByImage String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Ad Generator — saved ad creatives
// ─────────────────────────────────────────────────────
//
// A created ad: a chosen template (code id OR AdTemplateDoc id) + the filled-in
// field values. Account-scoped — the /ad-generator list shows the active
// account's ads; clicking one opens the generator to edit it. `campaignId` is
// reserved for the future Campaign-channel tie-in (not wired yet). Additive,
// queried resiliently.
model AdCreative {
  id            String   @id @default(cuid())
  accountKey    String
  name          String
  templateId    String // code template id or AdTemplateDoc id (the source)
  // Frozen copy of the template's design at creation (JSON TemplateDoc). The ad
  // renders from THIS, so later edits to the master template don't change it —
  // each ad is an independent, subaccount-owned copy. Null for older ads /
  // code-render templates, which fall back to resolving templateId live.
  doc           String?  @db.Text
  data          String   @db.Text // JSON of the filled AdData
  status        String   @default("draft") // draft | ready
  thumbnailUrl  String?  @db.Text
  campaignId    String? // reserved — future Campaign channel link
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Phase 3: autonomous generation provenance ──
  // Set on ads produced by the automation rather than by a person. A reviewer
  // needs to know an ad was machine-made, and by WHICH run, before approving it.
  autoGenerated      Boolean   @default(false)
  runId              String? // the AdAutomationRun that produced it
  // Fingerprint of the OEM offer this ad advertises. Combined with the unique
  // index below this is what makes the generate job safe to re-run: the same
  // offer through the same template UPDATES this row instead of creating a
  // second draft. Only sound because template resolution is deterministic — a
  // random or rotating template choice would pick a different templateId on
  // retry and defeat the constraint entirely.
  offerFingerprint   String?
  // When the underlying offer expires, so a sweep can flag ads that have gone
  // stale rather than leaving a dead payment live.
  expiresAt          DateTime?
  // Which co-op pack version was evaluated, or null when none was on file.
  // Null on an auto-generated ad is meaningful: it says "no manufacturer rules
  // were checked", which a reviewer must be able to see.
  coopCheckedVersion String?
  // Preflight/co-op findings that did NOT block (warnings), so the reviewer sees
  // what was flagged rather than having to re-run preflight to find out.
  reviewNotes        String?   @db.Text

  // Soft delete. Deliberately a TIMESTAMP rather than a `status` value: status
  // carries draft/ready, and folding archive into it would lose which of the two
  // an ad was when it was put away — so restoring would have to guess.
  archivedAt DateTime?

  // ── Launch copy ──
  //
  // AdCopyVariation JSON (meta + google captions), written ONCE at generation and
  // frozen. Frozen because two launches of one ad must not say different things —
  // and safe to freeze because an offer whose numbers move gets a different
  // fingerprint, so a row's copy can never outlive the offer it describes.
  //
  // `copySource` records whether the words were drafted by AI (and passed the
  // numeric-provenance + co-op checks) or assembled deterministically from the
  // offer. A reviewer has to be able to tell which, without re-deriving it.
  copy       String? @db.Text
  copySource String? // "ai" | "deterministic"

  // ── Template link (design sync) ──
  //
  // Whether this ad still FOLLOWS its source template's design. "synced" means a
  // template edit may be pushed into it; "detached" means the ad owns its design
  // and nothing may overwrite it. Copy-on-use stays the default for hand-built
  // ads — the link exists for the automated ones, where the template is the only
  // place a person can fix fifty ads at once.
  //
  // NULL is meaningful and is why this needs no backfill: it means "never set",
  // read as synced for an auto-generated ad and detached for a hand-built one —
  // exactly what each already did. See resolveSyncState in template-sync.ts.
  templateSync    String?
  // Design hash (see designHash) of the template revision this ad's `doc` came
  // from. Compared against the template's current hash to answer "is this ad
  // behind?" without diffing two large JSON blobs — and it's a hash of the
  // RENDER-relevant doc only, so renaming or retagging a template doesn't make
  // every ad look stale.
  templateDocHash String?
  // Set the first time a person edits THIS ad's own design. Records that the
  // divergence was deliberate, so "Customized" can be shown with a date rather
  // than as a bare state, and so a reset can say what it is discarding.
  docEditedAt     DateTime?

  // One draft per (sub-account, template, offer). Null fingerprints are exempt
  // in Postgres — hand-built ads all have null here and never collide.
  @@unique([accountKey, templateId, offerFingerprint])
  @@index([accountKey, updatedAt])
  @@index([accountKey, autoGenerated, status])
  @@index([accountKey, archivedAt])
  @@index([runId])
  // "Which ads use this template?" — the impact query behind the sync prompt,
  // which is the one lookup here that isn't account-scoped.
  @@index([templateId])
}

// ─────────────────────────────────────────────────────
// Ad Generator — manufacturer co-op advertising rules (Phase 2)
// ─────────────────────────────────────────────────────
//
// A per-make pack of machine-checkable co-op advertising rules, evaluated by
// preflight alongside the field-level `AdOemOfferRule`. That model answers
// "which fields must be filled"; this one answers "is the ad PERMITTED" —
// minimum disclaimer legibility, required credit language, banned absolute
// claims, logo placement. Exactly the rules a designer applies from memory, and
// which nobody applies once generation is unattended.
//
// Every rule carries a citation back to the source guideline, because a
// compliance check that can't be audited won't be trusted and will get switched
// off. Rules are NEVER invented — a pack is transcribed from the manufacturer's
// actual document, and `verified` stays false until a human has checked it
// against that document (unverified packs report but cannot block).
//
// Packs are VERSIONED and date-scoped rather than overwritten: co-op guidelines
// are reissued periodically, and an ad approved last quarter has to stay
// explicable against the rules that were in force when it ran.
model AdCoopRulePack {
  id      String @id @default(cuid())
  make    String
  // Guideline edition this pack transcribes, e.g. "2026-Q3".
  version String

  // JSON CoopRulePack — the rules array plus its own make/version/source.
  rules  String  @db.Text
  // The document these rules came from, e.g. "Chevrolet 2026 Co-op Guidelines".
  source String?
  notes  String? @db.Text

  /// MediaAsset id of the guideline PDF these rules were transcribed from, so a
  /// citation like "§4.2 p.11" can actually be opened and checked. A citation
  /// whose source document isn't reachable can't be audited, which defeats the
  /// point of citing it.
  sourceAssetId String?
  /// Public URL of that document, denormalised so the page can link it without a
  /// media lookup per row.
  sourceUrl     String? @db.Text

  // False until a human has checked the transcription against the source. An
  // unverified pack still evaluates, but every finding is downgraded to a
  // warning so a half-finished transcription can't block a brand's whole month.
  verified   Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  isActive      Boolean   @default(true)
  // Inclusive effective window (ISO dates). Null start = always been in force;
  // null end = still in force. Lets a superseded pack stay queryable.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([make, version])
  @@index([make, isActive])
}

// ─────────────────────────────────────────────────────
// Ad Generator — guideline document register
// ─────────────────────────────────────────────────────
//
// The manufacturer's co-op guideline document itself, tracked by CONTENT HASH.
//
// This exists because the expensive question isn't "what are the rules" — it's
// "have the rules changed since anyone last looked". Transcribing a document into
// machine-checkable rules is slow and error-prone (an early Mazda §5d transcription
// was wrong in a way that would have failed a perfectly compliant logo lockup), and
// it only pays off for the few rules a generator can actually violate. Detecting
// that a document CHANGED, by contrast, is cheap and exact.
//
// So: register the document, hash it, and remember the hash a human last reviewed.
// When the two differ, say so and let a person decide what it means. That is the
// whole mechanism — deliberately not an extraction pipeline.
model AdGuidelineDoc {
  id    String @id @default(cuid())
  make  String
  title String // "Subaru SAF Guidelines", "GM iMR Program Guidelines"

  /// Where the document lives. A http(s) URL is re-fetched and re-hashed on a
  /// schedule; a MediaAsset upload is hashed once when it is registered.
  sourceUrl     String? @db.Text
  sourceAssetId String?

  /// sha256 of the document bytes as last seen. Null until first fetched.
  contentHash String?
  byteSize    Int?
  pageCount   Int?

  /// Page 1 rendered to a small webp, stored as a `data:` URI — the cover thumbnail
  /// on the guidelines page. A data URI rather than an S3 object deliberately:
  /// these are ~5-35 KB, and S3 isn't configured in every environment, so an
  /// S3-backed preview would be one that only appears in production.
  previewImage String? @db.Text

  /// Per-page plain text as a JSON string[], so the in-app reader can search the
  /// document. Extracted in the same pdf.js pass that renders the cover — it costs
  /// ~250ms for 60 pages and ~160-230 KB of text, which is cheap enough to store
  /// rather than re-derive on every search.
  pageText String? @db.Text

  /// Section headings as a JSON {page,title}[], from the PDF's own outline where it
  /// has one and a heading pattern otherwise. Lets a search result say which
  /// section it's in rather than only which page.
  sections String? @db.Text

  /// VERSION HISTORY, not a review gate. An earlier design made a human attest
  /// "I reviewed this" before the register would go quiet, which turned out to be
  /// ceremony nobody wanted: what's actually useful is "this document was replaced
  /// on this date, and here's the hash it replaced". Detection and notification are
  /// unchanged — only the attestation button is gone.
  previousHash String?
  replacedAt   DateTime?

  /// Free-text note about the document, e.g. that it's a claim-status reference
  /// rather than advertising rules. Carried on the row so the caveat travels with
  /// the document instead of living only in an import script.
  notes String? @db.Text

  /// Last fetch attempt. A non-null `checkError` means the document is unreachable,
  /// which has to read differently from "we have it" — a 404 is not reassurance.
  checkedAt  DateTime?
  checkError String?   @db.Text

  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([make, title])
  @@index([make, isActive])
}

// ─────────────────────────────────────────────────────
// Ad Generator — one publish attempt
// ─────────────────────────────────────────────────────
//
// Written BEFORE the first platform call, so a retry finds the in-flight row
// instead of creating a second ad that spends a second budget. Same lesson as the
// rest of the pipeline: any table fronting a side effect needs the row to exist
// before the effect.
//
// A row exists for every attempt INCLUDING failures, because a launch that
// silently didn't happen is the failure mode that matters — and because a failed
// row is what a retry needs to find.
//
// TWO DEFECTS IN THE ORIGINAL SPEC, FIXED HERE:
//
// 1. It keyed on the bare `offerFingerprint`, which reproduces the Silverado
//    collision: one GM 4.9%/60mo programme covers the 2500HD and the 3500HD, so
//    the same fingerprint means the second vehicle's launch would look like a
//    duplicate of the first's. `offerKey` is the VEHICLE-scoped value
//    (creativeOfferKey) for that reason.
// 2. Uniqueness must not cover terminal failures, or a failed launch permanently
//    blocks its own retry. Postgres can express that as a partial unique index
//    and Prisma cannot, so it lives in scripts/ensure-adlaunch-unique.ts —
//    exactly why ensure-adcreative-offer-unique.ts exists. There is deliberately
//    NO @@unique here; the script owns it.
model AdLaunch {
  id         String @id @default(cuid())
  accountKey String
  platform   String // "meta" | "google"

  /// attach_existing | create_new — which verb produced this launch.
  mode String @default("attach_existing")

  /// JSON string[] of AdCreative ids. One launch is one campaign with one ad per
  /// creative, so this is plural while platformCampaignId is singular.
  creativeIds String  @db.Text
  /// Vehicle-scoped offer key (see creativeOfferKey), NOT the bare fingerprint.
  offerKey    String?

  /// queued | publishing | published | failed | cancelled
  status String @default("queued")

  /// Frozen resolved preset + copy + creative URLs at launch time, so "what did we
  /// actually publish" survives later preset edits.
  payload String? @db.Text

  /// Platform result, filled in as each object is created so a partial failure is
  /// diagnosable rather than opaque.
  platformCampaignId String?
  platformAdSetId    String?
  /// JSON map of creativeId → platform ad id. A map, not a scalar: there is
  /// genuinely one ad object per creative.
  platformAdIds      String? @db.Text
  /// JSON — Meta adimages hashes / Google asset resource names.
  platformImageRefs  String? @db.Text

  /// The pacer row created by the back-link, for round-tripping.
  pacerAdId String?

  requestedById   String?
  requestedByName String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  error           String?   @db.Text

  /// Whether the published ad is currently spending, and who last flipped it.
  /// Separate from `status` — `status` is about whether the PUBLISH succeeded, this
  /// is about whether the result is live. Attribution matters here more than
  /// anywhere else in the pipeline: this is the field that answers "who started
  /// spending money", which a Graph audit log nobody can reach does not.
  liveStatus    String? // "ACTIVE" | "PAUSED"
  liveChangedAt DateTime?
  liveChangedBy String?

  @@index([accountKey, status])
  @@index([offerKey])
}

// ─────────────────────────────────────────────────────
// Ad Generator — per-account campaign shape for a launch
// ─────────────────────────────────────────────────────
//
// A creative implies nothing about objective, geo, bid strategy, budget, flight or
// destination. Without a saved shape a "launch" is a twelve-field form, and nobody
// fills that in twice — so the preset is what makes launching one click.
//
// One row per (account, platform): a rooftop's Meta launches all look alike, and
// the variation that matters — the offer — comes from the creative.
//
// NOTE what is deliberately NOT here: `specialAdCategories`. Meta's
// FINANCIAL_PRODUCTS_SERVICES category is not a preference, it is a consequence of
// what the ad says, so it is DERIVED per launch from the offer and its text (see
// specialAdCategoriesFor in launch-preset.ts). Storing it as a settable field
// would let someone turn off a restriction that Meta applies regardless — and
// then be rejected at publish, or worse, not be.
model AdLaunchPreset {
  id         String @id @default(cuid())
  accountKey String
  platform   String // "meta" | "google"

  /// e.g. OUTCOME_TRAFFIC, OUTCOME_LEADS.
  /// attach_existing | create_new.
  ///
  /// Per sub-account because rooftops genuinely differ: some run evergreen
  /// campaigns whose creative gets refreshed monthly, others spin up a campaign
  /// per offer push. Attaching to a proven ad set avoids a learning-phase reset
  /// and budget fragmentation, so it's the better default where it applies.
  launchMode      String  @default("attach_existing")
  /// For attach_existing: the ad set new creative is added to. Discovered via
  /// fetchAdSets and confirmed by a person — the same reasoning as metaPageId, since
  /// attaching to the wrong ad set spends someone else's budget on this offer.
  targetAdSetId   String?
  targetAdSetName String?

  objective   String  @default("OUTCOME_TRAFFIC")
  bidStrategy String?
  /// Whole currency units as a string, matching MetaAdsPacerAd.allocation.
  dailyBudget String?
  flightDays  Int     @default(30)

  geoZip         String?
  /// Miles. FLOORED AT 15 at resolve time when a financial-products category
  /// applies — Meta enforces that minimum and rejects tighter targeting.
  geoRadiusMiles Int     @default(25)
  audienceSpec   String? @db.Text // JSON — saved audiences / interests

  /// dealer_site | loomi_lp | loomi_lp_inventory. Only dealer_site is implemented;
  /// the Loomi-hosted destination is Phase D.
  destinationMode String  @default("dealer_site")
  /// For dealer_site. Supports {{year}} {{make}} {{model}} {{vin}} so one preset
  /// covers every nameplate without a row per model.
  urlTemplate     String? @db.Text
  lpTemplateId    String?
  lpFormId        String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// JSON string[] of size ids to publish. Null/empty = every size the ad has.
  sizeIds String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountKey, platform])
}

// ─────────────────────────────────────────────────────
// Ad Generator — co-op PRE-APPROVAL of a template (human sign-off)
// ─────────────────────────────────────────────────────
//
// Distinct from AdTemplateCoopCheck below, which is what the RULE ENGINE thinks.
// This is what the manufacturer's co-op programme actually said — a person sent
// the plate to the OEM, the OEM approved it, and every ad generated from it
// inherits that approval. It is what makes unattended launching defensible with
// no per-ad reviewer: the artifact a human approved is the template, and the ads
// are that template with the month's numbers in it.
//
// The two can disagree in both directions, and both directions are legitimate:
// the engine may have no rules on file for a make yet still have a real approval
// from it, and the engine may flag a rule the OEM chose to waive.
//
// SCOPED TO A DESIGN, NOT A TEMPLATE ID. `docHash` is the render-relevant design
// hash (see designHash in template-sync.ts), so editing the template moves the
// hash and the approval stops applying. Without that, "pre-approved" would be a
// permanent rubber stamp that survives an arbitrary redesign — which is precisely
// the exposure co-op approval is supposed to remove.
//
// APPEND-ONLY. Re-approving after a redesign adds a row; withdrawing sets
// `revokedAt` rather than deleting, because "approved, then withdrawn" is a
// different fact from "never approved", and a reimbursement dispute is exactly
// when somebody has to produce the history. No unique index, deliberately — it
// keeps this additive through `db push` with no ensure-script.
model AdTemplateCoopApproval {
  id         String @id @default(cuid())
  templateId String
  /// The make whose programme granted it. A shared plate can be approved by
  /// several manufacturers independently, so this is per (template, make).
  make       String

  /// The design the approval covers. Mismatch ⇒ the approval no longer applies.
  docHash String

  /// Guideline edition in force when it was granted. A reissue makes the approval
  /// STALE rather than wrong — someone re-confirms against the new edition.
  packVersion String?

  /// Evidence: the co-op portal case number, or the email that granted it.
  reference String?
  note      String? @db.Text

  approvedById   String?
  approvedByName String?
  approvedAt     DateTime @default(now())

  revokedAt     DateTime?
  revokedByName String?

  @@index([templateId])
  @@index([make])
}

// ─────────────────────────────────────────────────────
// Ad Generator — design-time co-op verdict per template
// ─────────────────────────────────────────────────────
//
// A template's standing against one make's rule pack, computed ONCE instead of on
// every generated ad.
//
// Most co-op rules constrain the LAYOUT — the brandmark must be present, the
// disclaimer no smaller than X, the logo inside the lower third. A layout changes
// when a designer changes it, perhaps twice a year, so re-deriving the same verdict
// for all eight drafts of a morning run answers a question that cannot have changed
// since the last answer. Worse, it puts a per-ad blocking gate in front of a fault
// that is never per-ad: a template-level mistake then surfaces as "no ads
// generated" rather than "this template needs fixing".
//
// Rules about CONTENT (banned or required phrases) genuinely do vary per ad, since
// the disclaimer is resolved from the OEM's own verbatim text per offer. Those are
// NOT stored here — they stay in preflight. See RULE_SCOPE in coop-rules.ts.
model AdTemplateCoopCheck {
  id         String @id @default(cuid())
  templateId String
  make       String

  packId      String
  packVersion String

  /// sha256 of the template doc as checked. Together with packId this is the
  /// staleness test: either the design moved or the rules did, so re-check.
  docHash String

  ok           Boolean
  errorCount   Int     @default(0)
  warningCount Int     @default(0)
  /// JSON of findings, each tagged with the offer type it was observed under, so a
  /// designer can see "fails only for lease" without re-running anything.
  findings     String  @db.Text

  /// Null when computed automatically during a run; set when a person re-ran it.
  checkedBy String?
  checkedAt DateTime @default(now())

  @@unique([templateId, packId])
  @@index([make])
}

// ─────────────────────────────────────────────────────
// Ad Generator — OEM sales-event assets
// ─────────────────────────────────────────────────────
//
// A time-boxed manufacturer campaign mark — "Presidents Day Event", "Summer Drive
// Event" — which most OEMs REQUIRE on any ad running inside the event window. It
// is not the brandmark (that lives in the sub-account's co-branded lockup) and not
// a template design choice: it's a third asset, mandated by the manufacturer, that
// appears and then disappears on a schedule.
//
// That schedule is why this is a table and not a template element. An ad built on
// 20 February and an ad built on 20 March need different marks from the same
// template, so the asset has to be resolved per run against the run date rather
// than baked into a design or a config field.
//
// Managed by the co-op team alongside the guideline documents — they already own
// the relationship that produces these assets.
model AdOemEventAsset {
  id   String @id @default(cuid())
  make String
  name String // "Chevy Presidents Day Event"

  /// The event mark itself. Expected to be a transparent PNG so it composites
  /// over any template background.
  logoUrl String  @db.Text
  notes   String? @db.Text

  /// Inclusive window, evaluated against the ad's RUN date — not the date it was
  /// generated. Preparing next month's flight must pick next month's event.
  effectiveFrom DateTime
  effectiveTo   DateTime

  /// Most OEMs mandate the mark during the event; a few merely permit it. When
  /// true and a template has nowhere to put it, generation refuses rather than
  /// silently producing a non-claimable ad.
  required Boolean @default(true)

  /// Optional narrowing: JSON string[] of offer types this event applies to
  /// (e.g. only lease). Null/empty = every offer type.
  offerTypes String? @db.Text

  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolution is always "the active event for this make on this date".
  @@index([make, isActive, effectiveFrom, effectiveTo])
}

// ─────────────────────────────────────────────────────
// Ad Generator — autonomous generation (Phase 1: shadow mode)
// ─────────────────────────────────────────────────────
//
// Autonomous OEM-incentive ads. The trigger is NOT a monthly cron: it's a daily
// poll that fingerprints each offer and diffs against what was seen last time,
// so a brand-new regional programme is caught the morning it lands — mid-month
// changes included — while month-start publication falls out for free.
//
// Phase 1 writes these tables and NOTHING ELSE: no creatives, no renders. The
// point is to accumulate real offer history (how noisy is the feed? how far
// ahead does each OEM publish?) before anything generates unattended.
//
// Additive; reaches an environment via `db push` on deploy, and every read is
// wrapped so an unmigrated environment degrades instead of failing — the same
// convention the rest of the Ad Generator follows. Account-scoped by `accountKey`
// with no FK relation, matching AdCreative.

// Per-sub-account automation preferences. Set once, not touched monthly — the
// whole design goal is that a month requires no human action. Most of this can
// be derived (make from Account.oem, zip from Account.postalCode, watched models
// from what actually has offers + stock), so a row is refinement, not setup.
model AdAutomationConfig {
  id         String  @id @default(cuid())
  accountKey String  @unique
  enabled    Boolean @default(false)

  // ── watch scope ──
  // JSON string[]. null/empty makes = derive from the account's OEM(s).
  // Empty focusModels = AUTO: watch every model with offers or stock, so a
  // sub-account works with zero configuration.
  makes         String? @db.Text
  focusModels   String? @db.Text
  excludeModels String? @db.Text
  zip           String?
  radius        Int     @default(75)

  // ── selection policy ──
  // JSON string[] of offer types, best first. Types omitted are ineligible.
  offerTypePriority String @default("[\"lease\",\"apr\",\"cash\"]")
  maxAdsPerRun      Int    @default(10)
  // How the run window is derived — the month-boundary fix. At month end an OEM's
  // current programmes expire within days, so "does this offer have N days left"
  // is the wrong question and yielded zero ads in testing; "is it valid when the
  // ad RUNS" is the right one. current_month | next_month | rolling
  runWindowMode     String @default("next_month")
  rollingDays       Int    @default(30)
  // Reject an offer whose stock is below this. 0 = don't consider stock at all
  // (the Phase 1 default — inventory is observed, not enforced, until Phase 3).
  minStock          Int    @default(0)

  // ── template resolution ──
  // JSON { [offerType]: adTemplateDocId }. Usually one entry, because a template
  // using visibleWhen on offerType covers every type.
  /// Which of the template's sizes to render, as a JSON string[]. Empty or null =
  /// every size the template defines, which is the old behaviour and stays the
  /// default. A rooftop running only Meta feed placements shouldn't pay to render
  /// and store a story crop it never posts.
  sizeIds String?

  templateMap String? @db.Text

  /// The agency-wide Playbook this sub-account follows for its creative, or null
  /// for a hand-picked setup. A playbook PRESETS `templateMap`, `sizeIds` and
  /// `emailTemplateId` rather than replacing them: the columns above stay the
  /// single source of truth for what a run actually uses, so generation never
  /// has to resolve a playbook and nothing breaks if one is deleted.
  ///
  /// Drift is therefore DERIVED — compare those columns to the playbook's
  /// definition — rather than tracked in a `stepStates` column. That keeps the
  /// override state honest with no backfill and no second thing to keep in sync.
  playbookId String?
  playbook   Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  /// Generate an ad for EVERY qualifying offer type on a vehicle (a lease ad
  /// AND an APR ad), rather than only the best one.
  ///
  /// Off by default deliberately. On a 12-model lot, expansion produces ~30 ads
  /// against a `maxAdsPerRun` default of 10 — the cap would silently truncate to
  /// an arbitrary subset, which is worse than a smaller set somebody chose.
  /// Costs no extra MarketCheck calls either way: the offers are already on file.
  expandOfferTypes Boolean @default(false)

  // ── output ──
  mode          String  @default("draft") // draft | ready
  notifyUserIds String? @db.Text // JSON string[]

  // ── companion offer email ──
  //
  // One multi-offer email per RUN, not per offer: an OEM programme drop commonly
  // covers six models at once, and six separate sends to one dealer list is how
  // a database gets burned. The offers featured are exactly the ones that
  // produced ads, so the email can never advertise something the paid side
  // isn't running.
  //
  // Off by default — an existing sub-account keeps generating ads and nothing
  // else until someone opts in, because an email has no equivalent of a PAUSED
  // campaign to undo.
  emailEnabled    Boolean @default(false)
  /// `Template.slug` of a v2 email template used as the SHELL — its blocks wrap
  /// the generated offer section, which replaces a text block reading `{{offers}}`.
  /// Null = compose the whole email from the sub-account's branding.
  emailTemplateId String?
  /// `Audience` whose saved filter pre-targets the draft. Null leaves the draft
  /// with no recipients, so a person must choose before it can send.
  emailAudienceId String?
  /// Cap on how many offers the email features, best-first by the same
  /// `offerTypePriority` the ads use.
  emailMaxOffers  Int     @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An agency-wide, versioned bundle of the creative that goes together: the ad
/// template + sizes and the offer-email shell. See docs/playbooks.md.
///
/// This is Phase 1's `Playbook` arriving as ONE NARROW SLICE — scope 'creative'
/// only. The spec's wider flavours (department motion, season/event) and the
/// step registry are deliberately not built; `scope`/`scopeValue` exist so they
/// can be without a migration.
///
/// Authored once and applied to many sub-accounts, which is the entire point:
/// "are all our Chevy stores running the same creative?" has no answer while the
/// pairing lives only in each rooftop's own config.
model Playbook {
  id   String @id @default(cuid())
  /// Stable slug, like `AlertRule.key` — safe to reference from a seed or a doc.
  key  String @unique
  name String

  /// creative | oem | department | event. Only 'creative' is honored today.
  scope      String  @default("creative")
  /// e.g. "Chevrolet" for an OEM-scoped playbook. Null = applies anywhere.
  scopeValue String?

  /// Bumped on every published edit, so an application can be seen as behind.
  version Int @default(1)

  /// JSON: { adTemplateId, sizeIds[], emailTemplateSlug, emailMaxOffers }.
  /// Text + JSON rather than columns because the step list is meant to grow;
  /// see `src/lib/playbooks/creative.ts` for the parsed shape.
  definition     String @db.Text
  /// Hash of `definition`, the staleness test — same discipline as
  /// `AdTemplateCoopCheck.docHash`. Lets "this rooftop is on an older version"
  /// be a fact rather than a guess.
  definitionHash String

  /// Null = draft, never offered to a sub-account.
  publishedAt DateTime?

  createdByUserId String?
  /// Who last saved it. A playbook is platform configuration that reaches every
  /// rooftop following it, so "who changed this, and when" has to survive the
  /// change itself — `createdByUserId` alone answers neither.
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configs AdAutomationConfig[]

  @@index([scope, scopeValue])
  @@index([publishedAt])
}

// A check deliberately marked "not a question here".
//
// The audit infers which playbooks apply from observable account facts (see
// docs/playbooks.md §4.3), so it is wrong in both directions: a rooftop that
// deliberately doesn't run a channel still shows as missing it, and
// `budget.managed` is red almost everywhere on purpose. An audit nobody trusts
// is an audit nobody reads, and the fix people reach for — ignoring the reds —
// is the failure mode.
//
// So a waiver records the judgement instead of losing it. A waived check scores
// as `na`: excluded from coverage entirely, the same as a playbook that doesn't
// apply, because that is exactly what the person is asserting.
//
// `reason` is NOT NULL by design. A waiver with no reason is how a real red gets
// buried, and the next person to read the row has no way to tell a considered
// exemption from a shrug.
//
// This is deliberately NOT PlaybookApplication (§5 Phase 1). It records one
// account-and-check exemption, needs none of Phase 1's three open decisions, and
// is the kind of fact an explicit application would later absorb rather than
// contradict.
model PlaybookCheckWaiver {
  id         String @id @default(cuid())
  accountKey String
  /// Check id from the registry, e.g. `budget.managed`. Not a foreign key —
  /// checks are code constants, and a renamed check should leave a dangling
  /// waiver that reads as expired rather than blocking a deploy.
  checkId    String

  reason         String  @db.Text
  waivedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountKey, checkId])
  @@index([accountKey])
}

// One execution of the nightly coverage sweep.
//
// A row is written on EVERY run including a clean one, exactly like `IngestRun`
// and `AdAutomationRun`. Without heartbeat rows, "nothing drifted this week" and
// "the sweep has been dead for three weeks" render identically — and the second
// one is the state that actually costs money.
//
// `kind` is `sweep` today. Phase 1's apply/sync runs land here too (§5), which
// is why it is a column rather than implied by the table.
model PlaybookRun {
  id   String @id @default(cuid())
  kind String @default("sweep")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  accountsAudited Int @default(0)
  checksRun       Int @default(0)
  passCount       Int @default(0)
  warnCount       Int @default(0)
  failCount       Int @default(0)
  /// Failing checks whose severity is `blocking` — the triage number, tracked
  /// over time so a trend is visible without recomputing history.
  blockingFails   Int @default(0)
  /// Mean coverage across scored accounts, 0-100. Null when nothing scored.
  coveragePct     Int?

  /// JSON string[] of `accountKey:checkId` for every blocking failure this run.
  /// The next run diffs against it so an alert fires on what is NEW rather than
  /// re-reporting a backlog every morning until someone mutes it.
  blockingKeys String? @db.Text

  error String? @db.Text

  @@index([kind, startedAt])
  @@index([startedAt])
}

// One OEM offer as last seen by the poll, keyed by a fingerprint of its
// STRUCTURED fields. This table IS the change-detection state: "new offer" means
// "fingerprint not in here for this scope".
//
// The fingerprint deliberately excludes the feed's prose and its unstable `id` —
// MarketCheck rewords the same programme between refreshes, so hashing text
// would report a new offer on every poll.
//
// Rows are never deleted; a withdrawn offer gets `endedAt` set. Keeping the
// history is what lets us measure each OEM's publication lead time instead of
// guessing it.
model OemOfferSnapshot {
  id String @id @default(cuid())

  accountKey  String
  // accountKey|make|model|year|zip — the search that produced this offer. The
  // same programme surfaced for two models is two rows, because a dealer
  // advertises them separately.
  scopeKey    String
  fingerprint String

  make  String
  model String
  year  Int
  zip   String?

  offerType String
  // JSON of the normalized MarketCheckIncentive, so a later generate step needs
  // no re-fetch and a run log can show exactly what was on offer.
  payload   String  @db.Text
  // Normalized yyyy-mm-dd (the feed mixes ISO and US formats).
  endDate   String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  // Set when the offer stops appearing in the feed. Non-null = withdrawn.
  endedAt     DateTime?

  @@unique([scopeKey, fingerprint])
  @@index([accountKey, lastSeenAt])
  @@index([make, firstSeenAt])
}

// One execution of an automation job. Deliberately mirrors IngestRun: a row is
// written EVERY run including no-ops, because the failure mode that matters is a
// job that quietly stops. Without heartbeat rows, "no new ads this month" and
// "the poller has been dead for three weeks" look identical.
model AdAutomationRun {
  id String @id @default(cuid())

  // null = a global sweep across every enabled sub-account.
  accountKey String?
  kind       String // offer_poll | feed_sync

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  scopesChecked Int @default(0)
  offersSeen    Int @default(0)
  offersNew     Int @default(0)
  offersEnded   Int @default(0)
  vehiclesSeen  Int @default(0)
  issueCount    Int @default(0)

  // JSON: per-scope cycle states, feed issues, skip reasons — the audit trail
  // for "why did nothing generate?".
  detail String? @db.Text
  error  String? @db.Text

  @@index([accountKey, startedAt])
  @@index([kind, startedAt])
}

// A dealer inventory feed. The Young feeds are Vehicle Listing Ads exports —
// CSV in the Google/Meta VLA product schema, despite the .../feed/vla/... URL
// suggesting XML. `fieldMapping` carries a per-feed column-name override so a
// different provider is configuration rather than code: the variance between
// inventory vendors is almost entirely field naming.
model InventoryFeed {
  id           String  @id @default(cuid())
  accountKey   String
  name         String
  url          String  @db.Text
  format       String  @default("vla_csv")
  // The feed's own store identifier (VLA `store_code`, e.g. "MP15100"), used to
  // confirm a feed belongs to the sub-account it's attached to.
  storeCode    String?
  // JSON partial VlaFieldMapping. null = the default VLA schema.
  fieldMapping String? @db.Text
  isActive     Boolean @default(true)

  // ── freshness (a feed is a weaker contract than an API: it can go stale,
  // arrive truncated, or change shape without ever erroring) ──
  lastSyncedAt    DateTime?
  lastSyncStatus  String? // ok | error
  lastSyncMessage String?   @db.Text
  vehicleCount    Int       @default(0)
  newVehicleCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles InventoryVehicle[]

  @@unique([accountKey, url])
  @@index([accountKey, isActive])
}

// A normalized vehicle from a feed. Rows persist after they leave the feed
// (`soldAt` set) rather than being deleted, so a creative that advertised a
// specific VIN can still explain itself after the car sells.
//
// Note MSRP is present on ~100% of NEW rows and absent on used — which is fine,
// because OEM incentives are a new-vehicle programme.
model InventoryVehicle {
  id     String        @id @default(cuid())
  feedId String
  feed   InventoryFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  accountKey  String
  vin         String
  stockNumber String?

  year      Int
  make      String
  model     String
  trim      String?
  condition String // new | used | certified

  price       Int?
  msrp        Int?
  // The feed's short colour ("Jet Black") plus the fuller OEM marketing name
  // recovered from the description ("Jet Black Mica") where the dealer includes
  // it — the longer string matches EVOX's palette far better.
  color       String?
  colorDetail String?
  mileage     Int?
  bodyStyle   String?
  title       String?
  detailUrl   String? @db.Text
  // JSON string[]. Every new unit in the Young feeds carries real dealer photos,
  // which can stand in for an EVOX jellybean on a stock-specific ad — and covers
  // the models EVOX has no licensed imagery for.
  imageUrls   String? @db.Text

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  // Set when the VIN stops appearing in the feed — presumed sold or delisted.
  soldAt      DateTime?

  @@unique([feedId, vin])
  @@index([accountKey, condition])
  @@index([accountKey, make, model, year])
}

// ─────────────────────────────────────────────────────
// Projects — internal team project management (App surface)
// ─────────────────────────────────────────────────────
//
// A Monday/Asana-style work system for the agency's delivery teams.
// Account reps file tickets (Tasks) against an account, grouped into an
// Initiative (a body of work), and routed to a Team. Mirrors the proven
// MetaAdsPacerAd workflow primitives (assignee, status, activity log)
// generalized across every team, and reuses the existing Notification
// system for assignment/due/mention alerts. Internal-staff only in v1.

// Managed team/department list that tickets route to. Distinct from
// User.department (an HR label): a Team is the work-routing unit, a user
// can belong to several, and Tasks reference a team by `key`. Seeded with
// the agency's delivery teams; managed in Settings → Teams.
model Team {
  id          String    @id @default(cuid())
  key         String    @unique // stable slug, e.g. "digital-ads"
  name        String // "Digital Ads"
  description String?
  color       String? // hex chip color for boards (e.g. "#6366f1")
  icon        String? // optional lucide icon name (kebab-case); UI defaults to a 2-person glyph
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships TeamMembership[]
  tasks       Task[]

  @@index([sortOrder])
}

// Which users belong to which teams. A user can lead/serve several teams,
// independent of their HR User.department.
model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // member | lead
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

// A body of work for a single account (e.g. "New client onboarding",
// "Q3 Summer Sale launch"). Groups the Tasks the delivery teams work, and
// optionally links to a generated Campaign container (Phase 2).
model Initiative {
  id              String    @id @default(cuid())
  accountKey      String
  account         Account   @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  name            String
  description     String?   @db.Text
  // Ticket-level metadata captured at intake — billing (costs, billing months,
  // retainer) and any project-wide fields. JSON for flexibility.
  details         Json?
  status          String    @default("active") // active | on_hold | completed | archived
  priority        String    @default("medium") // low | medium | high | urgent
  startDate       DateTime?
  dueDate         DateTime?
  // The rep who owns the engagement.
  ownerUserId     String?
  owner           User?     @relation("InitiativeOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Soft link to the multi-channel Campaign this initiative spun up. Loose
  // string (no FK) — kept symmetric with Task's polymorphic asset link and
  // to avoid coupling the Campaign container to Projects.
  campaignId      String?
  // Slug of the project template that seeded this initiative (e.g.
  // "new-client-onboarding"); null for ad-hoc.
  templateKey     String?
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tasks       Task[]
  budgetLines BudgetLine[]

  @@index([accountKey, status])
  @@index([ownerUserId])
  @@index([createdAt])
  @@index([archivedAt])
}

// A unit of work: the "ticket". Denormalizes accountKey (matches the
// codebase's FK-to-Account.key pattern) so board / my-work queries filter
// without a join.
model Task {
  id           String      @id @default(cuid())
  accountKey   String
  account      Account     @relation(fields: [accountKey], references: [key], onDelete: Cascade)
  initiativeId String?
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  // Routing team (Team.key). Nullable so a deleted team leaves orphan tasks
  // visible rather than cascading them away.
  teamKey      String?
  team         Team?       @relation(fields: [teamKey], references: [key], onDelete: SetNull)

  title       String
  description String? @db.Text
  // Per-type intake fields (budgets, dates, audience, etc.), keyed by FieldDef
  // key from TYPE_FIELDS (src/lib/projects/ui.ts). Flexible by design so field
  // sets can change without a migration.
  details     Json?
  // What kind of work — drives the "Build it" launch action in Phase 2:
  // generic | email | sms | landing_page | form | flow | ads | design |
  // print | video | media_buy | pr | dev | social
  kind        String  @default("generic")
  status      String  @default("todo") // todo | in_progress | in_review | blocked | done
  priority    String  @default("medium") // low | medium | high | urgent

  assigneeUserId  String?
  assignee        User?   @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  // The rep who filed the ticket.
  requesterUserId String?
  requester       User?   @relation("TaskRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)

  startDate   DateTime?
  dueDate     DateTime?
  // Manual board ordering within a status column (gap-spaced floats).
  position    Float     @default(0)
  completedAt DateTime?

  // Subtasks (self-relation).
  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  // Soft link to a generated asset (Phase 2). linkedAssetType ∈ campaign |
  // landing_page | flow | meta_pacer_plan | media_asset; linkedAssetId is
  // that record's id. Loose strings (no FK) — the target is polymorphic
  // across surfaces.
  linkedAssetType String?
  linkedAssetId   String?

  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  comments    TaskComment[]
  activity    TaskActivity[]
  budgetLines BudgetLine[]

  @@index([accountKey, status])
  @@index([initiativeId, status])
  @@index([teamKey, status])
  @@index([assigneeUserId, status])
  @@index([dueDate])
  // Supports the daily due-soon/overdue scan (status + dueDate filter).
  @@index([status, dueDate])
  @@index([archivedAt])
}

// Threaded updates on a task. @mentions drive notifications.
model TaskComment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body         String   @db.Text
  mentions     String   @default("[]") // JSON array of mentioned userIds
  authorUserId String?
  author       User?    @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId, createdAt])
}

// Auto-logged activity feed for a task (who changed what, when). Modeled on
// MetaAdsPacerActivityLog — written transparently, never by a button press.
model TaskActivity {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action       String // created | assigned | status_changed | edited | linked | archived
  field        String?
  fromValue    String?
  toValue      String?
  summary      String // human-readable one-liner
  authorUserId String?
  author       User?    @relation("TaskActivityAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
}

// ─────────────────────────────────────────────────────
// Budget — the media-dollar ledger (see docs/budget-module.md)
// ─────────────────────────────────────────────────────
//
// Replaces the Oz Reports `account_budgets` system. Every dollar of media
// budget is a BudgetLine; lines link to the Projects work that spends them and
// roll up into the Ad Pacer's per-period budget goals. Flow is ONE-WAY —
// budget owns intent, the pacer owns execution, and the pacer never writes
// back. Actuals come back for display and settlement only.

/// What a client actually signed up for — the commitment budget draws down
/// against (docs/budget-module.md §9, Phase B).
///
/// Replaces the year-keyed BudgetPlan. Agreements don't respect calendar
/// years: a term running Mar 2026 – Feb 2027 can't be expressed as a row per
/// year, and forcing it to be is how "planned vs committed" stops meaning
/// anything. So the term is real dates, and a year's share is derived by
/// counting the months of the term that fall inside it.
///
/// Oz Reports has no equivalent — there the lines ARE the budget, with nothing
/// to reconcile against and no way to catch a rep committing past what a client
/// agreed to. That gap is the whole reason this model exists.
model ClientAgreement {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// Human label — "Summer Sales Event", "Q4 Brand Push".
  ///
  /// OPTIONAL, and its absence is meaningful. A budget with no name is the
  /// client's STANDING budget: the recurring per-channel spend that has nothing
  /// to name because it isn't an occasion. Its lines are labelled from their
  /// channel instead ("Meta Base") and, on the paced channels, default to the
  /// pacer's base bucket. A named budget is a thing that happened — an event, a
  /// push — and sits on top as added.
  name String?

  /// The term. Inclusive of both ends, date-only (no time-of-day semantics).
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// Total the client committed across the WHOLE term, not per year. Null =
  /// no formal number; the hub then shows no target rather than inventing one.
  committedAmount Decimal? @db.Decimal(12, 2)

  /// draft | active | completed | cancelled. Only `active` counts toward a
  /// year's commitment — a draft shouldn't move the number a rep budgets
  /// against.
  status String @default("active")

  /// Markup override for lines created under this agreement. Supersedes
  /// Account.markup; still snapshotted per line, so changing it never rewrites
  /// money already committed.
  defaultMarkup Float?

  notes           String?   @db.Text
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fees  AgreementFee[]
  lines BudgetLine[]

  @@index([accountKey, status])
  @@index([accountKey, startDate, endDate])
  @@index([archivedAt])
}

/// A recurring monthly charge under an agreement — the management fee, the
/// managed-service fee, a contribution.
///
/// Separate rows rather than one `monthlyRetainer` number because a client
/// typically pays several distinct fees that land on different channels and
/// need to stay distinguishable in the P&L. Generating budget lines from these
/// is what replaces the old single-channel retainer generator.
model AgreementFee {
  id          String          @id @default(cuid())
  agreementId String
  agreement   ClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /// BudgetChannel key the generated lines land on (management_fee, etc).
  channel       String
  monthlyAmount Decimal @db.Decimal(12, 2)
  label         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agreementId])
}

/// The ledger. Every dollar of media budget in the agency is one row.
///
/// A line moves along the two allocation axes (period, channel) as it gets
/// assigned: an unassigned pool entry has both null, a fully-placed line has
/// both set. Ported from oz-reports' account_budgets, minus the
/// denormalization, the magic `for_month = 0`, and the text-blob audit trail.
model BudgetLine {
  id              String  @id @default(cuid())
  // Billed to vs spent from. Ported from oz-reports' account_id /
  // spend_account_id: a co-op or group buy is billed to one rooftop but spends
  // out of another's ad account. Equal in the ordinary case. The pacer binding
  // keys off spendAccountKey; billing rollups key off accountKey.
  accountKey      String
  account         Account @relation("BudgetLineBilled", fields: [accountKey], references: [key], onDelete: Cascade)
  spendAccountKey String
  spendAccount    Account @relation("BudgetLineSpend", fields: [spendAccountKey], references: [key], onDelete: Cascade)

  // Budget year. ALWAYS set, including for pool lines — it's what anchors an
  // unplaced dollar to a BudgetPlan, and what every rollup filters on. When
  // `period` is set the two must agree (period.slice(0,4) === String(year));
  // the service enforces that invariant on write.
  year Int

  // Position on the two allocation axes. null = still in the pool: the money
  // is committed to the account but not yet assigned a month / a channel.
  // (oz-reports overloaded for_month = 0 for this; nullable columns say it
  // honestly and keep the index story clean.)
  period   String? // "YYYY-MM" — same shape as MetaAdsPacerPeriodBudget.period
  channel  String? // BudgetChannel key: "meta" | "google" | "radio" | ...
  category String? // display grouping: "Digital" | "Traditional" | ...

  // Client gross. Decimal, NOT the String the pacer money fields use — those
  // mirror form input, this is an accounting ledger that gets summed and
  // compared against ceilings. Postgres numeric, 2dp.
  amount         Decimal @db.Decimal(12, 2)
  // The gross→spend factor frozen at creation: spend = amount × markupSnapshot.
  // Resolved once via accountMarginSetting() and never re-derived, so changing
  // an account's markup can't silently rewrite last quarter's targets.
  //
  // MEDIA ONLY as a cost mechanism. A percentage is the wrong model for a
  // resold service (you know the vendor's actual price) or a fee (there is no
  // external cost) — those carry `cost` directly. See `lineType` below.
  markupSnapshot Float

  // What KIND of money this is — the dimension Oz Reports never had, and the
  // one that makes gross margin computable. media | fee | service |
  // production | unclassified. Defaults from the channel; overridable per line
  // because a one-off can behave unlike its channel.
  lineType String @default("unclassified")

  // What this line COSTS Oz, in the same dollars as `amount`. Null = derive:
  //   media  -> amount × markupSnapshot   (the spend that hits the platform)
  //   fee    -> 0                          (agency revenue, no external cost)
  //   other  -> unknown until entered      (a vendor's real price, a job cost)
  // Stored rather than always derived because for a resold service the cost is
  // a number someone was invoiced, not a percentage of what the client pays.
  // revenue = amount − cost.
  cost Decimal? @db.Decimal(12, 2)

  // Where the money came from. Drives the pacer bucket default and lets the hub
  // separate "the retainer" from "things people asked for".
  //   retainer — generated from BudgetPlan.monthlyRetainer
  //   task     — created by a Projects intake request
  //   adhoc    — entered directly in the budget hub
  //   pool     — unassigned money added to the account's pool
  source String @default("adhoc")

  //   planned   — drafted, not yet counted against the pool
  //   committed — counted; feeds the pacer
  //   live      — in flight (platform lines only, set when the pacer links)
  //   settled   — closed out; actual recorded
  //   canceled  — released back; excluded from every rollup
  status String @default("planned")

  // Which pacer pool this lands in. Defaults from `source` (retainer → base,
  // everything else → added) but explicit and overridable, because reps will
  // need exceptions and a derived value gives them nowhere to put one.
  bucket String @default("added") // "base" | "added"

  // The agreement this line draws down against, when there is one. Nullable:
  // plenty of budget is entered ad hoc with no signed commitment behind it, and
  // forcing a fake agreement to satisfy a FK would corrupt the very number the
  // agreement exists to provide.
  agreementId String?
  agreement   ClientAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  // The link oz-reports never had.
  initiativeId String?
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // oz-reports' bulk_entry_id: one UUID across every line from a single
  // submission (12 stores × 6 months), so the batch edits/deletes as a unit.
  batchId String?

  // FLIGHT. A media buy is one commercial fact — one insertion order, one
  // total, one date range — but the ledger is at month grain, so a 20 Mar –
  // 10 May buy is three rows. These tie those rows back together.
  //
  // `flightId` groups them, so moving the dates or changing the total re-splits
  // the whole buy instead of leaving someone to find and fix three lines by
  // hand. `flightStart`/`flightEnd` are copied onto every child so the drawer
  // and the grid can say what a row belongs to without a second query.
  //
  // Why not store the flight as ONE row and derive months at read time: every
  // rollup, the pacer binding and settlement all assume a line sits in exactly
  // one month, and settlement in particular has no sensible meaning for a row
  // that is half-closed. Month grain stays the ledger's unit; the flight is the
  // authoring concept above it. The split is by DAYS (see budget/flight.ts) —
  // unlike an agreement's commitment, media spends daily.
  flightId    String?
  flightStart DateTime? @db.Date
  flightEnd   DateTime? @db.Date

  // Stable identity in the system this line was imported FROM, e.g.
  // "ozreports:account_budgets:8842". Unique, so the migration upserts instead
  // of duplicating the whole ledger on a second run — and so a corrected row in
  // Oz Reports can be re-pushed onto the same line. Null for anything created
  // in Loomi, which is everything after the cutover.
  externalId String? @unique

  // Soft link to the thing actually spending it. Polymorphic, no FK — same
  // pattern as Task.linkedAssetType/Id.
  //   "meta_pacer_ad" | "google_pacer_ad" | "campaign"
  linkedAssetType String?
  linkedAssetId   String?

  // Settlement. For platform channels this is filled from synced spend when the
  // month freezes; for radio/print/video a human records it.
  actualAmount Decimal?  @db.Decimal(12, 2)
  settledAt    DateTime?

  label           String? // free-text line name, e.g. "Summer Sales Event"
  notes           String?   @db.Text
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  events BudgetLineEvent[]

  @@index([accountKey, year])
  @@index([accountKey, lineType])
  @@index([agreementId])
  @@index([accountKey, period])
  @@index([spendAccountKey, period, channel])
  @@index([accountKey, status])
  @@index([initiativeId])
  @@index([taskId])
  @@index([batchId])
  @@index([flightId])
  @@index([archivedAt])
}

/// Auto-logged, typed, queryable. Modeled on TaskActivity /
/// MetaAdsPacerAuditEntry — written transparently, never by a button press.
/// Replaces oz-reports' rep_notes string concatenation AND its separate
/// logBudgetMove table: a split/move writes one event on each side, tied by
/// groupId, with counterpartyLineId pointing at the other half.
model BudgetLineEvent {
  id     String     @id @default(cuid())
  lineId String
  line   BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  // created | edited | allocated | returned | split | committed | settled |
  // canceled | pushed_to_pacer
  action String

  field     String?
  fromValue String?
  toValue   String?
  summary   String // human-readable one-liner

  // The other side of a split / move / allocation.
  counterpartyLineId String?
  // Ties a multi-line action together (one save, one batch allocate).
  groupId            String?

  authorUserId String?
  author       User?    @relation("BudgetLineEventAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([lineId, createdAt])
  @@index([groupId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────
// Ad Generator — per-sub-account form field preferences
// ─────────────────────────────────────────────────────
//
// Which of a template's fields a given sub-account hides on its custom-ad form.
//
// A shared template carries every field any dealer might need; a given rooftop
// uses a handful. Without this the only way to trim the form is to fork the
// template per dealer, which is how a library of near-identical plates starts.
//
// A hidden field is still SUBMITTED with whatever value it had — hiding is a
// form concern, not a data one. That is exactly why required fields can never be
// hidden: it wouldn't relax the requirement, it would remove the only way to
// satisfy it. `field-prefs.ts` enforces that on write AND on read, so a
// preference saved before a manufacturer rule changed stops applying the moment
// the field becomes required.
model AdTemplateFieldPref {
  id         String @id @default(cuid())
  accountKey String
  // Code template id or AdTemplateDoc id — same identifier space as AdCreative.
  templateId String

  /// JSON string[] of field keys hidden for this sub-account.
  hiddenFields String @db.Text

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountKey, templateId])
  @@index([accountKey])
}

// Google Business Profile connection — one per account.
//
// THE ONLY PER-ACCOUNT OAUTH IN LOOMI. Every other Google integration here
// (Google Ads, GA4) authenticates as the agency: one refresh token or service
// account in env, used for every dealer. Business Profile can't work that way —
// a location's insights are readable only by a Google identity that manages
// that listing, and that identity is the dealer's, not ours. So each account
// carries its own grant.
//
// Consequences worth knowing before touching this:
//   - The token belongs to a PERSON at the dealership. If they leave, or revoke
//     access in their Google account, this connection dies and the report has to
//     prompt for a reconnect. That is normal, not a bug.
//   - `refreshToken` is encrypted at rest with the same AES-256-GCM helper as
//     CrmDestination.accessToken, and must never leave the server.
//   - Connecting is a STAFF action (MANAGEMENT_ROLES); reading the report is
//     client-visible. See src/lib/integrations/gbp.ts.
model GbpConnection {
  id         String  @id @default(cuid())
  accountKey String  @unique
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// AES-256-GCM ciphertext (iv:authTag:ciphertext). NEVER serialize this.
  refreshToken   String
  /// Which Google identity granted access — shown to staff so they know who to
  /// chase when the grant dies.
  connectedEmail String?

  /// "locations/12345678901234567890". Null until someone picks a location:
  /// the OAuth grant can cover several listings, so the connection exists
  /// before the choice does.
  locationId      String?
  locationName    String?
  locationAddress String?

  connectedByUserId String?

  /// Last failure talking to Google, so the UI can distinguish "never worked"
  /// from "worked until Tuesday" without digging through logs.
  lastError   String?
  lastErrorAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Tracked phone call — one row per call, pushed by the Oz Reports bridge
// (`/loomi/pushcalls`) from its `calls` table.
//
// WHAT IS DELIBERATELY NOT HERE: caller name, caller phone number, and the
// call-recording URL. Oz Reports stores all three; none of them is needed to
// report call volume, answer rate, or the tracker/city/hour breakdowns, and
// copying a caller's number and a recording of their conversation into a
// second system is not something a reporting feature should do on its own
// initiative. The city/state/ZIP kept below are what the geographic
// breakdowns need and are already coarse.
//
// If a future feature genuinely needs the caller's number — the BDC call list
// in Marketing Lists is the obvious candidate — that is a deliberate decision
// to widen this model, with its own retention question, not something to slip
// in because the column exists upstream.
model CallEvent {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// Stable id from the call tracker ("ozreports:calls:<id>"), so a re-push
  /// updates rather than duplicating and the Sunday sweep stays safe to re-run.
  idempotencyKey String @unique

  occurredAt DateTime
  /// The tracker's own status string, lowercased at ingest: "answered",
  /// "missed", "abandoned", … Not an enum — a new status from the vendor must
  /// show up in the report as itself, not crash the ingest or vanish.
  status     String

  /// Talk time in seconds. Null when the tracker didn't report one; only
  /// answered calls have a meaningful duration.
  durationSeconds Int?

  /// The tracking campaign the number belongs to, e.g. "Spring Service".
  trackerName String?

  callerCity  String?
  callerState String?
  callerZip   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountKey, occurredAt])
  @@index([accountKey, status])
  @@index([accountKey, trackerName])
}

// ─────────────────────────────────────────────────────
// A single published review, pushed by the Oz Reports bridge
// (`/loomi/pushreviews`) from the reputation database's `google_reviews`.
//
// WHY THIS EXISTS ALONGSIDE THE LIVE PLACES CALL. The Reputation report
// already reads Google Places live, which gives the CURRENT rating and the
// handful of reviews Google chooses to return. Places will not give you
// history: it has no "reviews in March", no star distribution over a range,
// and no idea whether anyone replied. Those three are the whole point of this
// table, and none of them can be backfilled later from the live API — a review
// unrecorded today is gone.
//
// So the two sources answer different questions and both stay: live Places for
// "what does our listing say right now", this for "what happened over time".
model ReviewEvent {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// "ozrep:google_reviews:<id>" — stable, so a re-push updates a review whose
  /// reply status changed rather than duplicating it.
  idempotencyKey String @unique

  /// When the review was published, not when we ingested it.
  publishedAt DateTime
  /// 1–5. Validated at ingest; a review outside that range is skipped rather
  /// than silently dragging the average.
  stars       Int

  /// Whether the store has replied. The reply RATE is the metric this table
  /// exists for that Places cannot answer at all.
  replied Boolean @default(false)

  /// Review body. Nullable — a star-only review with no text is common and is
  /// still a review.
  text       String? @db.Text
  /// Display name as published by Google. No email, no profile URL.
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountKey, publishedAt])
  @@index([accountKey, stars])
  @@index([accountKey, replied])
}

// ─────────────────────────────────────────────────────
// Direct-mail campaign matchback RESULT — one row per campaign per rooftop,
// pushed by the Oz Reports bridge (`/loomi/pushmailer`).
//
// ── WHY THIS STORES RESULTS, NOT SOURCE ROWS ────────────────────────────────
// Every other bridge feed ships raw rows and lets Loomi do the arithmetic. This
// one cannot, for a reason that is structural rather than convenient: the
// matchback joins mailed recipients to repair orders on `custno`, the DMS
// customer number — and Loomi has no custno. `ContactEvent` keys on
// `contactId`, resolved by email/phone at ingest; the mail file and the RO
// share only the DMS's own identifier, which lives on the Oz Reports host and
// nowhere else.
//
// Pushing raw recipients instead would ship the name and address of everyone
// mailed — tens of thousands of people per campaign — AND still not work,
// because the join key would be missing on arrival. So the match runs where
// both databases and the key are, and only its result crosses.
//
// The consequence to be honest about: this table cannot be recomputed from
// Loomi's own data. If the matchback logic changes, the fix ships in PHP and
// the campaigns are re-pushed.
model MailerCampaign {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// "ozpurls:campaign:<id>:<dealerMatchback>" — a campaign spans rooftops, so
  /// the dealer code is part of the identity.
  idempotencyKey String @unique

  campaignName String
  /// "LS" (Lost Souls) | "FLF" | whatever the mail vendor calls it.
  mailerType   String?
  /// Earliest and latest in-home date across the mailed file.
  mailedFrom   DateTime
  mailedTo     DateTime

  /// Pieces mailed to this rooftop's customers.
  marketed      Int
  /// Recipients who visited their personal URL.
  engaged       Int
  /// LS campaigns only; null elsewhere so "no offers" and "not applicable"
  /// stay distinguishable.
  offerRequests Int?

  /// Distinct recipients with at least one matched repair order.
  matchedCustomers Int
  /// Matched repair orders — higher than matchedCustomers when someone came
  /// back twice.
  matchedRos       Int
  /// Matched ROs where the serviced VIN equals the mailed VIN.
  directMatches    Int
  /// Matched ROs for the same customer on a different vehicle.
  indirectMatches  Int

  /// Attributed repair-order revenue, split the way the service feed splits it.
  customerPay Decimal @db.Decimal(12, 2)
  warrantyPay Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountKey, mailedFrom])
}

// ─────────────────────────────────────────────────────
// Out-of-home board. NATIVE Loomi data, not a bridge feed.
//
// Oz Dealer Tools owned these in its own `billboards` table, which no bridge
// touches — and since ODT is being retired, pointing a sync at a system that
// is going away would be building a dependency with an expiry date. So these
// move once and Loomi owns them: full CRUD lives here, and the ODT rows come
// across through a one-time import (scripts/import-billboards.ts).
//
// SHARING. ODT had an `is_group_level` flag: a board owned by a group is
// visible to every org beneath it. Loomi already has that concept — the
// account hierarchy — so `sharedWithChildren` means the same thing without a
// new sharing system. A board on a group account with the flag set is visible
// to its descendants; without it, only to the account that owns it.
model Billboard {
  id         String  @id @default(cuid())
  accountKey String
  account    Account @relation(fields: [accountKey], references: [key], onDelete: Cascade)

  /// Visible to accounts beneath this one in the hierarchy. Only meaningful on
  /// a group account — harmless and inert on a leaf.
  sharedWithChildren Boolean @default(false)

  providerName    String
  billboardNumber String
  artworkUrl      String?
  facingDirection String?
  avgDailyTraffic Int?

  pricePerPeriod Decimal? @db.Decimal(10, 2)
  numPeriods     Int      @default(1)
  /// "4-week", "monthly", … free text, as in ODT.
  periodType     String   @default("4-week")

  expirationDate DateTime? @db.Date
  renewedAt      DateTime?

  latitude  Float
  longitude Float

  /// active | expired | archived. ODT also had `deleted`; Loomi deletes rows
  /// instead of tombstoning them, so that state has no equivalent here.
  status String  @default("active")
  notes  String? @db.Text

  /// Set when imported from ODT ("odt:billboards:<id>"), so the one-time
  /// import is safe to re-run. Null for boards created in Loomi.
  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountKey, status])
  @@index([accountKey, expirationDate])
}

// ─────────────────────────────────────────────────────
// Rate cards (billing categories)
// ─────────────────────────────────────────────────────
//
// What the agency keeps on each kind of work. One row per billing category
// (Digital, Mass Media, Swag…); a budget line picks up the rate of the category
// its channel bills at, and that rate is FROZEN onto the line at creation
// (BudgetLine.markupSnapshot) so editing a card never rewrites committed money.
//
// A TABLE, not the `app-markup-billing-<key>` AppSetting rows this replaces
// (those held only the rate, against a category list hardcoded in
// lib/budget/channels.ts). Every agency prices differently and names its
// categories differently, so the taxonomy itself has to be editable — a rate
// card list that needs a deploy to change isn't agnostic. The seed script
// migrates the old AppSetting rates in and leaves them untouched.
//
// `key` is the stable slug the rest of the system stores and joins on
// (BudgetChannel.billing today, a real FK in phase 2). It is immutable once
// created — `label` is what gets renamed. Archived, never deleted, for the same
// reason: budget lines and channels reference keys as plain strings, so a
// delete would orphan history that still has to add up.
model BillingCategory {
  id    String @id @default(cuid())
  key   String @unique // stable slug, e.g. "mass_media" — never renamed
  label String // "Mass Media" — what the UI shows, freely renamed

  // Gross→spend factor: 0.77 means the agency keeps 23%. Stored as the factor
  // (what the ledger holds) though the UI edits the margin percentage, because
  // that's the number a line's markupSnapshot has to read as. Must be > 0 and
  // <= 1; a 0 would zero out every line on the category.
  markup Float

  sortOrder  Int       @default(0)
  // Archived cards stop being offered and stop resolving a rate — channels
  // pointing at one fall back to the account rate, then the agency default,
  // which is exactly the pre-rate-card behaviour. Never a hard delete.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels BudgetChannel[]

  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────
// Budget channels
// ─────────────────────────────────────────────────────
//
// The spend axis every BudgetLine is placed on — Meta, Radio, Swag, Management
// Fee. Was a 44-entry `BUDGET_CHANNELS` constant in lib/budget/channels.ts,
// which made Loomi's whole budget taxonomy Oz Marketing's: the list mirrored Oz
// Reports' `channels` table one-for-one, right down to its numeric ids. Another
// agency runs different channels, groups them differently and prices them
// differently, and none of that should need a deploy.
//
// `key` is what everything else stores and joins on (BudgetLine.channel,
// KIND_BUDGET_CHANNELS, the pacer rollups). Immutable once created; `label` is
// the renameable name. Archive rather than delete, for the same reason as
// BillingCategory: lines reference the key as a plain string, so a delete would
// orphan history that still has to reconcile.
model BudgetChannel {
  id    String @id @default(cuid())
  key   String @unique // stable slug, e.g. "mass_media" — never renamed
  label String

  // Display grouping in the hub ("Digital", "Traditional", …). A plain string,
  // not an enum: the groups ARE whatever the channels say they are, and the
  // hub's section order falls out of sortOrder. A group nobody uses simply
  // stops existing.
  category String

  // Default line type for money on this channel — media | fee | service |
  // production | unclassified. Overridable per line; see BudgetLine.lineType.
  lineType String @default("unclassified")

  // Which rate card this channel bills at. A real relation, unlike
  // BudgetLine.channel: an archived card still has a row, so the reference
  // stays valid and rate resolution falls through on its own. Null = no rate of
  // its own, which falls back to the account rate then the agency default.
  billingKey      String?
  billingCategory BillingCategory? @relation(fields: [billingKey], references: [key], onDelete: SetNull)

  // Ad Pacer platform this channel's budget rolls into — "meta" | "google" |
  // null. Null is the common case: most channels settle by hand. Not a free
  // string in practice; the write path validates it against the pacer's
  // platforms, because a typo here silently stops a channel pacing.
  pacer String?

  // Which Projects task kinds may spend on this channel — the editable form of
  // what `KIND_BUDGET_CHANNELS` used to hardcode. Empty = offered at intake
  // nowhere, which is what every channel exists for anyway: the hub needs all
  // of them to reconcile, a rep only picks the few their ticket is about.
  //
  // REPLACES a plain `intake Boolean`, which was a second, coarser answer to
  // the same question — and a wrong one. The intake form has always gated on
  // the kind map, so 18 of the 36 channels flagged `intake` were offered
  // nowhere and the checkbox said otherwise. One field, one truth.
  //
  // Task kinds themselves stay in code (`KIND_META`): each has its own intake
  // form and its own fields, so a new kind is a code change either way.
  intakeKinds String[]

  // Lucide icon name. Brand marks (Meta, Google Ads, YouTube) stay in code —
  // they're licensed assets, not configuration.
  icon String?

  // Foreign channel ids this maps from on import — Oz Reports' channel_id
  // today. An IMPORT MAPPING, not taxonomy: an agency with nothing to import
  // just has none, which is why this isn't the primary key it used to be.
  externalIds Int[]

  sortOrder  Int       @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([billingKey])
}
